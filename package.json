{
  "name": "tituba",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "husky || true",
    "dev": "astro dev",
    "dev:web": "astro dev",
    "dev:api": "pnpm --dir services/payload dev",
    "build": "astro build",
    "build:web": "astro build",
    "build:api": "pnpm --dir services/payload build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "a11y": "node scripts/a11y-audit.mjs",
    "a11y:deep": "node scripts/a11y-deep.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,json,md}\" \"*.{md,mjs,ts,json}\"",
    "lint": "eslint \"src/**/*.{astro,ts,tsx,js}\""
  },
  "dependencies": {
    "@astrojs/node": "^11.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "astro": "^7.2.1",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "htmlparser2": "^12.0.0",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "yaml@<2.8.3": ">=2.8.3"
    }
  }
}
