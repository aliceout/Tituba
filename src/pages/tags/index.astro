---
/**
 * Vue d'ensemble des tags — /tags/
 *
 * Hero + liste alphabétique des tags avec leur compteur d'usages.
 * Couvre l'ex-issue #7 (index alphabétique des mots-clés).
 */
import PageShell from '../../components/ui/PageShell.astro';
import { fetchCollection, fetchPublicationCounts } from '../../lib/payload';
import { formatHeroTitle } from '../../lib/site';

type Tag = {
  id: number | string;
  slug: string;
  name: string;
};

let tags: Tag[] = [];
let counts = new Map<string, number>();
try {
  tags = await fetchCollection<Tag>('tags', {
    sort: 'name',
    limit: 1000,
    depth: 0,
  });
  // Une requête SQL renvoie tous les compteurs, toutes collections
  // confondues. Auparavant on chargeait mille documents rien que pour
  // les compter — et avec cinq collections ce serait cinq fois pire.
  counts = new Map(Object.entries(await fetchPublicationCounts('tag')));
  // post.tags en depth 0 est un array d'IDs ; on compte par tag.id
} catch (err) {
  console.warn('[tags] fetch failed:', (err as Error).message);
}

// Alphabétique strict (les tags sont non-éditoriaux : pas de tri par
// usage prioritaire comme pour les thèmes)
const sorted = tags.slice().sort((a, b) => a.name.localeCompare(b.name, 'fr'));
---

<PageShell
  documentTitle="Tags"
  description="Tous les mots-clés utilisés sur Tituba — index alphabétique."
  title={formatHeroTitle('Les *tags* de Tituba.')}
  lede="Mots-clés libres ajoutés au fil des publications. Cliquer sur un tag mène à la liste des publications qui l'utilisent."
  famille="violet"
>
    {sorted.length === 0 ? (
      <p class="empty">Aucun tag pour l'instant.</p>
    ) : (
      <ul class="grid">
        {sorted.map((t) => {
          const count = counts.get(t.slug) ?? 0;
          return (
            <li>
              <a class="tag-card" href={`/tag/${t.slug}/`}>
                <span class="slug">#{t.slug}</span>
                <span class="name">{t.name}</span>
                <span class="count">
                  {count} publication{count > 1 ? 's' : ''}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
</PageShell>

<style>
  /* Gouttière et rythme vertical viennent de PageShell. */
  .empty {
    padding: 64px 0;
    color: var(--color-muted);
    text-align: center;
    font-family: var(--font-sans);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0;
    border-top: 1px solid var(--color-rule);
  }
  .grid li {
    border-bottom: 1px solid var(--color-rule);
  }

  .tag-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: 14px 12px;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
  }
  .tag-card:hover {
    background: var(--color-citation-bg);
  }
  /* Violet, comme /themes/ : les tags sont l'autre taxonomie du site. */
  .tag-card:hover .name {
    color: var(--c-violet-deep);
  }
  .tag-card .slug {
    font-family: var(--font-mono);
    font-size: calc(12px * var(--a11y-echelle));
    color: var(--color-muted);
  }
  .tag-card .name {
    font-family: var(--font-serif);
    font-size: calc(17px * var(--a11y-echelle));
    color: var(--color-ink);
    transition: color 0.12s;
  }
  .tag-card .count {
    font-family: var(--font-mono);
    font-size: calc(11px * var(--a11y-echelle));
    color: var(--color-muted);
  }
</style>
