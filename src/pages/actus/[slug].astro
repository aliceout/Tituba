---
/**
 * Détail d'une publication du format « actus » — /actus/<slug>/
 *
 * Enveloppe mince : tout le rendu vit dans PublicationArticle, partagé
 * par les cinq formats. Seule la collection change.
 */
import PublicationArticle from '../../components/PublicationArticle.astro';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');
---

<PublicationArticle collection="actus" slug={slug} />
