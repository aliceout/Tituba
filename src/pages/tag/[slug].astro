---
/**
 * Page d'un tag individuel — /tag/<slug>/
 *
 * Hero compact (kicker mono `#slug`, h1 nom du tag, compteur + lien
 * retour vers /tags/), puis flux des billets qui ont ce tag. Calqué
 * sur /theme/<slug>/ mais sans description éditoriale (les tags sont
 * non-éditoriaux par design).
 */
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import {
  fetchBySlug,
  fetchCollection,
  filterPublished,
  publishedOnly,
} from '../../lib/payload';
import { fetchFeed } from '../../lib/publications';
import type { FeedDoc } from '../../lib/payload';

type Tag = {
  id: number | string;
  slug: string;
  name: string;
};


type Post = FeedDoc;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/tags/');

const tag = await fetchBySlug<Tag>('tags', slug);
if (!tag) {
  return new Response('Tag introuvable', { status: 404 });
}

let posts: Post[] = [];
try {
  // Flux fusionné restreint à ce tag : les cinq formats
  // y apparaissent ensemble, triés par date.
  const feed = await fetchFeed({ tag: slug, limit: 200 });
  posts = feed.docs;
} catch (err) {
  console.warn('[tag] posts fetch failed:', (err as Error).message);
}

const total = posts.length;
---

<Layout
  title={`#${tag.slug}`}
  description={`Billets de Tituba taggés #${tag.slug}.`}
>
  <Hero
    kicker={`Tag · #${tag.slug}`}
    kickerVariant="mono"
    title={tag.name}
  >
    <div class="hero-bottom-meta">
      <span>{total} publication{total > 1 ? 's' : ''}</span>
      <span aria-hidden="true">·</span>
      <a class="back mono" href="/tags/">← tous les tags</a>
    </div>
  </Hero>

  <section class="container feed">
    {posts.length === 0 ? (
      <p class="empty">Aucun billet sous ce tag pour l'instant.</p>
    ) : (
      posts.map((p) => (
        <PublicationCard
          collection={p.collection}
          numero={p.numero}
          slug={p.slug}
          title={p.title}
          themeSlugs={p.themeSlugs}
          publishedAt={p.publishedAt}
          lede={p.lede}
          readingTime={p.readingTime}
        />
      ))
    )}
  </section>
</Layout>

<style>
  .container {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .hero-bottom-meta {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 24px;
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .hero-bottom-meta .back {
    color: var(--color-accent);
    transition: color 0.12s;
  }
  .hero-bottom-meta .back:hover {
    color: var(--color-ink);
  }

  .feed .empty {
    padding: 64px 0;
    color: var(--color-muted);
    text-align: center;
    font-family: var(--font-sans);
  }

  @media (max-width: 900px) {
    .container {
      padding: 0 var(--page-gutter-narrow);
    }
  }
</style>
