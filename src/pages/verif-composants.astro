---
/**
 * Page d'essai — NON commitée, supprimée après la migration.
 *
 * Deux composants ne se rendent qu'à condition d'avoir des données :
 * les tags d'un billet, les liens sociaux du global Subscriptions. La
 * base de développement n'en a ni l'un ni l'autre, si bien qu'aucune
 * page réelle ne les montre — et qu'une comparaison avant/après les
 * déclarait « sans différence » sans les avoir jamais rendus.
 *
 * Ici ils sont montés avec des données d'exemple, ce qui les fait
 * entrer dans le champ du relevé.
 */
import Layout from '../layouts/Layout.astro';
import ArticleTags from '../components/article/ArticleTags.astro';
import SocialLinksList from '../components/abonnement/SocialLinksList.astro';

const tags = [
  { id: 1, slug: 'frontieres', name: 'Frontières' },
  { id: 2, slug: 'genre', name: 'Genre' },
];
const reseaux = [
  { label: 'Mastodon', href: 'https://example.org/@tituba', hint: 'les billets, à leur parution' },
  { label: 'Bluesky', href: 'https://example.org/tituba', hint: 'les mêmes, en plus court' },
];
---

<Layout title="Vérification des composants">
  <ArticleTags tags={tags as never} />
  <SocialLinksList entries={reseaux} />
</Layout>
