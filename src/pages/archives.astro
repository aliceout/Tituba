---
/**
 * Page Archives — /archives/
 *
 * Hero compact + pour chaque année (groupé via JS template) :
 *  - titre 48px + compteur en mono
 *  - lignes `120px 100px 1fr 160px` (date ISO, type uppercase accent,
 *    titre, pôle aligné à droite)
 *
 * Réf : design_handoff_tituba/Tituba B.html → Archives.
 */
import PageShell from '../components/ui/PageShell.astro';
import Empty from '../components/ui/Empty.astro';
import { fetchIndexPages, type FeedDoc } from '../lib/payload';
import { PUBLICATIONS, fetchFeed, publicationHref } from '../lib/publications';
import { formatDateIso, formatHeroLede, formatHeroTitle, stripHeroMarkers } from '../lib/site';


type Post = FeedDoc;

type IndexPagesGlobal = {
  archives?: { enabled?: boolean; heroTitle?: string; heroLede?: string };
};



const DEFAULT_TITLE = 'Toutes les *publications*, par année.';
const DEFAULT_LEDE =
  'Chaque publication porte un numéro, une date de publication et, le cas échéant, une date de mise à jour. Les fiches thématiques sont régulièrement révisées.';

let posts: Post[] = [];
let indexPages: IndexPagesGlobal = {};
try {
  // Archives non paginées, groupées par année : un seul appel au flux
  // fusionné suffit au volume d'une association. Paginer une fusion de
  // cinq sources côté client coûterait bien plus cher que ça ne rapporte.
  const feed = await fetchFeed({ limit: 100 });
  posts = feed.docs;
} catch (err) {
  console.warn('[archives] fetch failed, rendering empty:', (err as Error).message);
}
try {
  indexPages = await fetchIndexPages<IndexPagesGlobal>();
} catch (err) {
  console.warn('[archives] fetchIndexPages failed, using defaults:', (err as Error).message);
}

if (indexPages.archives?.enabled === false) {
  return Astro.rewrite('/404');
}

// Group by year (descending)
const byYear = new Map<string, Post[]>();
for (const p of posts) {
  const y = (p.publishedAt ? new Date(p.publishedAt) : new Date()).getFullYear().toString();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort().reverse();

const heroTitleHtml = formatHeroTitle(
  indexPages.archives?.heroTitle?.trim() || DEFAULT_TITLE,
);
const heroLedeHtml = formatHeroLede(
  indexPages.archives?.heroLede?.trim() || DEFAULT_LEDE,
);
---

<PageShell
  documentTitle="Archives"
  description="Toutes les publications de Tituba, par année."
  title={heroTitleHtml}
  lede={heroLedeHtml}
>
  {years.length === 0 ? (
    <Empty>Aucune publication pour l'instant.</Empty>
  ) : (
    years.map((y) => {
      const list = byYear.get(y)!;
      return (
        <div class="arch-year">
          <h2>
            {y}
            {' '}
            <span class="mono count">· {list.length} publication{list.length > 1 ? 's' : ''}</span>
          </h2>
          {list.map((p) => {
            const primaryTheme = (p.themeSlugs ?? [])[0];
            return (
              <a class="arch-row" href={publicationHref(p.collection, p.publicId)}>
                <div class="d">{p.publishedAt ? formatDateIso(p.publishedAt) : ''}</div>
                <div class="ty">{PUBLICATIONS[p.collection]?.badge ?? ''}</div>
                <div class="t">{stripHeroMarkers(p.title)}</div>
                <div class="p">{primaryTheme ?? '—'}</div>
              </a>
            );
          })}
        </div>
      );
    })
  )}
</PageShell>

<style>
  /* Gouttière et rythme vertical viennent de PageShell. Pas de famille
     dominante : les archives traversent les cinq formats et n'ont pas
     de couleur propre, comme le titre de l'accueil dont les mots se
     relaient plutôt qu'imposer une seule teinte. */

  /* Groupes par année. Le corps du titre d'année reste hors de
     l'échelle standard des titres de section (--t-h2) : c'est un repère
     chronologique, pas un titre de contenu, et il doit dominer la page
     comme un numéro de sommaire. */
  .arch-year {
    padding: 32px 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .arch-year h2 {
    font-family: var(--font-serif);
    font-size: calc(48px * var(--a11y-echelle));
    font-weight: var(--w-heading);
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }
  .arch-year h2 .count {
    font-family: var(--font-mono);
    font-size: calc(13px * var(--a11y-echelle));
    color: var(--color-muted);
    font-weight: 400;
    letter-spacing: 0;
  }
  .arch-row {
    display: grid;
    grid-template-columns: 120px 100px 1fr 160px;
    gap: 32px;
    padding: 14px 0;
    border-top: 1px solid var(--color-rule);
    align-items: baseline;
    color: inherit;
    transition: color 0.12s;
  }
  .arch-row:hover .t {
    color: var(--c-bleu-deep);
  }
  .arch-row .d {
    font-family: var(--font-mono);
    font-size: calc(12px * var(--a11y-echelle));
    color: var(--color-muted);
  }
  .arch-row .ty {
    font-family: var(--font-mono);
    font-size: calc(11px * var(--a11y-echelle));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-bleu-deep);
  }
  .arch-row .t {
    font-family: var(--font-serif);
    font-size: calc(18px * var(--a11y-echelle));
    line-height: 1.35;
    font-weight: 400;
    transition: color 0.12s;
  }
  .arch-row .p {
    font-family: var(--font-sans);
    font-size: calc(11px * var(--a11y-echelle));
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 900px) {
    .arch-year h2 {
      font-size: calc(32px * var(--a11y-echelle));
    }
    .arch-row {
      grid-template-columns: 100px 1fr;
      gap: 16px;
    }
    .arch-row .ty,
    .arch-row .p {
      grid-column: 1 / -1;
    }
    .arch-row .p {
      text-align: left;
    }
  }
</style>
