---
/**
 * Page Archives — /archives/
 *
 * Hero compact + pour chaque année (groupé via JS template) :
 *  - titre 48px + compteur en mono
 *  - lignes `120px 100px 1fr 160px` (date ISO, type uppercase accent,
 *    titre, pôle aligné à droite)
 *
 * Réf : design_handoff_tituba/Tituba B.html → Archives.
 */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { fetchIndexPages, type FeedDoc } from '../lib/payload';
import { PUBLICATIONS, fetchFeed, publicationHref } from '../lib/publications';
import { formatDateIso, formatHeroLede, formatHeroTitle } from '../lib/site';


type Post = FeedDoc;

type IndexPagesGlobal = {
  archives?: { enabled?: boolean; heroTitle?: string; heroLede?: string };
};



const DEFAULT_TITLE = 'Tous les billets, par année.';
const DEFAULT_LEDE =
  'Le tituba est versionné : chaque billet a un numéro, une date de publication et, le cas échéant, une date de mise à jour. Les fiches thématiques sont régulièrement révisées.';

let posts: Post[] = [];
let indexPages: IndexPagesGlobal = {};
try {
  // Archives non paginées, groupées par année : un seul appel au flux
  // fusionné suffit au volume d'une association. Paginer une fusion de
  // cinq sources côté client coûterait bien plus cher que ça ne rapporte.
  const feed = await fetchFeed({ limit: 100 });
  posts = feed.docs;
} catch (err) {
  console.warn('[archives] fetch failed, rendering empty:', (err as Error).message);
}
try {
  indexPages = await fetchIndexPages<IndexPagesGlobal>();
} catch (err) {
  console.warn('[archives] fetchIndexPages failed, using defaults:', (err as Error).message);
}

if (indexPages.archives?.enabled === false) {
  return Astro.rewrite('/404');
}

// Group by year (descending)
const byYear = new Map<string, Post[]>();
for (const p of posts) {
  const y = (p.publishedAt ? new Date(p.publishedAt) : new Date()).getFullYear().toString();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort().reverse();

const total = posts.length;

const heroTitleHtml = formatHeroTitle(
  indexPages.archives?.heroTitle?.trim() || DEFAULT_TITLE,
);
const heroLedeHtml = formatHeroLede(
  indexPages.archives?.heroLede?.trim() || DEFAULT_LEDE,
);
---

<Layout
  title="Archives"
  description="Toutes les publications de Tituba, par année."
>
  <Hero
    kicker={`Archives · ${total} billet${total > 1 ? 's' : ''}`}
    title={heroTitleHtml}
    lede={heroLedeHtml}
  />

  <section class="container archives">
    {years.length === 0 ? (
      <p class="empty">Aucune publication pour l'instant.</p>
    ) : (
      years.map((y) => {
        const list = byYear.get(y)!;
        return (
          <div class="arch-year">
            <h2>
              {y}
              {' '}
              <span class="mono count">· {list.length} publication{list.length > 1 ? 's' : ''}</span>
            </h2>
            {list.map((p) => {
              const primaryTheme = (p.themeSlugs ?? [])[0];
              return (
                <a class="arch-row" href={publicationHref(p.collection, p.slug ?? '')}>
                  <div class="d">{p.publishedAt ? formatDateIso(p.publishedAt) : ''}</div>
                  <div class="ty">{PUBLICATIONS[p.collection]?.badge ?? ''}</div>
                  <div class="t">{p.title}</div>
                  <div class="p">{primaryTheme ?? '—'}</div>
                </a>
              );
            })}
          </div>
        );
      })
    )}
  </section>
</Layout>

<style>
  .container {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  /* Hero : centralisé dans src/components/Hero.astro */

  .archives {
    padding-top: 24px;
  }
  .archives .empty {
    padding: 64px 0;
    color: var(--color-muted);
    text-align: center;
    font-family: var(--font-sans);
  }

  /* Year groups */
  .arch-year {
    padding: 32px 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .arch-year h2 {
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -0.5px;
    margin: 0 0 24px;
  }
  .arch-year h2 .count {
    font-size: 14px;
    color: var(--color-muted);
    font-weight: 400;
  }
  .arch-row {
    display: grid;
    grid-template-columns: 120px 100px 1fr 160px;
    gap: 32px;
    padding: 14px 0;
    border-top: 1px solid var(--color-rule);
    align-items: baseline;
    color: inherit;
    transition: color 0.12s;
  }
  .arch-row:hover .t {
    color: var(--color-accent);
  }
  .arch-row .d {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }
  .arch-row .ty {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .arch-row .t {
    font-size: 18px;
    line-height: 1.35;
    font-weight: 500;
    transition: color 0.12s;
  }
  .arch-row .p {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 900px) {
    .container {
      padding: 0 var(--page-gutter-narrow);
    }
    .hero h1 {
      font-size: 40px;
    }
    .arch-year h2 {
      font-size: 32px;
    }
    .arch-row {
      grid-template-columns: 100px 1fr;
      gap: 16px;
    }
    .arch-row .ty,
    .arch-row .p {
      grid-column: 1 / -1;
    }
    .arch-row .p {
      text-align: left;
    }
  }
</style>
