---
/**
 * Page d'accueil — hero + barre de filtres + flux d'items.
 *
 * Trois sections empilées (cf design_handoff_tituba/Tituba B.html → Home) :
 *  1. Hero : kicker meta + h1 + lede (titre/lede éditables via global Site)
 *  2. Filtres : chips Type & Thème + compteur. Filtrage côté client en JS
 *     progressif via data-attrs ; persistance en URL hash. Lecture sans JS
 *     possible (la liste complète reste rendue).
 *  3. Flux : grille `120px 1fr 200px`, gap 48 px (cf. PostCard).
 *
 * Ajout d'une "Voir toutes les archives" en pied.
 */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PublicationCard from '../components/PublicationCard.astro';
import FormatIcon from '../components/FormatIcon.astro';
import { fetchCollection, fetchIndexPages, fetchPublicationCounts, type FeedDoc } from '../lib/payload';
import { PUBLICATIONS, PUBLICATION_ORDER, fetchFeed } from '../lib/publications';
import { formatHeroLede, formatHeroTitle } from '../lib/site';

type Theme = { id: number | string; slug: string; name: string };

type Post = FeedDoc;

type IndexPagesGlobal = {
  home?: {
    heroTitle?: string;
    heroLede?: string;
  };
};

const DEFAULT_HERO_TITLE =
  'Notes de recherche en *études de genre* et en relations internationales.';
const DEFAULT_HERO_LEDE =
  'Analyses longues, notes de lecture et fiches thématiques sur le genre, la géopolitique et les droits LGBTQI+ dans les rapports internationaux. Principalement en français.';

let posts: Post[] = [];
let total = 0;
let themeCounts: Record<string, number> = {};
let allThemes: Theme[] = [];
let indexPages: IndexPagesGlobal = {};
try {
  // Flux fusionné des cinq formats, servi par l'endpoint SQL : trier
  // et paginer un mélange de cinq collections côté client demanderait
  // de sur-récupérer massivement. Le filtre brouillon/date est posé
  // côté serveur, d'où l'absence de filterPublished ici.
  const [feed, counts, themes] = await Promise.all([
    fetchFeed({ limit: 200 }),
    fetchPublicationCounts('theme'),
    fetchCollection<Theme>('themes', { limit: 100, depth: 0, select: ['slug', 'name'] }),
  ]);
  posts = feed.docs as Post[];
  total = feed.totalDocs;
  themeCounts = counts;
  allThemes = themes;
} catch (err) {
  console.warn('[home] fetch failed, rendering empty:', (err as Error).message);
}
try {
  indexPages = await fetchIndexPages<IndexPagesGlobal>();
} catch (err) {
  console.warn('[home] fetchIndexPages failed, using defaults:', (err as Error).message);
}



const heroTitleHtml = formatHeroTitle(
  indexPages.home?.heroTitle?.trim() || DEFAULT_HERO_TITLE,
);
const heroLedeHtml = formatHeroLede(
  indexPages.home?.heroLede?.trim() || DEFAULT_HERO_LEDE,
);

// Thématiques proposées dans la barre de filtres.
// Toutes les thématiques qui portent au moins une publication, triées
// par usage puis par ordre alphabétique. Pas de troncature : les dix
// axes de l'association sont structurants, en cacher une partie
// reviendrait à masquer un pan du travail.
// Les dix axes de l'association, tous affichés — y compris ceux qui
// n'ont pas encore de publication : ils disent ce sur quoi Tituba
// travaille, pas seulement ce qui est déjà paru. Ceux qui sont vides
// portent la classe `empty`, qui les atténue visuellement.
const topThemes = allThemes.slice().sort((a, b) => {
  const d = (themeCounts[b.slug] ?? 0) - (themeCounts[a.slug] ?? 0);
  return d !== 0 ? d : a.name.localeCompare(b.name, 'fr');
});

// Mois/année du plus ancien post — affiché dans le kicker meta « depuis … ».
const monthLabel = (() => {
  if (!posts.length) return '';
  const dates = posts
    .map((p) => (p.publishedAt ? new Date(p.publishedAt).getTime() : NaN))
    .filter((t) => Number.isFinite(t));
  if (dates.length === 0) return '';
  const d = new Date(Math.min(...dates));
  const months = [
    'janvier',
    'février',
    'mars',
    'avril',
    'mai',
    'juin',
    'juillet',
    'août',
    'septembre',
    'octobre',
    'novembre',
    'décembre',
  ];
  return `${months[d.getMonth()]} ${d.getFullYear()}`;
})();
---

<Layout bodyClass="justify">
  <Hero
    kicker={`Tituba · ${total} publication${total > 1 ? 's' : ''}${monthLabel ? ` · depuis ${monthLabel}` : ''}`}
    title={heroTitleHtml}
    lede={heroLedeHtml}
  />

  <!-- Filtres -->
  <section class="filters" id="filters" data-total={total}>
    <div class="container">
      {topThemes.length > 0 && (
        <div class="row">
          <div class="grp" role="group" aria-label="Filtrer par thème">
            <span class="lbl">Thème</span>
            <button class="chip on" type="button" data-filter-theme="all">Tous</button>
            {topThemes.map((t) => (
              <button
                class:list={['chip', { empty: (themeCounts[t.slug] ?? 0) === 0 }]}
                type="button"
                data-filter-theme={t.slug}
                title={`${t.name} — ${themeCounts[t.slug] ?? 0} publication${(themeCounts[t.slug] ?? 0) > 1 ? 's' : ''}`}
              >
                {t.name}
              </button>
            ))}
          </div>
        </div>
      )}
      <div class="row">
        <div class="grp" role="group" aria-label="Filtrer par type">
          <span class="lbl">Format</span>
          <button class="chip on" type="button" data-filter-type="all">Tous</button>
          {PUBLICATION_ORDER.map((c) => (
            <button class="chip" type="button" data-filter-type={c}>
              <FormatIcon collection={c} />
              {PUBLICATIONS[c].labelPlural}
            </button>
          ))}
        </div>
        <div class="count" id="filter-count">
          {total} publication{total > 1 ? 's' : ''} · tri : récent
        </div>
      </div>
    </div>
  </section>

  <!-- Flux -->
  <section class="container feed">
    {posts.length === 0 ? (
      <p class="empty">Aucune publication pour l'instant.</p>
    ) : (
      posts.map((p) => (
        <PublicationCard
          collection={p.collection}
          numero={p.numero}
          slug={p.slug}
          title={p.title}
          themeSlugs={p.themeSlugs}
          publishedAt={p.publishedAt}
          lede={p.lede}
          readingTime={p.readingTime}
        />
      ))
    )}
    <div class="archives-link">
      <a href="/archives/" class="btn-link">Voir toutes les archives</a>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 80px;
  }
  @media (max-width: 900px) {
    .container {
      padding: 0 24px;
    }
  }

  /* Hero : styles centralisés dans src/components/Hero.astro */

  /* Filtres */
  .filters {
    padding: 18px 0;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: 13px;
  }
  .filters .row {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
  }
  /* Espacement vertical entre la ligne Thème et la ligne Type. */
  .filters .row + .row {
    margin-top: 10px;
  }
  .filters .grp {
    display: flex;
    gap: 6px;
    align-items: center;
    flex-wrap: wrap;
  }
  .filters .lbl {
    color: var(--color-muted);
    padding-right: 8px;
    /* Largeur fixe pour aligner les boutons « Tous » entre les deux
       lignes de filtres (Type et Thème ont des largeurs différentes
       sans cette contrainte). */
    min-width: 60px;
  }
  .chip {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font: inherit;
    transition: color 0.12s, border-color 0.12s, background 0.12s;
  }
  .chip.on {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }
  /* Thématique déclarée mais sans publication : lisible, sans attirer
     l'œil autant que celles qui mènent quelque part. */
  .chip.empty:not(.on) {
    opacity: 0.55;
  }
  .chip:hover:not(.on) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .filters .count {
    margin-left: auto;
    color: var(--color-muted);
  }
  .filters .sep {
    width: 1px;
    height: 20px;
    background: var(--color-rule);
  }

  /* Flux */
  .feed {
    /* Item border-bottom déjà géré dans PostCard */
  }
  .feed .empty {
    padding: 64px 0;
    color: var(--color-muted);
    text-align: center;
    font-family: var(--font-sans);
  }
  .archives-link {
    padding: 32px 0;
    text-align: center;
  }
  .btn-link {
    padding: 10px 24px;
    border-radius: 999px;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 13px;
    transition: background 0.12s, color 0.12s, border-color 0.12s;
    display: inline-block;
  }
  .btn-link:hover {
    background: var(--color-accent);
    color: var(--color-bg);
  }
</style>

<script>
  // Filtres home — JS progressif. Lecture sans JS = tout est rendu.
  // Sélection persistée en URL hash : #type=analyse&theme=queer-theory
  // Format compact : si 'all' partout, hash retiré.
  (function () {
    // Le narrow `if (!x) return` n'est pas conservé dans les closures
    // imbriquées (applyFilters, syncChipsFromState). On rebinde après la
    // garde pour donner un type non-nullable aux fonctions internes.
    const filtersRaw = document.getElementById('filters');
    const countElRaw = document.getElementById('filter-count');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.item'));
    if (!filtersRaw || !countElRaw || !items.length) return;
    const filters: HTMLElement = filtersRaw;
    const countEl: HTMLElement = countElRaw;

    type State = { type: string; theme: string };
    const state: State = { type: 'all', theme: 'all' };
    const total = Number(filters.getAttribute('data-total') || items.length);

    function readHash(): State {
      const hash = window.location.hash.replace(/^#/, '');
      if (!hash) return { type: 'all', theme: 'all' };
      const params = new URLSearchParams(hash);
      return {
        type: params.get('type') || 'all',
        theme: params.get('theme') || 'all',
      };
    }

    function writeHash() {
      const params = new URLSearchParams();
      if (state.type !== 'all') params.set('type', state.type);
      if (state.theme !== 'all') params.set('theme', state.theme);
      const str = params.toString();
      const newHash = str ? '#' + str : '';
      if (newHash !== window.location.hash) {
        history.replaceState(null, '', window.location.pathname + newHash);
      }
    }

    function applyFilters() {
      let visible = 0;
      for (const item of items) {
        const itemType = item.getAttribute('data-type') || '';
        const itemThemes = (item.getAttribute('data-themes') || '').split(' ').filter(Boolean);
        const okType = state.type === 'all' || itemType === state.type;
        const okTheme = state.theme === 'all' || itemThemes.includes(state.theme);
        const show = okType && okTheme;
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      }
      countEl.textContent =
        `${visible} publication${visible > 1 ? 's' : ''} sur ${total} · tri : récent`;
    }

    function syncChipsFromState() {
      filters.querySelectorAll<HTMLButtonElement>('[data-filter-type]').forEach((btn) => {
        btn.classList.toggle('on', btn.dataset.filterType === state.type);
      });
      filters.querySelectorAll<HTMLButtonElement>('[data-filter-theme]').forEach((btn) => {
        btn.classList.toggle('on', btn.dataset.filterTheme === state.theme);
      });
    }

    filters.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter-type], button[data-filter-theme]');
      if (!btn) return;
      if (btn.dataset.filterType) state.type = btn.dataset.filterType;
      if (btn.dataset.filterTheme) state.theme = btn.dataset.filterTheme;
      syncChipsFromState();
      applyFilters();
      writeHash();
    });

    // Init from URL hash
    const initial = readHash();
    state.type = initial.type;
    state.theme = initial.theme;
    syncChipsFromState();
    applyFilters();
  })();
</script>
