---
/**
 * Vue d'ensemble des auteur·ices internes — /auteurices/
 *
 * Calque de src/pages/themes/index.astro : grille de cartes avec
 * compteur d'usage. Seuls les comptes Users ayant signé au moins une
 * publication publiée apparaissent (cf publicationsAuthorsEndpoint) —
 * pas de fiche pour les auteur·ices externes (pas de compte, pas de
 * page cf plan validé).
 */
import PageShell from '../../components/ui/PageShell.astro';
import { fetchAuthorsList } from '../../lib/payload';
// Le nom peut porter des astérisques de surlignage : elles ne valent
// que sur la fiche de la personne, où le nom fait titre. Ici, elles ne
// se liraient que comme une coquille.
import { stripHeroMarkers } from '../../lib/site';

let authors: Awaited<ReturnType<typeof fetchAuthorsList>> = [];
try {
  authors = await fetchAuthorsList();
} catch (err) {
  console.warn('[auteurices] fetch failed:', (err as Error).message);
}

// Tri : décroissant par usage, puis alpha.
const sorted = authors.slice().sort((a, b) => {
  if (b.count !== a.count) return b.count - a.count;
  return (stripHeroMarkers(a.displayName) ?? '').localeCompare(
    stripHeroMarkers(b.displayName) ?? '',
    'fr',
  );
});
---

<PageShell
  documentTitle="Auteur·ices"
  description="Les auteur·ices internes de Tituba et leurs publications."
  title="Auteur·ices"
  lede="Les membres du collectif qui signent les publications de Tituba."
  famille="bleu"
>
  {sorted.length === 0 ? (
    <p class="text-muted py-16 text-center font-sans">Aucun·e auteur·ice pour l'instant.</p>
  ) : (
    <div class="grid grid-cols-2 gap-0 max-mobile:grid-cols-1">
      {sorted.map((a) => (
        <a class="border-rule group grid grid-cols-[1fr_100px] items-baseline gap-6 border-t py-6 text-inherit transition-colors duration-100 odd:border-r odd:pr-6 even:pl-6 max-mobile:odd:border-r-0 max-mobile:odd:pr-0 max-mobile:even:pl-0" href={`/auteurice/${a.id}/`}>
          <div class="group-hover:text-[var(--c-bleu-deep)] m-0 font-serif text-[calc(24px*var(--a11y-echelle))] leading-[1.2] font-(--font-weight-heading) tracking-[-0.02em] transition-colors duration-100">{stripHeroMarkers(a.displayName) ?? 'Auteur·ice'}</div>
          <div class="text-muted text-right font-sans text-[calc(14px*var(--a11y-echelle))]">
            {a.count} publication{a.count > 1 ? 's' : ''}
          </div>
        </a>
      ))}
    </div>
  )}
</PageShell>
