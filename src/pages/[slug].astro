---
/**
 * Catch-all des pages éditoriales libres — /<slug>/
 *
 * Matche tout ce qui n'est pas géré par les routes plus spécifiques
 * (/, /archives/, /themes/, /theme/<slug>/, /articles/<slug>/,
 * /rss.xml). Lit la collection `pages` Payload par slug.
 *
 * Réf : design_handoff_tituba/Tituba B.html → About + autres pages
 * structurées (terrains, recherche, publications, colophon).
 */
import PageShell from '../components/ui/PageShell.astro';
import PageRenderer from '../components/PageRenderer.astro';
import { fetchBySlug } from '../lib/payload';
import { formatHeroLede, formatHeroTitle, stripHeroMarkers } from '../lib/site';

type PageDoc = {
  id: number | string;
  slug: string;
  title: string;
  description?: string | null;
  noindex?: boolean;
  eyebrow?: string | null;
  lede?: string | null;
  sections?: Array<Record<string, unknown>> | null;
};

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const page = await fetchBySlug<PageDoc>('pages', slug);
if (!page) {
  return Astro.rewrite('/404');
}
---

<PageShell
  documentTitle={stripHeroMarkers(page.title)}
  description={page.description ?? page.lede ?? undefined}
  noindex={page.noindex ?? false}
  title={formatHeroTitle(page.title)}
  lede={page.lede ? formatHeroLede(page.lede) : undefined}
  famille="jaune"
>
  <PageRenderer sections={page.sections as never} />
</PageShell>
