---
/**
 * Vue d'ensemble des formats — /formats/
 *
 * Pendant de /themes/ : une page d'index par taxonomie. Les thématiques
 * disent de quoi on parle, les formats comment on en parle.
 *
 * Cette page existait en creux depuis longtemps — le header propose un
 * menu « Formats », mais un menu déroulant n'est pas une destination :
 * il n'est pas partageable, il n'apparaît pas dans un plan de site, et
 * sans JavaScript il ne s'ouvre pas. D'où une route réelle.
 *
 * Rien n'y est saisi : libellés, descriptions et racines d'URL viennent
 * de la table PUBLICATIONS, les compteurs d'une requête SQL unique.
 */
import PageShell from '../../components/ui/PageShell.astro';
import FormatIcon from '../../components/FormatIcon.astro';
import { fetchFeed, PUBLICATIONS, PUBLICATION_ORDER } from '../../lib/publications';
import { fetchIndexPages } from '../../lib/payload';
import { formatHeroTitle } from '../../lib/site';

type PagesFixes = { formats?: { heroTitle?: string; heroLede?: string } };

// Titre et chapô écrits en dur jusqu'ici — cette page était la seule
// des cinq à ne pas être réglable depuis l'admin. Les valeurs
// ci-dessous restent le repli si Payload ne répond pas, comme partout
// ailleurs : une page d'index doit s'afficher même privée du CMS.
const TITRE_DEFAUT = 'Cinq *formats*, une même exigence.';
const LEDE_DEFAUT =
  "Un texte long avec son appareil de notes n'appelle pas la même lecture qu'un rebond d'actualité ou qu'un kit d'animation. Chaque format a sa place, ses codes et sa page.";

let pagesFixes: PagesFixes = {};
try {
  pagesFixes = await fetchIndexPages<PagesFixes>();
} catch (err) {
  console.warn('[formats] fetchIndexPages failed:', (err as Error).message);
}
const heroTitre = pagesFixes.formats?.heroTitle?.trim() || TITRE_DEFAUT;
const heroLede = pagesFixes.formats?.heroLede?.trim() || LEDE_DEFAUT;

/** Familles de couleur, distribuées dans l'ordre éditorial. */
const FAMILLES = ['bleu', 'vert', 'jaune'] as const;

// Compteur par format. L'endpoint de comptage existant groupe par
// thématique ou par tag, pas par collection : on prend donc le flux et
// on compte, en une seule requête. La limite de 100 est celle de
// l'endpoint ; au-delà les compteurs sous-estimeraient, d'où le suffixe
// « + » quand on la touche.
let counts: Record<string, number> = {};
let total = 0;
let plafonne = false;
try {
  const feed = await fetchFeed({ limit: 100 });
  total = feed.totalDocs;
  plafonne = feed.docs.length < feed.totalDocs;
  for (const c of PUBLICATION_ORDER) counts[c] = 0;
  for (const d of feed.docs) counts[d.collection] = (counts[d.collection] ?? 0) + 1;
} catch (err) {
  console.warn('[formats] fetch failed:', (err as Error).message);
}

/** « 6 textes », « 1 épisode », « aucune ressource »… */
function compteur(c: (typeof PUBLICATION_ORDER)[number], n: number): string {
  const mot = c === 'podcasts' ? 'épisode' : c === 'outils' ? 'ressource' : 'texte';
  if (n === 0) return `Aucun${c === 'outils' ? 'e' : ''} ${mot} pour l'instant`;
  return `${n}${plafonne ? '+' : ''} ${mot}${n > 1 ? 's' : ''}`;
}
---

<PageShell
  documentTitle="Formats"
  description="Les cinq formats de publication de Tituba : articles de recherche, analyses, actus, podcasts et outils."
  title={formatHeroTitle(heroTitre)}
  lede={heroLede}
>
  <div class="grid">
    {PUBLICATION_ORDER.map((c, i) => {
      const spec = PUBLICATIONS[c];
      const n = counts[c] ?? 0;
      return (
        <a
          class="format-card"
          data-famille={FAMILLES[i % FAMILLES.length]}
          href={`${spec.routePrefix}/`}
        >
          <div class="left">
            <div class="ty mono">
              <FormatIcon collection={c} />
              {spec.routePrefix}
            </div>
            <div class="t">{spec.labelPlural}</div>
            <p class="desc">{spec.description}</p>
          </div>
          <div class="right">{compteur(c, n)}</div>
        </a>
      );
    })}
  </div>

  <p class="total">
    {total} publication{total > 1 ? 's' : ''} en ligne, tous formats confondus.
    <a href="/archives/">Voir les archives →</a>
  </p>
</PageShell>

<style>
  /* Gouttière et rythme vertical viennent de PageShell : cette page ne
     déclare plus que sa grille propre. */

  /* Deux colonnes, comme /themes/ : même registre de taxonomie, même
     grille. Cinq entrées donnent une colonne impaire d'une carte de
     plus que la paire — la dernière reste seule à gauche, cellule vide
     à sa droite, ce qui est aussi ce que /themes/ ferait avec un
     nombre impair de thèmes. */
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .format-card {
    display: grid;
    grid-template-columns: 1fr 140px;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--color-rule);
    align-items: baseline;
    color: inherit;
    transition: color 0.12s;
  }
  .format-card:nth-child(odd) {
    padding-right: 24px;
    border-right: 1px solid var(--color-rule);
  }
  .format-card:nth-child(even) {
    padding-left: 24px;
  }
  /* Les deux dernières cartes ferment la grille en bas — sur cinq
     entrées, ce sont les positions 4 et 5. */
  .format-card:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--color-rule);
  }

  /* La famille ne colore que la racine d'URL et le titre au survol. Le
     texte courant reste d'une seule encre — la couleur signale le
     format, elle n'a pas à teinter ce qu'on lit. */
  .format-card[data-famille='bleu'] {
    --fam: var(--c-bleu-deep);
  }
  .format-card[data-famille='vert'] {
    --fam: var(--c-vert-deep);
  }
  .format-card[data-famille='jaune'] {
    --fam: var(--c-jaune-deep);
  }
  .format-card:hover .t {
    color: var(--fam);
  }

  .format-card .ty {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fam);
    margin-bottom: 8px;
    letter-spacing: 0.04em;
  }
  .format-card .t {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.2;
    font-weight: var(--w-heading);
    letter-spacing: -0.02em;
    margin: 0 0 8px;
    transition: color 0.12s;
  }
  .format-card .desc {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
  }
  .format-card .right {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    text-align: right;
  }

  .total {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    margin: 28px 0 0;
  }
  .total a {
    color: var(--c-bleu-deep);
    margin-left: 8px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .format-card:nth-child(odd) {
      padding-right: 0;
      border-right: 0;
    }
    .format-card:nth-child(even) {
      padding-left: 0;
    }
    .format-card:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
    .format-card:last-child {
      border-bottom: 1px solid var(--color-rule);
    }
    /* Le compteur passe sous la description plutôt que de comprimer le
       titre dans une colonne de 140 px. */
    .format-card {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .format-card .right {
      text-align: left;
    }
  }
</style>
