---
/**
 * Page Recherche — /recherche/?q=…&page=…
 *
 * SSR : tape l'endpoint custom /cms/api/posts/search (FTS Postgres
 * avec websearch_to_tsquery + ts_rank + ts_headline). Le hook
 * services/payload/src/hooks/update-post-search-vector maintient la
 * colonne `posts.search_vector` à jour à chaque save.
 *
 * États gérés :
 *  - Q vide → écran d'accueil de recherche (input + tip syntaxe)
 *  - Aucun résultat → message + suggestion
 *  - Résultats → liste avec excerpts surlignés (mots matchés en
 *                <mark>) + pagination simple
 *
 * Surlignage : ts_headline produit du HTML avec `<mark>...</mark>`.
 * On l'injecte via set:html — la source est Postgres, pas une saisie
 * utilisateur brute, donc safe.
 */

import PageShell from '../components/ui/PageShell.astro';
import { searchPublications, type SearchPost } from '../lib/payload';
import { publicationHref } from '../lib/publications';
import { formatDateIso, formatHeroLede, formatHeroTitle, stripHeroMarkers } from '../lib/site';

const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') ?? '').trim();
const pageParam = parseInt(url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(pageParam) && pageParam > 0 ? pageParam : 1;

let docs: SearchPost[] = [];
let totalDocs = 0;
let totalPages = 1;
let fetchError: string | null = null;

if (q) {
  try {
    const r = await searchPublications(q, { page, limit: 20 });
    docs = r.docs;
    totalDocs = r.totalDocs;
    totalPages = r.totalPages;
  } catch (err) {
    fetchError = (err as Error).message;
    console.warn('[recherche] search failed:', fetchError);
  }
}

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

const heroTitleHtml = formatHeroTitle('Chercher dans *Tituba*.');
// formatHeroLede échappe tout le HTML reçu — incompatible avec un
// lede qui contient déjà des balises `<em>` autour de la requête.
// On échappe nous-mêmes la requête (qui PEUT contenir n'importe quoi)
// et on bypass formatHeroLede pour le cas avec résultat.
const heroLedeHtml = q
  ? `${totalDocs} résultat${totalDocs > 1 ? 's' : ''} pour <em>${escapeHtml(q)}</em>.`
  : formatHeroLede(
      'Tapez un mot, une phrase entre guillemets, ou plusieurs mots à la fois. Le moteur cherche dans le titre, le chapô, le corps, les notes et la bibliographie liée.',
    );

function pageHref(p: number): string {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (p > 1) params.set('page', String(p));
  const qs = params.toString();
  return qs ? `/recherche/?${qs}` : '/recherche/';
}

/**
 * Bleu partout où l'ancien code lisait --color-accent : la recherche est
 * un utilitaire neutre, pas rattachée à une famille éditoriale, et le
 * bleu est celui qu'on retrouve déjà sur les autres liens neutres du
 * site (pied de page, cartes de format par défaut).
 */

/** Phrase centrée : une erreur, ou une recherche sans résultat. */
const REPONSE =
  'text-muted py-12 text-center font-serif text-courant [&_em]:text-ink [&_em]:italic';

---

<PageShell
  documentTitle={q ? `Recherche : ${q}` : 'Recherche'}
  description={q ? `Résultats de recherche pour « ${q} ».` : 'Recherche sur Tituba.'}
  title={heroTitleHtml}
  lede={heroLedeHtml}
>
  {/* Gouttière et rythme vertical viennent de PageShell. */}
  <div class="pt-0 pb-20">
    {/* Sous 720 px le champ et le bouton s'empilent : à deux, ils ne
        laissaient plus assez de place à la saisie. */}
    <form
      method="get"
      action="/recherche/"
      class="mb-8 flex max-w-[720px] gap-2 max-poche:flex-col"
      role="search"
    >
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Cherchez sur Tituba…"
        autofocus={!q}
        aria-label="Rechercher"
        class="border-rule bg-bg text-ink flex-1 border px-3.5 py-2.5 font-serif text-sublede leading-[1.4] focus:border-[var(--c-bleu-deep)] focus:outline-none"
      />
      <button
        type="submit"
        class="cursor-pointer border border-[var(--c-bleu-fill)] bg-[var(--c-bleu-fill)] px-[18px] py-2.5 font-sans text-[calc(13px*var(--a11y-echelle))] font-medium text-[var(--c-bleu-on)] hover:brightness-[0.94]"
      >
        Chercher
      </button>
    </form>

    {fetchError && <p class={REPONSE}>Une erreur est survenue : {fetchError}.</p>}

    {!q && !fetchError && (
      <div class="bg-bg text-muted my-6 border-l-2 border-[var(--c-bleu-deep)] py-[18px] pr-[22px] pl-[22px] font-sans text-[calc(13.5px*var(--a11y-echelle))]">
        <h2 class="text-muted m-0 mb-2.5 font-mono text-label font-normal tracking-label uppercase">
          Astuces
        </h2>
        <ul class="m-0 pl-[18px] leading-[1.7] [&_code]:text-ink [&_code]:rounded-[2px] [&_code]:bg-[color-mix(in_oklch,var(--color-ink),transparent_92%)] [&_code]:px-1 [&_code]:font-mono [&_code]:text-[calc(12.5px*var(--a11y-echelle))]">
          <li><code>spivak agency</code> → publications contenant les deux mots</li>
          <li><code>"théorie postcoloniale"</code> → expression exacte</li>
          <li><code>spivak -postcolonial</code> → exclure un terme</li>
          <li><code>queer or trans</code> → l'un ou l'autre</li>
        </ul>
      </div>
    )}

    {q && !fetchError && docs.length === 0 && (
      <p class={REPONSE}>Aucun résultat pour <em>« {q} »</em>.</p>
    )}

    {q && docs.length > 0 && (
      <ol class="m-0 flex list-none flex-col gap-7 p-0">
        {docs.map((d, rang) => (
          <li
            class:list={[
              'pb-6',
              // Le dernier résultat ne porte pas de filet : c'était
              // `:last-child`, c'est le rang de la boucle.
              rang < docs.length - 1 && 'border-rule border-b',
            ]}
          >
            <a
              href={publicationHref(d.collection, d.publicId)}
              class="text-ink mb-1.5 block font-serif text-[calc(22px*var(--a11y-echelle))] leading-[1.3] font-normal no-underline hover:text-[var(--c-bleu-deep)] hover:underline"
            >
              {stripHeroMarkers(d.title)}
            </a>
            <div class="text-muted mb-2 flex items-baseline gap-3 font-sans text-meta">
              {/* En sans, comme le reste de la ligne. Une règle voulait la
                  date en mono, mais elle visait `.id` quand le balisage
                  écrit `.d` : elle n'a jamais rien fait, et l'appliquer
                  aurait changé le rendu sans qu'on l'ait demandé. */}
              {d.publishedAt && <span>{formatDateIso(d.publishedAt)}</span>}
            </div>
            {d.excerpt && (
              /* ts_headline pose des <mark>…</mark> autour des mots
                 trouvés : ils arrivent par set:html, donc stylés par
                 variante descendante. */
              <p
                class="text-muted m-0 font-serif text-[calc(15px*var(--a11y-echelle))] leading-[1.55] [&_mark]:text-ink [&_mark]:bg-[color-mix(in_oklch,var(--c-bleu-deep),transparent_80%)] [&_mark]:px-0.5 [&_mark]:font-medium"
                set:html={d.excerpt}
              />
            )}
          </li>
        ))}
      </ol>
    )}

    {q && totalPages > 1 && (
      <nav
        class="mt-12 flex items-center justify-between gap-4 font-sans text-[calc(13px*var(--a11y-echelle))] max-poche:flex-col max-poche:items-stretch max-poche:text-center [&_a]:text-ink [&_a]:border-rule [&_a]:border-b [&_a]:pb-0.5 [&_a]:no-underline [&_a:hover]:text-[var(--c-bleu-deep)] [&_a:hover]:border-b-[var(--c-bleu-deep)]"
        aria-label="Pages de résultats"
      >
        {page > 1 && <a href={pageHref(page - 1)} rel="prev">← Page précédente</a>}
        <span class="text-muted">Page {page} sur {totalPages}</span>
        {page < totalPages && <a href={pageHref(page + 1)} rel="next">Page suivante →</a>}
      </nav>
    )}
  </div>
</PageShell>
