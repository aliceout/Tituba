---
/**
 * Page d'un thème individuel — /theme/<slug>/
 *
 * Hero spécifique au thème (kicker `Thème · #slug`, h1 du thème,
 * description éditoriale, compteur + lien retour vers la vue
 * d'ensemble), puis le même flux d'items que l'accueil filtré
 * sur ce thème.
 *
 * Réf : design_handoff_tituba/Tituba B.html → PolePage (single).
 */
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import CardFilterBar from '../../components/CardFilterBar.astro';
import { PUBLICATIONS, PUBLICATION_ORDER } from '../../lib/publications';
import {
  fetchBySlug,
  fetchCollection,
  fetchIndexPages,
  filterPublished,
  publishedOnly,
} from '../../lib/payload';
import { fetchFeed } from '../../lib/publications';
import type { FeedDoc } from '../../lib/payload';

type IndexPagesGlobal = { themes?: { enabled?: boolean } };

type Theme = {
  id: number | string;
  slug: string;
  name: string;
  description?: string | null;
};


type Post = FeedDoc;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/themes/');

// Toggle « Page Thèmes » désactivé → 404 (cf. Pages d'index → Thèmes).
// On vérifie ici aussi parce que `/theme/<slug>/` partage la même
// section que `/themes/`.
try {
  const indexPages = await fetchIndexPages<IndexPagesGlobal>();
  if (indexPages.themes?.enabled === false) {
    return Astro.rewrite('/404');
  }
} catch {
  /* Payload down — on continue, le toggle est best-effort. */
}

const theme = await fetchBySlug<Theme>('themes', slug);
if (!theme) {
  return new Response('Thème introuvable', { status: 404 });
}

let posts: Post[] = [];
try {
  // Flux fusionné restreint à cette thématique : les cinq formats
  // y apparaissent ensemble, triés par date.
  const feed = await fetchFeed({ theme: slug, limit: 200 });
  posts = feed.docs;
} catch (err) {
  console.warn('[theme] posts fetch failed:', (err as Error).message);
}

const total = posts.length;

// Formats réellement représentés sous cette thématique, dans l'ordre
// éditorial. Un filtre vide n'aurait pas de sens ici non plus.
const formatCounts = new Map<string, number>();
for (const p of posts) formatCounts.set(p.collection, (formatCounts.get(p.collection) ?? 0) + 1);
const formatOptions = PUBLICATION_ORDER.filter((c) => formatCounts.has(c)).map((c) => ({
  value: c,
  label: PUBLICATIONS[c].labelPlural,
  count: formatCounts.get(c) ?? 0,
}));
---

<Layout
  title={theme.name}
  description={theme.description ?? `Toutes les publications de Tituba sur la thématique ${theme.name}.`}
>
  <Hero
    kicker={`Thème · #${theme.slug}`}
    kickerVariant="mono"
    title={theme.name}
    lede={theme.description ?? undefined}
  >
    <div class="hero-bottom-meta">
      <span>{total} publication{total > 1 ? 's' : ''}</span>
      <span aria-hidden="true">·</span>
      <a class="back mono" href="/themes/">← tous les thèmes</a>
    </div>
  </Hero>

  <CardFilterBar
    dimension="type"
    label="Format"
    options={formatOptions}
    total={total}
  />

  <section class="container feed">
    {posts.length === 0 ? (
      <p class="empty">Aucune publication sous cette thématique pour l'instant.</p>
    ) : (
      posts.map((p) => (
        <PublicationCard
          collection={p.collection}
          numero={p.numero}
          slug={p.slug}
          title={p.title}
          themeSlugs={p.themeSlugs}
          publishedAt={p.publishedAt}
          lede={p.lede}
          readingTime={p.readingTime}
          showThemes={false}
        />
      ))
    )}
  </section>
</Layout>

<style>
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 80px;
  }

  /* Hero : centralisé dans src/components/Hero.astro. Le pied de hero
     spécifique à cette page (compteur + back link) est passé via le
     <slot> et stylé ci-dessous. */
  .hero-bottom-meta {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 24px;
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .hero-bottom-meta .back {
    color: var(--color-accent);
    transition: color 0.12s;
  }
  .hero-bottom-meta .back:hover {
    color: var(--color-ink);
  }

  .feed .empty {
    padding: 64px 0;
    color: var(--color-muted);
    text-align: center;
    font-family: var(--font-sans);
  }

  @media (max-width: 900px) {
    .container {
      padding: 0 24px;
    }
  }
</style>
