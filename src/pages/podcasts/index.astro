---
/**
 * Index du format « podcasts » — /podcasts/
 *
 * Cette page ne passe plus par PublicationIndex, contrairement aux
 * quatre autres formats, et c'est délibéré : l'audio se parcourt par
 * émission, pas par publication. Une liste plate d'épisodes venus de
 * plusieurs émissions mélange des contextes, et devient illisible dès
 * qu'il y en a une trentaine.
 *
 * D'où deux temps. Les émissions d'abord — c'est ce à quoi on s'abonne
 * et ce qu'on reconnaît. Les derniers épisodes ensuite, toutes émissions
 * confondues : quelqu'un qui arrive ici veut souvent écouter tout de
 * suite, et un épisode peut n'appartenir à aucune émission, le
 * rattachement étant facultatif.
 */
import PageShell from '../../components/ui/PageShell.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { fetchCollection, publishedOnly, uploadedImageUrl, type FeedDoc } from '../../lib/payload';
import { PUBLICATIONS, fetchSeries, type Serie } from '../../lib/publications';
import { formatHeroTitle, stripHeroMarkers } from '../../lib/site';

const spec = PUBLICATIONS.podcasts;

const emissions: Serie[] = await fetchSeries('podcasts');

type Episode = FeedDoc & { series?: number | string | { id: number | string } | null };

/**
 * Rattachements de tous les épisodes publiés, pour compter ceux de
 * chaque émission.
 *
 * Requête séparée de celle qui alimente les listes, et volontairement :
 * elle ne rapporte qu'un champ, à profondeur nulle, ce qui la rend
 * assez légère pour couvrir tout le catalogue. Le compte était jusqu'ici
 * dérivé des trente épisodes affichés — au-delà, une émission de
 * quarante épisodes s'en annonçait trente, sans que rien ne signale que
 * le chiffre était tronqué. Un compteur faux est pire qu'un compteur
 * absent : celui-ci ne prévient pas.
 */
let rattachements: Episode[] = [];
try {
  rattachements = await fetchCollection<Episode>('podcasts', {
    depth: 0,
    limit: 1000,
    where: publishedOnly(),
    select: ['series'],
  });
} catch (err) {
  console.warn('[podcasts] comptage failed:', (err as Error).message);
}

const idDe = (v: unknown): string =>
  v && typeof v === 'object' && 'id' in (v as Record<string, unknown>)
    ? String((v as { id: unknown }).id)
    : String(v ?? '');

const comptes = new Map<string, number>();
for (const e of rattachements) {
  const k = idDe(e.series);
  if (k) comptes.set(k, (comptes.get(k) ?? 0) + 1);
}

/**
 * Épisodes rattachés à aucune émission. Le rattachement est facultatif,
 * donc ce cas est normal — mais depuis que la page liste les émissions
 * plutôt que les épisodes, ces enregistrements n'étaient plus atteignables
 * depuis aucun index : publiés, servis à leur adresse, et introuvables
 * en naviguant.
 *
 * Filtre posé côté requête (`exists=false`) plutôt qu'après coup : un
 * tri local laisserait les épisodes rattachés consommer la limite, et la
 * liste des orphelins rétrécirait à mesure que le catalogue grossit.
 */
let orphelins: Episode[] = [];
try {
  orphelins = await fetchCollection<Episode>('podcasts', {
    depth: 1,
    limit: 60,
    sort: '-publishedAt',
    where: [...publishedOnly(), { field: 'series', operator: 'exists', value: false }],
  });
} catch (err) {
  console.warn('[podcasts] orphelins failed:', (err as Error).message);
}

// Liste de repli, montrée seulement quand il n'y a aucune émission —
// sinon la page n'aurait rien à afficher.
let episodes: Episode[] = [];
if (emissions.length === 0) {
  try {
    episodes = await fetchCollection<Episode>('podcasts', {
      depth: 1,
      limit: 30,
      sort: '-publishedAt',
      where: publishedOnly(),
    });
  } catch (err) {
    console.warn('[podcasts] fetchCollection failed:', (err as Error).message);
  }
}
---

<PageShell
  documentTitle={spec.labelPlural}
  description="Les émissions de Tituba et leurs derniers épisodes."
  title={formatHeroTitle('Nos *émissions*.')}
  lede="Des conversations enregistrées, réunies par émission. Chacune suit son fil, et chacune s’écoute ou s’abonne séparément."
>
  {emissions.length > 0 && (
    <section class="emissions" aria-label="Émissions">
      {emissions.map((em) => {
        const img = uploadedImageUrl(em.image ?? null);
        const n = comptes.get(String(em.id)) ?? 0;
        return (
          <a class="em" href={`/series/${em.slug}/`}>
            {/* Faute d'image, le carré reste un aplat plutôt qu'un cadre
                vide : une émission sans couverture doit avoir l'air
                d'attendre la sienne, pas d'être cassée. */}
            <div class:list={['em-vignette', { 'em-vignette--nue': !img }]}>
              {img && <img src={img} alt="" />}
            </div>
            <div class="em-texte">
              <h2>{stripHeroMarkers(em.name)}</h2>
              {em.lede && <p class="em-lede">{em.lede}</p>}
              <p class="em-compte">
                {n === 0 ? 'Aucun épisode publié' : `${n} épisode${n > 1 ? 's' : ''}`}
              </p>
            </div>
          </a>
        );
      })}
    </section>
  )}

  {/* Les épisodes rattachés à aucune émission, qui n'auraient sinon
      aucune porte d'entrée. Sous les pochettes et sous leur propre
      titre : ce sont des enregistrements à part entière, pas un fond
      de tiroir — mais ils ne suivent aucun fil, et l'annoncer évite de
      chercher l'émission dont ils feraient partie. */}
  {emissions.length > 0 && orphelins.length > 0 && (
    <section class="hors-serie" aria-labelledby="hors-serie-titre">
      <h2 class="derniers-titre" id="hors-serie-titre">Épisodes hors émission</h2>
      <div class="feed">
        {orphelins.map((d) => (
          <PublicationCard
            collection="podcasts"
            docId={d.publicId}
            title={d.title}
            themeSlugs={d.themeSlugs}
            publishedAt={d.publishedAt}
            lede={d.lede}
            readingTime={d.readingTime}
            durationSeconds={d.durationSeconds}
          />
        ))}
      </div>
    </section>
  )}

  {/* Les épisodes ne sont listés que faute d'émission à montrer :
      sinon la page n'aurait aucun contenu. Dès qu'une émission existe,
      c'est par elle qu'on entre — la liste faisait double emploi et
      occupait plus de place que les pochettes qu'elle doublait. */}
  {emissions.length === 0 && (
  <section class="derniers" aria-labelledby="derniers-titre">
    <h2 class="derniers-titre" id="derniers-titre">Épisodes</h2>
    {episodes.length === 0 ? (
      <p class="vide">Aucun épisode publié pour l’instant.</p>
    ) : (
      <div class="feed">
        {episodes.map((d) => (
          <PublicationCard
            collection="podcasts"
            docId={d.publicId}
            title={d.title}
            themeSlugs={d.themeSlugs}
            publishedAt={d.publishedAt}
            lede={d.lede}
            readingTime={d.readingTime}
            durationSeconds={d.durationSeconds}
          />
        ))}
      </div>
    )}
  </section>
  )}
</PageShell>

<style>
  /* Une émission se présente comme une pochette : le carré d'abord, le
     texte à côté. C'est la convention de toutes les applications
     d'écoute, et elle rend la vignette reconnaissable avant le nom. */
  .emissions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 28px 36px;
    margin-bottom: 72px;
  }
  .em {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 20px;
    align-items: start;
    color: inherit;
    transition: opacity 0.12s;
  }
  .em:hover {
    opacity: 0.78;
  }
  .em-vignette {
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-rule);
  }
  .em-vignette--nue {
    background: color-mix(in srgb, var(--color-accent) 16%, var(--color-bg));
  }
  .em-vignette img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .em-texte h2 {
    font-family: var(--font-serif);
    font-size: calc(21px * var(--a11y-echelle));
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .em-lede {
    white-space: pre-line;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: calc(14px * var(--a11y-echelle));
    line-height: 1.5;
    color: var(--color-muted);
    margin: 0 0 10px;
    /* Trois lignes : la carte annonce l'émission, sa page la présente. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .em-compte {
    font-family: var(--font-mono);
    font-size: calc(11px * var(--a11y-echelle));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }

  .derniers-titre {
    font-family: var(--font-mono);
    font-size: calc(11px * var(--a11y-echelle));
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-rule);
  }
  /* Bloc et non grille : PublicationCard est conçue pour occuper une
     ligne entière — mise en case, elle se retrouvait sur 305 px de
     large et 765 de haut. Même traitement que l'index des autres
     formats (cf PublicationIndex, .feed), qui les empile.
     C'est aussi ce qui garde les filets de séparation entre cartes,
     posés par la carte elle-même sur son bord haut. */
  .feed {
    padding-bottom: 40px;
  }
  .vide {
    font-family: var(--font-sans);
    color: var(--color-muted);
  }

  @media (max-width: 720px) {
    .emissions {
      grid-template-columns: 1fr;
      gap: 22px;
      margin-bottom: 48px;
    }
    .em {
      grid-template-columns: 96px 1fr;
      gap: 14px;
    }
  }
</style>
