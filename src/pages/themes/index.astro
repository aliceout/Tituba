---
/**
 * Vue d'ensemble des thèmes — /themes/
 *
 * Hero + grille 2 colonnes des thèmes avec compteur d'usages.
 * Chaque carte = `#slug` mono accent, nom du thème 24 px, compteur
 * à droite.
 *
 * Réf : design_handoff_tituba/Tituba B.html → PolePage (overview).
 */
import PageShell from '../../components/ui/PageShell.astro';
import Empty from '../../components/ui/Empty.astro';
import { fetchCollection, fetchIndexPages, fetchPublicationCounts } from '../../lib/payload';
import { formatHeroLede, formatHeroTitle } from '../../lib/site';

type Theme = {
  id: number | string;
  slug: string;
  name: string;
  description?: string | null;
};

type IndexPagesGlobal = {
  themes?: { enabled?: boolean; heroTitle?: string; heroLede?: string };
};

const DEFAULT_TITLE = 'Nos *thématiques*.';
const DEFAULT_LEDE =
  'Chaque publication est rattachée à une ou plusieurs thématiques. La taxonomie est libre et évolue avec nos travaux.';

let themes: Theme[] = [];
let counts: Map<string, number> = new Map();
let indexPages: IndexPagesGlobal = {};
try {
  themes = await fetchCollection<Theme>('themes', {
    sort: 'name',
    limit: 100,
    depth: 0,
  });
  // Une requête SQL renvoie tous les compteurs, toutes collections
  // confondues. Auparavant on chargeait mille documents rien que pour
  // les compter — et avec cinq collections ce serait cinq fois pire.
  counts = new Map(Object.entries(await fetchPublicationCounts('theme')));
} catch (err) {
  console.warn('[themes] fetch failed:', (err as Error).message);
}
try {
  indexPages = await fetchIndexPages<IndexPagesGlobal>();
} catch (err) {
  console.warn('[themes] fetchIndexPages failed, using defaults:', (err as Error).message);
}

// Si le toggle « Page Thèmes » est désactivé côté admin, on 404 aussi
// bien /themes/ que /theme/<slug>/ (cf. pages/theme/[slug].astro qui
// fait la même vérification).
if (indexPages.themes?.enabled === false) {
  return Astro.rewrite('/404');
}

// Tri : décroissant par usage, puis alpha
const sorted = themes.slice().sort((a, b) => {
  const ca = counts.get(a.slug) ?? 0;
  const cb = counts.get(b.slug) ?? 0;
  if (ca !== cb) return cb - ca;
  return a.name.localeCompare(b.name, 'fr');
});

const heroTitleHtml = formatHeroTitle(indexPages.themes?.heroTitle?.trim() || DEFAULT_TITLE);
const heroLedeHtml = formatHeroLede(indexPages.themes?.heroLede?.trim() || DEFAULT_LEDE);
---

<PageShell
  documentTitle="Thèmes"
  description="Les sujets de recherche de Tituba — taxonomie multivaluée et libre."
  title={heroTitleHtml}
  lede={heroLedeHtml}
  famille="violet"
>
  {/* Gouttière et rythme vertical viennent de PageShell. */}
  {
    sorted.length === 0 ? (
      <Empty>Aucun thème pour l'instant.</Empty>
    ) : (
      <div class="max-mobile:grid-cols-1 grid grid-cols-2 gap-0">
        {sorted.map((t, rang) => {
          const count = counts.get(t.slug) ?? 0;
          // Colonne de gauche ou de droite : c’était deux règles
          // :nth-child(odd/even), c’est le rang de la boucle. Le filet
          // vertical n’existe que tant qu’il y a deux colonnes.
          const gauche = rang % 2 === 0;
          return (
            <a
              class:list={[
                'group border-rule grid grid-cols-[1fr_100px] items-baseline gap-6 border-t py-6 text-inherit transition-colors duration-[120ms]',
                gauche
                  ? 'border-rule max-mobile:border-r-0 max-mobile:pr-0 border-r pr-6'
                  : 'max-mobile:pl-0 pl-6',
              ]}
              href={`/theme/${t.slug}/`}
            >
              <div>
                <div class="mono text-label mb-2 font-mono tracking-[0.04em] text-[var(--c-violet-deep)]">
                  #{t.slug}
                </div>
                {/* Violet : la famille de cette taxonomie, cohérente avec le
                  panneau « Au sommaire » de l’accueil qui la porte déjà. */}
                <div class="font-heading m-0 mb-2 font-serif text-[calc(24px*var(--a11y-echelle))] leading-[1.2] tracking-[-0.02em] transition-colors duration-[120ms] group-hover:text-[var(--c-violet-deep)]">
                  {t.name}
                </div>
                {t.description && (
                  <p class="text-muted m-0 font-serif text-[calc(15px*var(--a11y-echelle))] leading-[1.55]">
                    {t.description}
                  </p>
                )}
              </div>
              <div class="text-muted text-right font-sans text-[calc(14px*var(--a11y-echelle))]">
                {count} publication{count > 1 ? 's' : ''}
              </div>
            </a>
          );
        })}
      </div>
    )
  }
</PageShell>
