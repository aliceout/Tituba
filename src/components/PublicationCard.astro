---
/**
 * Item de flux d'accueil — grille `120px 1fr 80px`, gap 48 px.
 * Réutilisé sur la home, la page d'un thème individuel et la
 * future page archives par série.
 *
 * Colonne gauche : format + date sur deux lignes + temps de lecture
 * Colonne centre : kicker (type · thèmes) + titre + chapô
 * Colonne droite : appel à l'action en accent — « Lire → », ou
 * « Écouter → » pour un épisode (cf PUBLICATIONS.actionLabel)
 *
 * Hover : titre passe en accent.
 *
 * Réf : design_handoff_tituba/Tituba B.html → .item.
 */
import { formatDateFr, stripHeroMarkers } from '../lib/site';
import FormatIcon from './FormatIcon.astro';
import {
  PUBLICATIONS,
  publicationHref,
  readingLabelFor,
  type PublicationCollection,
} from '../lib/publications';

type Theme = { id: number | string; slug: string; name: string };

export interface Props {
  title: string | null;
  /** Identifiant public du document — forme l'URL publique. */
  docId: string;
  /** Collection d'origine — pilote l'URL, la pastille et la durée. */
  collection: PublicationCollection;
  /** Durée d'écoute, pour les podcasts. */
  durationSeconds?: number | null;
  themes?: Array<Theme | number | string> | null;
  /** Slugs de thématiques, quand ils viennent du flux SQL fusionné. */
  themeSlugs?: string[] | null;
  publishedAt: string | Date | null;
  lede: string | null;
  readingTime?: number | null;
  /** Affiche/masque les noms de thèmes dans le kicker (utile sur la page d'un thème, où c'est redondant). */
  showThemes?: boolean;
}

const {
  title,
  docId,
  collection,
  durationSeconds,
  themes,
  themeSlugs: themeSlugsProp,
  publishedAt,
  lede,
  readingTime,
  showThemes = true,
} = Astro.props;

// Sépare la date "14 avril 2026" en "14 avril" + "2026" sur deux lignes
const dateFr = publishedAt ? formatDateFr(publishedAt) : '';
const dateParts = dateFr.split(' ');
const dateDay = dateParts.slice(0, 2).join(' ');
const dateYear = dateParts.slice(2).join(' ');

const populatedThemes = (themes ?? []).filter(
  (t): t is Theme => typeof t === 'object' && t !== null && 'slug' in t,
);
// Les thématiques arrivent soit peuplées (fetch par collection), soit
// déjà réduites à des slugs (flux SQL fusionné).
const themeSlugs = (themeSlugsProp ?? populatedThemes.map((t) => t.slug)).join(' ');

// Le libellé de durée dépend du format : minutes de lecture pour les
// textes, minutes d'écoute pour un podcast, rien pour un outil.
const readingLabel = readingLabelFor(collection, { readingTime, durationSeconds }) || null;
const spec = PUBLICATIONS[collection] ?? PUBLICATIONS.articles;
const href = publicationHref(collection, docId);
---

{
  /* La classe `item` reste : c’est le crochet du filtrage client (cf
    CardFilterBar), pas une accroche de style. `group` sert au survol du
    titre, qui se déclenche sur toute la carte.

    Sous 900 px la troisième colonne passe sous les deux autres, alignée
    à gauche : à 80 px de large elle ne tenait plus son libellé. */
}
<article
  class="item group border-rule max-mobile:grid-cols-[90px_1fr] max-mobile:gap-6 grid grid-cols-[120px_1fr_80px] items-baseline gap-12 border-b py-[calc(40px*var(--density-feed))]"
  data-type={collection}
  data-themes={themeSlugs}
>
  {
    /* Colonne de gauche masquée aux lecteurs d’écran : format et date y
      répètent ce que la colonne centrale annonce déjà. */
  }
  <a
    class="text-muted text-meta flex min-h-full flex-col justify-between font-sans no-underline"
    href={href}
    aria-hidden="true"
    tabindex="-1"
  >
    <div class="text-label mb-2.5 tracking-[0.1em] text-[var(--c-bleu-deep)] uppercase">
      <FormatIcon collection={collection} />{spec.badge}
    </div>
    <div>
      <div class="text-ink text-[calc(13px*var(--a11y-echelle))] font-medium">{dateDay}</div>
      <div>{dateYear}</div>
      {readingLabel && <div class="text-label mt-3">{readingLabel}</div>}
    </div>
  </a>
  <a class="text-inherit no-underline" href={href}>
    {
      showThemes && populatedThemes.length > 0 && (
        <div class="text-label mb-2.5 font-sans tracking-[0.1em] text-[var(--c-bleu-deep)] uppercase">
          <span class="text-muted">
            {populatedThemes.map((t, i) => (
              <>
                {i > 0 && ', '}
                <span>{t.name}</span>
              </>
            ))}
          </span>
        </div>
      )
    }
    {
      /* Les `*` d’un titre ne sont interprétés que dans le h1 de la page
        de lecture (cf formatHeroTitle) : partout ailleurs on affiche le
        texte nu, sinon on lirait « L’*homonationalisme* » dans les
        listes. Fait ici et non chez les appelants pour que le cas soit
        traité une fois pour toutes les surfaces qui passent par la
        carte. */
    }
    <h2
      class="m-0 mb-3 text-[calc(26px*var(--a11y-echelle))] leading-[1.2] font-semibold tracking-[-0.3px] transition-colors duration-[120ms] group-hover:text-[var(--c-bleu-deep)]"
    >
      {stripHeroMarkers(title)}
    </h2>
    {
      /* Retours à la ligne du chapô conservés — même parti que sur les
        autres surfaces qui affichent un champ multiligne. */
    }
    <p
      class="text-body-soft m-0 text-[calc(16px*var(--a11y-echelle))] leading-[1.55] whitespace-pre-line"
    >
      {lede}
    </p>
  </a>
  <a
    class="text-muted text-meta max-mobile:col-span-full max-mobile:pt-2 max-mobile:text-left flex min-h-full flex-col justify-between text-right font-sans no-underline"
    href={href}
  >
    <div class="font-medium text-[var(--c-bleu-deep)]">{spec.actionLabel} →</div>
  </a>
</article>
