---
/**
 * Dispatcher de blocks Page (Pages.sections).
 *
 * Chaque entrée de la collection Pages a un champ `sections` typé
 * `blocks` qui peut contenir Prose, Figure, CitationBloc (cf
 * services/payload/src/blocks/index.ts → pageBlocks).
 *
 * Ici on rend chaque block en HTML/composant Astro selon son
 * `blockType`. Pour les inconnus on log et on skip — pas de fallback
 * cassant.
 */
import { renderLexical } from '../lib/lexical';

type Block = {
  blockType?: string;
  id?: string;
  // Prose et Dépliant — même forme, un titre et du rich text.
  titre?: string;
  content?: unknown;
  /** Dépliant : ouvert dès l'arrivée sur la page. */
  ouvert?: boolean;
  // Figure
  image?: { filename?: string; alt?: string } | string | number | null;
  legende?: string;
  credit?: string;
  align?: 'left' | 'center' | 'wide';
  // CitationBloc
  text?: string;
  source?: string;
};

export interface Props {
  sections?: Block[] | null;
  /** URL publique du payload (pour servir les images depuis /cms/api/media/file/). */
  payloadPublicUrl?: string;
}

const { sections, payloadPublicUrl } = Astro.props;
const list = sections ?? [];

function imageUrl(field: Block['image']): string | null {
  if (!field || typeof field !== 'object') return null;
  if (!field.filename) return null;
  const base = (payloadPublicUrl ?? import.meta.env.PUBLIC_PAYLOAD_URL ?? '').replace(/\/$/, '');
  return `${base}/cms/api/media/file/${encodeURIComponent(field.filename)}`;
}
---

{list.map((block) => {
  switch (block.blockType) {
    case 'prose':
      return (
        <section class="block-prose">
          {block.titre && <h2>{block.titre}</h2>}
          {block.content && (
            <div class="prose-body" set:html={renderLexical(block.content)} />
          )}
        </section>
      );

    // Dépliant — `<details>` natif plutôt qu'un accordéon en script :
    // il s'ouvre sans JavaScript, le clavier et les lecteurs d'écran le
    // connaissent, et Ctrl+F déplie tout seul le contenu qu'il y
    // trouve. Le corps réutilise `.prose-body` : une fois ouvert, on y
    // lit le même texte qu'ailleurs sur la page.
    case 'depliant':
      return (
        <details class="block-depliant" open={block.ouvert === true}>
          <summary>
            <span class="titre">{block.titre}</span>
            <span class="chevron" aria-hidden="true"></span>
          </summary>
          {block.content && (
            <div class="prose-body" set:html={renderLexical(block.content)} />
          )}
        </details>
      );

    case 'figure': {
      const url = imageUrl(block.image);
      if (!url) return null;
      const alignClass = `align-${block.align ?? 'left'}`;
      return (
        <figure class:list={['block-figure', alignClass]}>
          <img
            src={url}
            alt={(typeof block.image === 'object' && block.image?.alt) || ''}
            loading="lazy"
          />
          {(block.legende || block.credit) && (
            <figcaption>
              {block.legende && <span class="legende">{block.legende}</span>}
              {block.credit && <span class="credit">{block.credit}</span>}
            </figcaption>
          )}
        </figure>
      );
    }

    case 'citation_bloc':
      return (
        <section class="block-citation-bloc">
          <blockquote>
            <p>{block.text}</p>
            {block.source && <cite>— {block.source}</cite>}
          </blockquote>
        </section>
      );

    default:
      console.warn('[PageRenderer] unknown blockType:', block.blockType);
      return null;
  }
})}

<style>
  /* Les blocs prose s'étendent sur toute la largeur utile de la page
     éditoriale (920px max — même colonne que le corps des billets
     sans sommaire). Avant : 720, créait un décalage visuel avec le
     hero qui lui s'étend plus large. */
  .block-prose {
    margin: 0 0 32px;
    max-width: 920px;
  }
  /* Titre de section — un vrai titre, pas une étiquette.
     Il était en sans 12 px capitales, soit un tiers plus PETIT que le
     texte qu'il annonce (18 px) : sur une page dont les paragraphes
     commencent par des mots en gras, il passait pour une mention
     secondaire et disparaissait. Un titre doit se voir avant ce qu'il
     titre. */
  .block-prose h2 {
    font-family: var(--font-serif);
    font-size: calc(26px * var(--a11y-echelle));
    font-weight: var(--w-heading);
    line-height: var(--lh-heading);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0 0 18px;
  }
  /* Les sections s'enchaînent : celles qui suivent la première ont
     besoin d'air au-dessus, sinon leur titre colle au paragraphe
     précédent et la coupure ne se lit plus. */
  .block-prose + .block-prose h2 {
    margin-top: 12px;
  }
  .block-prose .prose-body,
  .block-depliant .prose-body {
    font-family: var(--font-serif);
    font-size: calc(18px * var(--a11y-echelle));
    line-height: 1.65;
    color: var(--color-body);
  }
  .block-prose .prose-body :global(p),
  .block-prose .prose-body :global(li),
  .block-depliant .prose-body :global(p),
  .block-depliant .prose-body :global(li) {
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .block-prose .prose-body :global(p),
  .block-depliant .prose-body :global(p) {
    margin: 0 0 16px;
    max-width: 920px;
  }
  /* Tout lien de prose se voit, interne comme externe. Seul `a.ext`
     était stylé : un lien vers une autre page du site ne se
     distinguait donc en rien du texte courant — invisible, donc
     inexistant pour qui lit. C'est ce qui a fait passer le renvoi vers
     la charte pour un oubli. */
  .block-prose .prose-body :global(a.ext),
  .block-prose .prose-body :global(a.int),
  .block-depliant .prose-body :global(a.ext),
  .block-depliant .prose-body :global(a.int) {
    border-bottom: 1px solid var(--color-accent);
    color: inherit;
    transition: background-color 0.12s;
  }
  .block-prose .prose-body :global(a.ext:hover),
  .block-prose .prose-body :global(a.int:hover),
  .block-depliant .prose-body :global(a.ext:hover),
  .block-depliant .prose-body :global(a.int:hover) {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  /* ── Dépliant ──────────────────────────────────────────────────────
     Un encadré qui se distingue du texte courant sans crier : filet
     complet et fond très légèrement teinté, pour qu'on le lise comme
     un objet à part et non comme un paragraphe de plus.

     La ligne cliquable couvre toute la largeur du bloc — une cible de
     la taille de l'encadré, pas du seul mot. */
  .block-depliant {
    max-width: 920px;
    margin: 0 0 32px;
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-bg));
  }
  .block-depliant > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: calc(20px * var(--a11y-echelle));
    line-height: var(--lh-heading);
    color: var(--color-ink);
    /* Le triangle par défaut du navigateur cède la place au chevron
       ci-dessous, qui suit la typographie de la page. */
    list-style: none;
  }
  .block-depliant > summary::-webkit-details-marker {
    display: none;
  }
  .block-depliant > summary:focus-visible {
    outline: 2px solid var(--c-vert-deep);
    outline-offset: -2px;
  }
  .block-depliant > summary:hover .titre {
    color: var(--color-accent);
  }
  /* Chevron dessiné en bordures : rien à charger, et il suit la
     couleur du texte — donc le thème sombre comme le contraste
     renforcé du panneau d'accessibilité. */
  .block-depliant .chevron {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border-right: 1.5px solid var(--color-muted);
    border-bottom: 1.5px solid var(--color-muted);
    transform: rotate(45deg);
    transition: transform 0.16s ease;
    margin-bottom: 4px;
  }
  .block-depliant[open] .chevron {
    transform: rotate(-135deg);
    margin-bottom: 0;
    margin-top: 4px;
  }
  .block-depliant .prose-body {
    padding: 0 22px 6px;
  }
  .block-depliant .prose-body :global(p:last-child),
  .block-depliant .prose-body :global(ul:last-child) {
    margin-bottom: 16px;
  }

  .block-figure {
    margin: 32px 0;
  }
  .block-figure.align-center {
    text-align: center;
  }
  .block-figure.align-wide {
    max-width: 920px;
    margin-left: -100px;
    margin-right: -100px;
  }
  .block-figure img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .block-figure figcaption {
    font-family: var(--font-sans);
    font-size: calc(12.5px * var(--a11y-echelle));
    line-height: 1.55;
    color: var(--color-muted);
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .block-figure figcaption .credit {
    font-size: calc(11px * var(--a11y-echelle));
    color: var(--color-muted);
  }

  .block-citation-bloc {
    margin: 36px 0;
  }
  .block-citation-bloc blockquote {
    font-size: calc(22px * var(--a11y-echelle));
    line-height: 1.5;
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
    padding: 0 0 0 22px;
    border-left: 2px solid var(--color-accent);
  }
  .block-citation-bloc cite {
    display: block;
    margin-top: 12px;
    font-style: normal;
    font-family: var(--font-sans);
    font-size: calc(13px * var(--a11y-echelle));
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .block-figure.align-wide {
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
