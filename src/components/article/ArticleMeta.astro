---
/**
 * Ligne Auteur·ice / Thème / Publié, juste sous le deck.
 *
 * Ni format ni durée de lecture ici : le premier est déjà en surtitre en
 * haut de la page, avec le même mot et le même pictogramme ; la seconde
 * vit au-dessus du sommaire (ArticleToc). Un bandeau de métadonnées ne
 * vaut que par ce qu'il apprend — répéter ce qui est écrit dix
 * centimètres plus haut le fait lire comme du remplissage.
 */
import type { PublicationTheme } from '../../lib/publications';
import type { DisplayAuthor } from '../../lib/site';

interface Props {
  authors: DisplayAuthor[];
  publishedFr: string;
  publishedIso: string;
  /**
   * Toutes les thématiques du billet, et non la seule première : un
   * billet peut en porter plusieurs, et n'en montrer qu'une revenait à
   * jeter le reste sans que rien ne le signale.
   */
  themes: PublicationTheme[];
  /**
   * Affiche la colonne « Publié ». Fausse quand la date vit dans
   * l'aside — c'est la page qui tranche, elle seule sait si cet aside
   * est monté (cf PublicationArticle, dateDansAside).
   */
  showPublished?: boolean;
}

const {
  authors,
  publishedFr,
  publishedIso,
  themes,
  showPublished = true,
} = Astro.props;
---

<div class="meta-strip">
  <div>
    <div class="lbl">Auteur·ice</div>
    {authors.length === 0 ? (
      '—'
    ) : (
      authors.map((a, i) => (
        <Fragment>
          {i > 0 && (i === authors.length - 1 ? ' et ' : ', ')}
          {a.href ? <a href={a.href}>{a.name}</a> : a.name}
        </Fragment>
      ))
    )}
  </div>
  <div>
    {/* Libellé accordé au nombre : « Thèmes » au pluriel devant une
        valeur unique se lit comme une liste tronquée. */}
    <div class="lbl">{themes.length > 1 ? 'Thèmes' : 'Thème'}</div>
    {/* Séparateur et lien tenus sur une seule ligne : à la ligne, le
        retour se rend en espace et la virgule se détachait du nom qui la
        précède (« Genre et RI , Genre et politiques »). */}
    {themes.length === 0 ? (
      '—'
    ) : (
      themes.map((t, i) => (
        <Fragment>{i > 0 && ', '}<a href={`/theme/${t.slug}/`}>{t.name}</a></Fragment>
      ))
    )}
  </div>
  {showPublished && (
    <div>
      <div class="lbl">Publié</div>
      <time datetime={publishedIso}>{publishedFr}</time>
    </div>
  )}
</div>

<style>
  /* Colonnes calées sur leur contenu, et non en fractions égales : le
     bandeau ne porte plus que deux ou trois valeurs selon le format, et
     des colonnes de largeur fixe laissaient un tiers vide qu'on lisait
     comme une donnée manquante. Au contenu, deux valeurs font une ligne,
     trois aussi — la composition ne dépend plus du nombre.
     `wrap` pour les cas où une signature à quatre noms et trois
     thématiques ne tiennent plus sur une ligne : le groupe passe en
     dessous entier, jamais coupé en son milieu. */
  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    /* Écart horizontal large : c'est lui qui sépare deux groupes
       étiquetés, là où la grille s'en remettait aux colonnes. */
    gap: 20px 56px;
    padding: 20px 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-muted);
    margin-bottom: 48px;
  }
  /* --color-accent brut est presque aussi sombre que l'encre (calibré
     pour du texte de contenu, pas pour un petit label 11px) — les deux
     se confondaient à cette taille. Éclairci pour se distinguer de
     l'encre, mais pas trop dilué non plus : à 60 % ça tournait au gris,
     plus assez saturé pour vraiment se lire comme une couleur. */
  .meta-strip .lbl {
    color: color-mix(in srgb, var(--color-accent) 85%, white);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  /* Les valeurs restent en gris neutre, y compris les liens — seuls
     les libellés (ci-dessus) portent la couleur. Le survol reste le
     seul indice visuel qu'une valeur est cliquable. */
  .meta-strip a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.12s, border-color 0.12s;
  }
  .meta-strip a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  @media (max-width: 900px) {
    /* L'écart se resserre : à cette largeur, 56 px entre deux groupes
       enverraient le second à la ligne alors qu'il tenait. */
    .meta-strip {
      gap: 18px 32px;
    }
  }
</style>
