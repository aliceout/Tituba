---
/**
 * Ligne Auteur·ice / Thème / Publié, juste sous le deck.
 *
 * Ni format ni durée de lecture ici : le premier est déjà en surtitre en
 * haut de la page, avec le même mot et le même pictogramme ; la seconde
 * vit au-dessus du sommaire (ArticleToc). Un bandeau de métadonnées ne
 * vaut que par ce qu'il apprend — répéter ce qui est écrit dix
 * centimètres plus haut le fait lire comme du remplissage.
 */
import type { PublicationTheme } from '../../lib/publications';
import type { DisplayAuthor } from '../../lib/site';

interface Props {
  authors: DisplayAuthor[];
  publishedFr: string;
  publishedIso: string;
  /**
   * Toutes les thématiques du billet, et non la seule première : un
   * billet peut en porter plusieurs, et n'en montrer qu'une revenait à
   * jeter le reste sans que rien ne le signale.
   */
  themes: PublicationTheme[];
  /**
   * Affiche la colonne « Publié ». Fausse quand la date vit dans
   * l'aside — c'est la page qui tranche, elle seule sait si cet aside
   * est monté (cf PublicationArticle, dateDansAside).
   */
  showPublished?: boolean;
}

const {
  authors,
  publishedFr,
  publishedIso,
  themes,
  showPublished = true,
} = Astro.props;
---

{/* Colonnes calées sur leur contenu, et non en fractions égales : le
    bandeau ne porte que deux ou trois valeurs selon le format, et des
    colonnes de largeur fixe laissaient un tiers vide qu’on lisait comme
    une donnée manquante.

    L’écart horizontal large sépare deux groupes étiquetés, là où la
    grille s’en remettait aux colonnes ; il se resserre sous 900 px, où
    56 px enverraient le second groupe à la ligne alors qu’il tenait.

    Le libellé porte la couleur de marque éclaircie : brute, elle est
    presque aussi sombre que l’encre — calibrée pour du texte courant,
    pas pour un mot de onze pixels. */}
<div
  class="border-rule text-muted mb-12 flex flex-wrap gap-x-14 gap-y-5 border-t border-b py-5 font-sans text-meta max-mobile:gap-x-8 max-mobile:gap-y-[18px]"
>
  <div>
    <div class="text-[color-mix(in_srgb,var(--color-accent)_85%,white)] mb-1 font-semibold text-label tracking-[0.08em] uppercase">Auteur·ice</div>
    {authors.length === 0 ? (
      '—'
    ) : (
      authors.map((a, i) => (
        <Fragment>
          {i > 0 && (i === authors.length - 1 ? ' et ' : ', ')}
          {a.href ? <a href={a.href} class="text-inherit no-underline border-b border-transparent hover:text-ink hover:border-b-ink transition-colors duration-100">{a.name}</a> : a.name}
        </Fragment>
      ))
    )}
  </div>
  <div>
    {/* Libellé accordé au nombre : « Thèmes » au pluriel devant une
        valeur unique se lit comme une liste tronquée. */}
    <div class="text-[color-mix(in_srgb,var(--color-accent)_85%,white)] mb-1 font-semibold text-label tracking-[0.08em] uppercase">{themes.length > 1 ? 'Thèmes' : 'Thème'}</div>
    {/* Séparateur et lien tenus sur une seule ligne : à la ligne, le
        retour se rend en espace et la virgule se détachait du nom qui la
        précède (« Genre et RI , Genre et politiques »). */}
    {themes.length === 0 ? (
      '—'
    ) : (
      themes.map((t, i) => (
        <Fragment>{i > 0 && ', '}<a href={`/theme/${t.slug}/`} class="text-inherit no-underline border-b border-transparent hover:text-ink hover:border-b-ink transition-colors duration-100">{t.name}</a></Fragment>
      ))
    )}
  </div>
  {showPublished && (
    <div>
      <div class="text-[color-mix(in_srgb,var(--color-accent)_85%,white)] mb-1 font-semibold text-label tracking-[0.08em] uppercase">Publié</div>
      <time datetime={publishedIso}>{publishedFr}</time>
    </div>
  )}
</div>
