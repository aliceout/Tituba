---
/**
 * Sommaire de la page de lecture — visible seulement au-delà de
 * 1300 px, en seconde colonne de la grille posée par PublicationArticle
 * (`.article-shell`). `position: sticky` plutôt que `fixed` : la
 * colonne est stretchée à la hauteur de l'article par la grille, donc
 * le sommaire peut « suivre » le défilement sans qu'on ait à recaler
 * sa position à la main — c'est la grille qui aligne les deux colonnes
 * en haut, pas un calcul de pixels dupliqué ici et côté article.
 * Scroll-spy par position plutôt que par IntersectionObserver : #intro
 * contient tous les h2/h3, un observer y gagnait en permanence.
 *
 * Porte aussi : la durée de lecture (qui vivait avant dans ArticleMeta)
 * au-dessus du sommaire — repère rapide, avant de naviguer — puis les
 * actions rapides en dessous (copier le lien, citer, télécharger en
 * PDF — non câblées pour l'instant, juste posées), en bloc secondaire
 * après la navigation plutôt qu'avant.
 */
interface TocEntry {
  id: string;
  level: number;
  text: string;
}

interface Props {
  entries: TocEntry[];
  readingLabel: { label: string; value: string } | null;
  hasFootnotes: boolean;
  hasBiblio: boolean;
  hasCitation: boolean;
  /** Épisode à télécharger — podcasts seulement. */
  audioSrc?: string | null;
  /** Titre de l'épisode, pour nommer le fichier téléchargé. */
  audioTitle?: string;
  /** Date de publication — seulement quand la page ne rend pas le
   *  bandeau de métadonnées, qui la porte déjà. */
  publishedFr?: string | null;
  publishedIso?: string;
}

const {
  entries,
  readingLabel,
  hasFootnotes,
  hasBiblio,
  hasCitation,
  audioSrc,
  audioTitle,
  publishedFr,
  publishedIso,
} = Astro.props;

// Nom de fichier proposé au téléchargement — le nom stocké est un
// identifiant d'export sans intérêt pour qui l'enregistre.
/**
 * Rien ne se rend entre les repères chiffrés et les actions : ni
 * sommaire, ni notes, ni bibliographie, ni bloc de citation. Or le
 * premier ferme par un filet et les secondes en ouvrent un — collés,
 * les deux traits se lisent comme une bordure double. On en retire un.
 */
const sansIntercalaire = entries.length === 0 && !hasFootnotes && !hasBiblio && !hasCitation;

const nomAudio = `${(audioTitle ?? 'episode')
  .replace(/[\\/:*?"<>|]+/g, '-')
  .slice(0, 80)
  .trim()}.mp3`;
/**
 * Micro-label du bloc — « SOMMAIRE », « LECTURE : … », « PUBLIÉ : … ».
 * Les repères chiffrés et l'intitulé du sommaire sont au même niveau
 * hiérarchique : ce sont des étiquettes, pas du texte courant.
 */
const LABEL =
  'text-ink text-[calc(10px*var(--a11y-echelle))] font-semibold tracking-[0.12em] uppercase';

/**
 * Un lien de section. La section en cours se signale par
 * `aria-current="location"`, posé par le script : un attribut plutôt
 * qu'une classe, puisque Tailwind ne génère que les classes qu'il lit
 * dans les sources — et le lecteur d'écran y gagne, la section courante
 * n'étant jusqu'ici marquée que par une couleur et un filet.
 */
const LIEN = [
  'text-muted -ml-2.5 block border-l-2 border-transparent py-1 pl-2.5',
  'transition-[color,border-left-color] duration-[120ms]',
  'aria-[current=location]:text-ink aria-[current=location]:border-l-accent',
].join(' ');

/**
 * Un geste rapide du pied de bloc. Les <a> n'y reprennent PAS `LIEN` :
 * son retrait et sa bordure gauche servent au repère de section active,
 * et les recopier ici décalerait le pictogramme d'une colonne par
 * rapport aux <button> voisins.
 */
const ACTION = [
  'text-muted flex w-full cursor-pointer items-center gap-2 border-none bg-transparent px-0.5 py-[5px]',
  'text-left font-sans text-meta transition-colors duration-[120ms]',
  'hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
  '[&_svg]:shrink-0',
].join(' ');
---

{
  /* Pas de condition d'affichage ici : c'est PublicationArticle qui
    décide de monter ou non ce composant, et qui pose `no-toc` sur la
    grille en conséquence. Deux conditions séparées finiraient par
    diverger — une colonne réservée sans rien dedans, ou l'inverse. */
}
{
  /* La position horizontale (colonne 2) et la hauteur du bloc viennent de
    la grille du parent — rien à calculer ici.

    Le `top` du collage est calé sur sa position naturelle au chargement
    (header ~76 px + retrait haut de main 32 px + retrait de la coquille
    d'article 75 px ≈ 183 px), et pas sur une valeur plus petite : avec un
    seuil plus bas, le sommaire défilerait normalement sur la distance qui
    sépare les deux, ce qui se voit comme un bloc qui « rattrape » sa
    position avant de se figer. Calé sur son point de départ, il ne semble
    jamais bouger.

    Sous 1300 px la colonne n'existe plus et le bloc disparaît. */
}
{
  /* La classe `toc` ne porte plus rien : elle reste comme crochet. Le
    scrollspy y cherche ses liens, et PublicationArticle s’en sert pour
    décoller le bloc quand il le pose dans la colonne d’un billet
    d’actu. La retirer avait éteint le repère de section — silencieusement,
    puisque rien ne casse quand un sélecteur ne trouve personne. */
}
<aside
  class="toc text-muted text-meta max-large:hidden sticky top-[183px] z-4 font-sans leading-[1.5]"
  id="toc"
  aria-label="Sommaire"
>
  {
    /* Repères chiffrés en tête d'aside : combien de temps ça prend, et
        de quand ça date. La date n'est passée que par les pages dont le
        hero porte déjà les autres métadonnées et qui ne rendent donc pas
        le bandeau — sur les autres, elle y figure et la redire ici
        ferait doublon. */
  }
  {
    /* Hauteur et respiration communes avec le générique de la colonne de
        texte, pour que les deux filets tombent sur la même ligne. La valeur
        vit dans PublicationArticle (`--repere-h`), qui porte les deux
        colonnes ; le repli couvre le cas où ce bloc servirait un jour hors
        de cet article. Le `min-height` compte aussi : sans lui, une page
        qui n'affiche pas « Publié » n'aurait qu'une ligne, et le calage
        sauterait.

        L'interligne est épinglé plutôt qu'hérité : `--repere-h` est calculé
        à partir de lui, et une valeur héritée peut changer sans que le
        calcul en face le sache. La hauteur mesurée tombait à 66,67 px pour
        66 attendus — deux tiers de pixel, invisibles à l'œil mais assez
        pour que les deux filets ne coïncident jamais tout à fait.

        18 px de part et d'autre du filet, comme partout ailleurs dans cet
        aside : un trait qui sépare deux blocs n'a pas de raison d'avoir
        plus d'air d'un côté que de l'autre. */
  }
  {
    (readingLabel || publishedFr) && (
      <div
        class:list={[
          LABEL,
          'border-rule mb-[18px] min-h-[var(--repere-h,auto)] border-b pb-[var(--repere-pad,18px)] leading-[1.5]',
        ]}
      >
        {readingLabel && (
          <div>
            <span>{readingLabel.label} : </span>
            <span class="font-normal">{readingLabel.value}</span>
          </div>
        )}
        {/* Même écart que celui qui sépare les blocs de l'aside, sans le
            filet : les deux lignes portent sur le même objet, elles n'ont
            pas à être séparées comme deux sections. */}
        {publishedFr && (
          <div class="mt-[18px]">
            <span>Publié : </span>
            <time class="font-normal" datetime={publishedIso}>
              {publishedFr}
            </time>
          </div>
        )}
      </div>
    )
  }

  {
    /* Le sommaire proprement dit n'a de sens qu'avec des titres de
        section. Sans eux — cas courant d'un billet d'analyse court — le
        reste de l'aside (durée, liens de pied, actions) garde tout son
        intérêt. */
  }
  {
    entries.length > 0 && (
      <>
        <div class:list={[LABEL, 'mb-2.5']}>Sommaire</div>
        <a href="#intro" class={LIEN} data-toc="intro" aria-current="location">
          Introduction
        </a>
        {entries.map((entry) => (
          <a
            href={`#${entry.id}`}
            data-toc={entry.id}
            class:list={[LIEN, entry.level === 3 && 'pl-[22px]']}
          >
            {entry.text}
          </a>
        ))}
      </>
    )
  }
  {
    hasFootnotes && (
      <a href="#notes" data-toc="notes" class={LIEN}>
        Notes
      </a>
    )
  }
  {
    hasBiblio && (
      <a href="#biblio" data-toc="biblio" class={LIEN}>
        Bibliographie
      </a>
    )
  }
  {
    hasCitation && (
      <a href="#cite" data-toc="cite" class={LIEN}>
        Pour citer
      </a>
    )
  }

  {
    /* Actions rapides — non câblées : le design est posé, le clic ne fait
        rien pour l'instant. En bas de bloc plutôt qu'en haut : ce sont des
        gestes secondaires (copier, citer, télécharger), qui viennent après
        s'être repéré et avoir navigué, pas avant.

        Sans intercalaire, le filet des repères tient lieu de séparation à
        lui seul ; l'écart, lui, reste porté par leur marge basse. */
  }
  <div
    class:list={[
      'flex flex-col gap-0.5',
      sansIntercalaire ? 'mt-0 pt-0' : 'border-rule mt-[18px] border-t pt-3.5',
    ]}
  >
    <button type="button" class={ACTION} aria-label="Copier le lien de l'article">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="9" y="9" width="12" height="12" rx="2"></rect>
        <path d="M5.5 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v0.5"></path>
      </svg>
      Copier le lien
    </button>
    <button type="button" class={ACTION} aria-label="Copier la citation de l'article">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 8.5c-2 0-3.2 1.4-3.2 3.4S5 15.2 7 15.2c0 2-1.2 2.8-3 2.8"></path>
        <path d="M16.2 8.5c-2 0-3.2 1.4-3.2 3.4s1.2 3.3 3.2 3.3c0 2-1.2 2.8-3 2.8"></path>
      </svg>
      Citer cet article
    </button>
    {
      /* Les deux téléchargements se suivent : ce sont les seuls gestes
          du bloc qui font descendre un fichier, et les séparer par
          « copier » ou « citer » obligeait à les rechercher l'un après
          l'autre. L'épisode d'abord — c'est le contenu même de la
          publication, le PDF n'en est qu'une mise en forme.
          Seul de ce bloc à être réellement câblé pour l'instant, d'où le
          <a> là où les autres sont des <button>. */
    }
    {
      audioSrc && (
        <a class={ACTION} href={audioSrc} download={nomAudio}>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3v11" />
            <path d="m7.5 10 4.5 4.5 4.5-4.5" />
            <path d="M4.5 19.5h15" />
          </svg>
          Télécharger l'épisode
        </a>
      )
    }
    <button type="button" class={ACTION} aria-label="Télécharger l'article en PDF">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3v11"></path>
        <path d="m7.5 10 4.5 4.5 4.5-4.5"></path>
        <path d="M4.5 19.5h15"></path>
      </svg>
      Télécharger en PDF
    </button>
  </div>

  {
    /* Même répartition à deux niveaux que les actions juste au-dessus :
        le filet et les écarts portés par le conteneur, le retrait interne
        par le lien — pas un seul bloc qui rejoue approximativement le même
        total en une règle. */
  }
  <div class="border-rule mt-[18px] border-t pt-[18px]">
    {
      /* Le scrollspy finit par désigner ce lien — `#haut` est en tête de
          document, donc « la dernière section dépassée » une fois qu’on est
          descendu assez loin. Il passe alors à l’encre, comme n’importe
          quelle entrée courante ; le filet, lui, n’existe pas ici. */
    }
    <a href="#haut" data-toc="haut" class:list={[ACTION, 'aria-[current=location]:text-ink']}>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5"></path>
        <path d="m5 12 7-7 7 7"></path>
      </svg>
      Haut de page
    </a>
  </div>
</aside>

<script>
  // Scrollspy basé sur la position : on prend la dernière section dont
  // le haut a dépassé la ligne 1/3 du viewport (cohérent avec
  // `scroll-margin-top: 33vh` posé sur les cibles d'ancre). Évite le bug
  // où #intro (qui contient tous les h2/h3) gagnait en permanence avec
  // IntersectionObserver.
  //
  // Sur `astro:page-load` et non au chargement du module : avec le
  // ClientRouter, un module ne s'exécute qu'une fois par URL, si bien
  // qu'après une navigation le sommaire de la nouvelle page resterait
  // inerte. Cet évènement se déclenche au premier chargement *et* après
  // chaque échange de document.
  document.addEventListener('astro:page-load', () => {
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]'),
    );
    if (!tocLinks.length) return;

    // Les écouteurs de défilement portent sur `window`, qui survit à la
    // navigation : sans révocation il s'en empilerait un par page
    // visitée, chacun cherchant des sections détruites depuis
    // longtemps. Le signal les coupe à l'échange de document.
    const ac = new AbortController();
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    const ids = tocLinks.map((a) => a.dataset.toc).filter((id): id is string => !!id);
    const sections = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    function setActive(id: string) {
      for (const a of tocLinks) {
        // Un attribut et non une classe : la mise en forme est en
        // utilitaires Tailwind, qui ne génère que les classes lues dans
        // les sources. `location` et non `page` : c'est un endroit dans
        // le document, pas une page dans un site.
        if (a.dataset.toc === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    }

    if (sections.length > 0) {
      let raf = 0;
      const updateActive = () => {
        raf = 0;
        const line = window.innerHeight * 0.33;
        let activeId = sections[0].id;
        for (const sec of sections) {
          if (sec.getBoundingClientRect().top <= line) activeId = sec.id;
          else break;
        }
        setActive(activeId);
      };
      const onScroll = () => {
        if (raf) return;
        raf = requestAnimationFrame(updateActive);
      };
      window.addEventListener('scroll', onScroll, { passive: true, signal: ac.signal });
      window.addEventListener('resize', onScroll, { passive: true, signal: ac.signal });
      updateActive();
    }

    // Smooth scroll au clic
    for (const a of tocLinks) {
      a.addEventListener('click', (e) => {
        const id = a.dataset.toc;
        if (!id) return;
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '#' + id);
        }
      });
    }
  });
</script>
