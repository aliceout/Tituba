---
/** Tags discrets en pied de billet — mono muted, plus discrets que les
 *  chips de thèmes en couleur accent. Hover = accent. */
import type { PublicationTag } from '../../lib/publications';

interface Props {
  tags: PublicationTag[];
}

const { tags } = Astro.props;
---

<section class="post-tags" aria-label="Tags">
  {tags.map((t) => (
    <a class="post-tag" href={`/tag/${t.slug}/`}>
      #{t.slug}
    </a>
  ))}
</section>

<style>
  .post-tags {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .post-tag {
    font-family: var(--font-mono);
    font-size: calc(12px * var(--a11y-echelle));
    color: var(--color-muted);
    text-decoration: none;
    padding: 2px 6px;
    border: 1px solid var(--color-rule);
    transition: color 0.12s, border-color 0.12s;
  }
  .post-tag:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
