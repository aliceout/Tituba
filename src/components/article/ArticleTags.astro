---
/** Tags discrets en pied de billet — mono muted, plus discrets que les
 *  chips de thèmes en couleur accent. Hover = accent. */
import type { PublicationTag } from '../../lib/publications';

interface Props {
  tags: PublicationTag[];
}

const { tags } = Astro.props;
---

<section class="mt-8 flex flex-wrap gap-2" aria-label="Tags">
  {
    tags.map((t) => (
      <a
        class="border-rule text-muted hover:text-accent hover:border-accent text-meta border px-1.5 py-0.5 font-mono no-underline transition-colors duration-100"
        href={`/tag/${t.slug}/`}
      >
        #{t.slug}
      </a>
    ))
  }
</section>
