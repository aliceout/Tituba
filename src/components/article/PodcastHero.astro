---
/**
 * Hero d'épisode pleine largeur — essai sur le parti d'ARTE Radio.
 *
 * Deux images superposées : celle de l'émission en fond, débordant la
 * colonne de texte jusqu'aux bords de la fenêtre, floutée et assombrie ;
 * celle de l'épisode par-dessus, nette et carrée, à gauche du titre. On
 * reconnaît ainsi l'émission avant d'avoir lu le titre, et l'épisode se
 * distingue à l'intérieur d'elle.
 *
 * Un épisode sans émission — ou dont l'émission n'a pas d'image —
 * retombe sur sa propre couverture pour les deux rôles : c'est ce que
 * faisait le hero avant l'existence des séries, et ça vaut mieux qu'un
 * fond vide.
 *
 * Le flou n'est pas décoratif : une photo nette sous du texte le rend
 * illisible dès qu'elle porte du détail, et aucun voile assez léger pour
 * laisser voir l'image ne suffit à garantir le contraste. Flouter règle
 * les deux — l'image reste reconnaissable comme ambiance, le texte
 * repasse sur un aplat.
 *
 * Composant à part et non variante de PublicationArticle : c'est un
 * essai, et il doit pouvoir être retiré d'une ligne.
 */
import type { DisplayAuthor } from '../../lib/site';

import type { PublicationCollection } from '../../lib/publications';

import FormatIcon from '../FormatIcon.astro';
import PodcastLaunch from './PodcastLaunch.astro';

export interface Props {
  /** Titre, HTML autorisé (astérisques déjà converties). */
  titleHtml: string;
  /** Titre en texte brut — nom du fichier téléchargé, libellés. */
  titlePlain: string;
  lede: string;
  coverUrl: string;
  coverAlt?: string;
  /**
   * Fond du hero — l'image de l'émission. Le carré au premier plan reste
   * celui de l'épisode : on reconnaît l'émission avant d'avoir lu le
   * titre, et l'épisode se distingue à l'intérieur d'elle.
   *
   * Absent, on retombe sur la couverture de l'épisode, qui sert alors
   * les deux rôles. C'est le comportement d'avant les séries, et il vaut
   * mieux qu'un hero sans fond.
   */
  backgroundUrl?: string | null;
  /** Nom de l'émission, si le billet en a une. */
  serieName?: string | null;
  serieSlug?: string | null;
  /** Intitulé du format, en surtitre. */
  formatLabel: string;
  /** Collection du billet — pilote le pictogramme du surtitre. */
  collection: PublicationCollection;
  audioSrc?: string | null;
  durationSeconds?: number | null;
  href: string;
  credit?: { name: string; profileUrl: string | null; unsplashUrl: string } | null;
  /** Signature — interne = lien vers la page auteur·ice, externe = texte. */
  authors?: DisplayAuthor[];
  themeName?: string | null;
  themeSlug?: string | null;
}

const {
  titleHtml,
  titlePlain,
  lede,
  coverUrl,
  coverAlt = '',
  backgroundUrl = null,
  serieName = null,
  serieSlug = null,
  formatLabel,
  collection,
  audioSrc,
  durationSeconds,
  href,
  credit,
  authors,
  themeName,
  themeSlug,
} = Astro.props as Props;

// Le fond retombe sur la couverture de l'épisode si l'émission n'a pas
// d'image — ou si l'épisode n'appartient à aucune émission.
const fondUrl = backgroundUrl || coverUrl;
---

{/* Pleine largeur : la section sort de la gouttière et de la largeur
    maximale de <main> en tirant ses marges jusqu'aux bords de la fenêtre.
    `overflow-x: clip` est posé sur <main> (cf Layout) — et non `hidden`,
    qui ferait de lui un conteneur de défilement et casserait le collage
    de l'aside.

    La marge haute négative annule l'écart que <main> ménage entre le
    header et le premier bloc : une image pleine largeur ne se pose pas
    SOUS le header, elle vient s'y appuyer — un liseré de fond clair entre
    les deux la ferait lire comme une illustration flottante.

    Le rognage, lui, tient au fond : le flou déborde de ses bords. */}
<section
  class="relative mb-10 overflow-hidden mx-[calc(50%-50vw)] mt-[calc(-1*var(--page-pad-top))] px-[calc(50vw-50%)]"
>
  {/* Fond porté par un élément à part et non par la section : le flou
      d'un `filter` s'appliquerait à tout ce qu'elle contient, texte
      compris.

      Débordement volontaire de 60 px : un flou appliqué jusqu'au bord
      délave celui-ci et laisse un halo clair. On floute au-delà, on
      rogne.

      Assez flou pour ne pas concurrencer le texte, assez clair pour qu'on
      reconnaisse l'image de l'émission. Le réglage d'origine — 38 px de
      flou et 42 % de luminosité, sous un voile allant jusqu'à 42 % de
      noir — ramenait la zone à une moyenne de 47/255 : plus un fond
      sombre qu'une photo, et on ne distinguait plus quelle image était
      là. À 10 px, l'horizon, le dégradé de ciel et la matière de l'eau
      restent identifiables. C'est le plancher raisonnable sans
      contrepartie : en dessous, le détail passe sous le chapô.

      Le voile est dégradé plutôt qu'uniforme : la partie basse porte le
      bouton et le crédit, qui demandent plus de contraste que le haut.
      Allégé d'autant que le filtre — les deux se cumulaient. */}
  <div
    class="absolute -inset-[60px] bg-cover bg-center blur-[10px] brightness-[0.66] saturate-[1.15] after:absolute after:inset-0 after:bg-[linear-gradient(180deg,rgb(0_0_0/0.1),rgb(0_0_0/0.3))] after:content-['']"
    style={`background-image:url(${fondUrl})`}
    aria-hidden="true"
  >
  </div>

  {/* Alignés par le haut : c'est le titre qui doit partir à la même
      hauteur que la photo, le surtitre débordant au-dessus. Sous 900 px
      la photo passe au-dessus du texte. */}
  <div class="relative flex items-stretch gap-12 py-[72px] max-mobile:flex-col max-mobile:items-start max-mobile:gap-7 max-mobile:py-10">
    {/* Le crédit vit sous la photo qu'il crédite, en légende de la
        figure — dans la colonne de texte, il se lisait comme une note de
        l'épisode. Le carré est enveloppé d'un bloc à part : c'est lui qui
        porte le rognage et l'arrondi, et une légende posée dans le même
        bloc aurait été coupée avec eux.

        Calé en haut et non étiré : la colonne de texte fixe la hauteur de
        la rangée, et s'y accrocher transformait le carré en portrait dès
        que le chapô dépassait quelques lignes. Sans étirement, la figure
        fait la hauteur de son image — ce qui remet du même coup le crédit
        juste sous elle, ancré à `top: 100%`. */}
    <figure class="relative m-0 flex flex-[0_0_340px] self-start max-mobile:w-[min(280px,70%)] max-mobile:flex-[0_0_auto]">
      {/* Carré, quoi qu'il arrive : c'est la proportion d'une pochette, et
          c'est aussi ce qu'attendent les applications d'écoute.
          `object-cover` cadre à l'intérieur, sans jamais déformer. */}
      <div class="aspect-square w-full flex-none overflow-hidden rounded-xl shadow-[0_18px_40px_-18px_rgb(0_0_0/0.55)]">
        <img src={coverUrl} alt={coverAlt} class="block h-full w-full object-cover" />
      </div>
      {credit && (
        <figcaption class="absolute inset-x-0 top-full m-0 mt-3 font-sans text-label leading-[1.45] text-[rgb(255_255_255/0.55)] [&_a]:border-b [&_a]:border-dotted [&_a]:border-current [&_a]:text-inherit [&_a:hover]:text-white">
          Photo par{' '}
          {credit.profileUrl ? (
            <a href={credit.profileUrl} rel="noopener">{credit.name}</a>
          ) : (
            credit.name
          )}
          {' '}sur <a href={credit.unsplashUrl} rel="noopener">Unsplash</a>
        </figcaption>
      )}
    </figure>

    <div class="min-w-0 flex-auto text-white">
      {/* L'émission prolonge le surtitre plutôt que d'ouvrir une ligne à
          elle : « PODCAST · VOIX DE LA MER » se lit d'un trait, et c'est
          bien la même information — de quelle nature est ce billet, et
          d'où il vient.

          Le surtitre déborde au-dessus de la rangée : sa marge haute
          négative vaut exactement ce qu'il occupe — sa propre hauteur de
          ligne plus l'écart qui le sépare du titre. Le haut du titre
          tombe alors sur le haut de la photo, et le format reste seul
          au-dessus de cette ligne. Exprimée en `lh` plutôt qu'en pixels :
          le jour où le corps ou l'interligne du surtitre change, le calage
          suit au lieu de dériver de quelques pixels. */}
      <p class="mt-[calc(-1*(1lh+18px))] mb-[18px] flex items-center gap-[7px] font-mono text-label tracking-[0.16em] text-[rgb(255_255_255/0.72)] uppercase [&_a]:border-b [&_a]:border-[rgb(255_255_255/0.3)] [&_a]:text-inherit [&_a:hover]:border-b-white [&_a:hover]:text-white">
        <FormatIcon collection={collection} />{formatLabel}
        {serieName && serieSlug && (
          <>
            {/* Point médian en retrait : c'est une ponctuation entre deux
                valeurs, pas une troisième valeur. */}
            <span class="text-[rgb(255_255_255/0.4)]" aria-hidden="true">·</span>
            <a href={`/series/${serieSlug}/`}>{serieName}</a>
          </>
        )}
      </p>
      {/* Le surlignage au marqueur du titre ne tient pas sur un fond
          sombre : le trait pâle y disparaît. Les mots marqués — des <em>
          posés par formatHeroTitle, donc absents d'ici — passent en
          italique, seule accentuation qui garde sa force sur n'importe
          quel fond. */}
      <h1
        class="m-0 mb-5 font-serif text-display-long font-display leading-display tracking-display text-white [&_em]:bg-none [&_em]:text-inherit [&_em]:italic"
        set:html={titleHtml}
      />
      <p class="m-0 mb-3.5 max-w-[62ch] font-serif text-[calc(19px*var(--a11y-echelle))] leading-[1.5] whitespace-pre-line text-[rgb(255_255_255/0.86)]">
        {lede}
      </p>

      {/* Signature et thématique — remontées ici depuis le bandeau de
          métadonnées, qui n'est plus rendu sur un épisode. Sur deux lignes
          et non sur une : ce sont deux renseignements de nature différente
          — qui signe, et de quoi ça parle. Séparés d'un point médian, ils
          se lisaient comme une énumération d'un même ordre.

          Les valeurs absentes sont omises plutôt que remplacées par un
          tiret : un tiret sur fond sombre se lit comme une erreur. */}
      {((authors && authors.length > 0) || (themeName && themeSlug)) && (
        <p class="m-0 mb-3.5 flex flex-col items-start gap-[5px] font-sans text-[calc(15px*var(--a11y-echelle))] text-[rgb(255_255_255/0.8)] [&_a]:border-b [&_a]:border-[rgb(255_255_255/0.35)] [&_a]:text-inherit [&_a:hover]:border-b-white [&_a:hover]:text-white">
          {authors && authors.length > 0 && (
            <span>
              {authors.map((a, i) => (
                <Fragment>
                  {i > 0 && (i === authors.length - 1 ? ' et ' : ', ')}
                  {a.href ? <a href={a.href}>{a.name}</a> : a.name}
                </Fragment>
              ))}
            </span>
          )}
          {themeName && themeSlug && <a href={`/theme/${themeSlug}/`}>{themeName}</a>}
        </p>
      )}

      {audioSrc && (
        /* Le bouton hérite des couleurs de la page, pensées pour un fond
           clair : sur le fond sombre, son cerne et son libellé passent au
           blanc. On redéfinit les variables plutôt que les règles, ce qui
           évite d'avoir à connaître la structure interne du composant. */
        <div class="[&_.lancer]:[--color-ink:#fff] [&_.lancer]:[--color-rule:rgb(255_255_255/0.4)] [&_.lancer]:text-white">
          <PodcastLaunch
            src={audioSrc}
            durationSeconds={durationSeconds}
            title={titlePlain}
            coverUrl={coverUrl}
            href={href}
          />
        </div>
      )}
    </div>
  </div>
</section>
