---
/** Bloc « Dans le même thème » — publications liées en pied d'article. */
import { publicationHref, type PublicationCollection } from '../../lib/publications';
import { formatDateFr, stripHeroMarkers } from '../../lib/site';

interface Props {
  collection: PublicationCollection;
  items: Array<{ publicId: string; title: string; publishedAt: string }>;
}

const { collection, items } = Astro.props;
---

<section class="related">
  <h3>Dans le même thème</h3>
  <div class="grid">
    {items.map((r) => (
      <a href={publicationHref(collection, r.publicId)}>
        <div class="d">{formatDateFr(r.publishedAt)}</div>
        <div class="t">{stripHeroMarkers(r.title)}</div>
      </a>
    ))}
  </div>
</section>

<style>
  h3 {
    font-family: var(--font-sans);
    font-size: calc(13px * var(--a11y-echelle));
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin: 0 0 14px;
  }
  .related {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--color-rule);
  }
  .related .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .related a {
    padding: 14px 0;
    border-top: 1px solid var(--color-rule);
    display: block;
    color: var(--color-ink);
    transition: color 0.12s;
  }
  .related a:hover .t {
    color: var(--color-accent);
  }
  .related .d {
    font-family: var(--font-sans);
    font-size: calc(11px * var(--a11y-echelle));
    color: var(--color-muted);
    margin-bottom: 4px;
  }
  .related .t {
    font-size: calc(17px * var(--a11y-echelle));
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .related .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
