---
/** Bloc « Dans le même thème » — publications liées en pied d'article. */
import { publicationHref, type PublicationCollection } from '../../lib/publications';
import { formatDateFr, stripHeroMarkers } from '../../lib/site';

interface Props {
  collection: PublicationCollection;
  items: Array<{ publicId: string; title: string; publishedAt: string }>;
}

const { collection, items } = Astro.props;
---

<section class="border-rule mt-14 border-t pt-8">
  <h3
    class="text-ink mt-0 mb-3.5 font-sans text-[calc(13px*var(--a11y-echelle))] font-semibold tracking-[0.1em] uppercase"
  >
    Dans le même thème
  </h3>
  <div class="grid grid-cols-2 gap-5 max-mobile:grid-cols-1">
    {items.map((r) => (
      <a
        href={publicationHref(collection, r.publicId)}
        class="border-rule text-ink group block border-t py-3.5 transition-colors duration-100"
      >
        <div class="text-muted mb-1 font-sans text-label">{formatDateFr(r.publishedAt)}</div>
        <div class="group-hover:text-accent text-courant leading-[1.3] font-semibold">
          {stripHeroMarkers(r.title)}
        </div>
      </a>
    ))}
  </div>
</section>
