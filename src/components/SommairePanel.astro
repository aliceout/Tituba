---
/**
 * « Au sommaire » — index dense des dernières publications.
 *
 * Tableau plutôt que cartes : à hauteur égale, on montre cinq entrées
 * au lieu de deux, et l'œil compare les formats d'un coup. C'est le
 * registre d'un ours de revue, pas d'un fil d'actualité.
 *
 * Panneau en violet très dilué — c'est ce qui le détache sans recourir à
 * une bordure. Les rubriques prennent trois couleurs de
 * famille à tour de rôle, par position et non par format : à cinq
 * formats pour trois couleurs, tout appariement serait arbitraire et se
 * lirait pourtant comme un code. Une alternance régulière ne prétend
 * rien coder — elle donne du rythme à une liste, et c'est tout ce qu'on
 * lui demande.
 */
import { PUBLICATIONS, publicationHref, readingLabelFor } from '../lib/publications';
import type { FeedDoc } from '../lib/payload';
import { stripHeroMarkers } from '../lib/site';

export interface Props {
  docs: Array<FeedDoc & { durationSeconds?: number | null }>;
  /** Lien de sortie, à droite de l'intitulé. */
  allHref?: string;
}

const { docs, allHref = '/archives/' } = Astro.props as Props;

/**
 * Les trois couleurs de famille, prises à tour de rôle par position.
 * C’était trois règles :nth-child(3n+k) ; le rang est ici celui de
 * la boucle, qui dit la même chose sans avoir à être relu à l’envers.
 */
const COULEURS = ['text-[var(--c-bleu-deep)]', 'text-[var(--c-vert-deep)]', 'text-[var(--c-jaune-deep)]'];

/** Le filet des lignes : l’accent du panneau, très dilué. */
const FILET = 'border-[color-mix(in_srgb,var(--c-sommaire-accent)_14%,transparent)]';

/** Date compacte « 14.04 », comme dans un ours de revue. */
function jourMois(iso: string | null): string {
  if (!iso) return '';
  const d = new Date(iso);
  return `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}`;
}
---

{/* Pas de marge haute : la carte de la une ferme déjà par 40 px. Les
    cumuler donnait 80 px ici contre 40 partout ailleurs, et le sommaire
    semblait décroché du reste de la page. */}
{docs.length > 0 && (
  <section class="pt-0 pb-(--block-gap)">
    <div class="rounded-(--radius-panel) bg-[var(--c-sommaire-bg)] px-12 pt-8 pb-5 max-mobile:rounded-[18px] max-mobile:px-5 max-mobile:pt-[22px] max-mobile:pb-3">
      <div class="flex items-baseline justify-between border-b border-[color-mix(in_srgb,var(--c-sommaire-accent)_22%,transparent)] pb-3.5 font-mono text-label tracking-[0.2em] uppercase">
        <span class="text-[var(--c-sommaire-accent)]">Au sommaire</span>
        <a
          class="text-[var(--c-panel-mute)] tracking-[0.16em] transition-colors duration-[120ms] hover:text-[var(--c-sommaire-accent)]"
          href={allHref}
        >
          Tout lire →
        </a>
      </div>

      <ul class="m-0 list-none p-0">
        {docs.map((d, rang) => {
          const spec = PUBLICATIONS[d.collection] ?? PUBLICATIONS.articles;
          const duree = readingLabelFor(d.collection, d);
          return (
            <li class:list={[rang > 0 && 'border-t', rang > 0 && FILET]}>
              {/* Grille explicite : les colonnes s’alignent d’une ligne à
                  l’autre, ce qu’un simple flex ne garantirait pas. Quatre
                  colonnes — format, titre, durée, date.

                  Sur étroit elle se replie : le format sur une ligne, le
                  titre en dessous, la durée et la date retirées —
                  l’information reste sur la page de la publication. */}
              <a
                href={publicationHref(d.collection, d.publicId)}
                class="text-ink grid grid-cols-[128px_1fr_auto_64px] items-baseline gap-6 py-5 transition-colors duration-[120ms] hover:text-[var(--c-sommaire-accent)] max-mobile:grid-cols-[1fr] max-mobile:gap-x-5 max-mobile:gap-y-1.5 max-mobile:py-4"
              >
                <span class:list={['font-mono text-label tracking-[0.14em] uppercase', COULEURS[rang % 3]]}>
                  {spec.badge}
                </span>
                {/* Le titre reste d’une seule encre : c’est le texte à
                    lire, il n’a pas à participer au rythme des couleurs. */}
                <span class="font-serif text-[calc(18px*var(--a11y-echelle))] leading-[1.25] font-normal tracking-[-0.01em] max-mobile:col-span-full max-mobile:text-[calc(17px*var(--a11y-echelle))]">
                  {stripHeroMarkers(d.title)}
                </span>
                <span class="font-mono text-label text-[var(--c-panel-mute)] max-mobile:hidden">{duree}</span>
                <span class="text-right font-mono text-label text-[var(--c-panel-mute)] max-mobile:hidden">
                  {jourMois(d.publishedAt)} →
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}
