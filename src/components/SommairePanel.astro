---
/**
 * « Au sommaire » — index dense des dernières publications.
 *
 * Tableau plutôt que cartes : à hauteur égale, on montre cinq entrées
 * au lieu de deux, et l'œil compare les formats d'un coup. C'est le
 * registre d'un ours de revue, pas d'un fil d'actualité.
 *
 * Panneau en violet très dilué — c'est ce qui le détache sans recourir à
 * une bordure. Les rubriques prennent trois couleurs de
 * famille à tour de rôle, par position et non par format : à cinq
 * formats pour trois couleurs, tout appariement serait arbitraire et se
 * lirait pourtant comme un code. Une alternance régulière ne prétend
 * rien coder — elle donne du rythme à une liste, et c'est tout ce qu'on
 * lui demande.
 */
import { PUBLICATIONS, publicationHref, readingLabelFor } from '../lib/publications';
import type { FeedDoc } from '../lib/payload';
import { stripHeroMarkers } from '../lib/site';

export interface Props {
  docs: Array<FeedDoc & { durationSeconds?: number | null }>;
  /** Lien de sortie, à droite de l'intitulé. */
  allHref?: string;
}

const { docs, allHref = '/archives/' } = Astro.props as Props;

/** Date compacte « 14.04 », comme dans un ours de revue. */
function jourMois(iso: string | null): string {
  if (!iso) return '';
  const d = new Date(iso);
  return `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}`;
}
---

{docs.length > 0 && (
  <section class="sommaire">
    <div class="panel">
      <div class="head">
        <span class="label">Au sommaire</span>
        <a class="all" href={allHref}>Tout lire →</a>
      </div>

      <ul class="rows">
        {docs.map((d) => {
          const spec = PUBLICATIONS[d.collection] ?? PUBLICATIONS.articles;
          const duree = readingLabelFor(d.collection, d);
          return (
            <li>
              <a href={publicationHref(d.collection, d.publicId)}>
                <span class="fmt">{spec.badge}</span>
                <span class="titre">{stripHeroMarkers(d.title)}</span>
                <span class="duree">{duree}</span>
                <span class="date">{jourMois(d.publishedAt)} →</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<style>
  /* Pas de marge haute : la carte de la une ferme déjà par 40 px. Les
     cumuler donnait 80 px ici contre 40 partout ailleurs, et le
     sommaire semblait décroché du reste de la page. */
  .sommaire {
    padding: 0 0 var(--block-gap);
  }

  .panel {
    background: var(--c-sommaire-bg);
    border-radius: var(--radius-panel);
    padding: 32px 48px 20px;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--c-sommaire-accent) 22%, transparent);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .head .label {
    color: var(--c-sommaire-accent);
  }
  .head .all {
    color: var(--c-panel-mute);
    letter-spacing: 0.16em;
    transition: color 0.12s;
  }
  .head .all:hover {
    color: var(--c-sommaire-accent);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li + li {
    border-top: 1px solid color-mix(in srgb, var(--c-sommaire-accent) 14%, transparent);
  }

  /* Grille explicite : les colonnes s'alignent d'une ligne à l'autre,
     ce qu'un simple flex ne garantirait pas. */
  .rows a {
    display: grid;
    /* Quatre colonnes : format, titre, durée, date. La première, de
       64px, portait le numéro de série — supprimé avec lui, sans quoi
       le titre se retrouvait comprimé dans la colonne suivante. */
    grid-template-columns: 128px 1fr auto 64px;
    gap: 24px;
    align-items: baseline;
    padding: 20px 0;
    color: var(--color-ink);
    transition: color 0.12s;
  }
  .rows a:hover {
    color: var(--c-sommaire-accent);
  }

  .fmt,
  .duree,
  .date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--c-panel-mute);
  }
  .fmt {
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  /* Alternance des trois familles sur la rubrique. Le titre, lui,
     reste d'une seule encre : c'est le texte à lire, il n'a pas à
     participer au rythme. */
  .rows li:nth-child(3n + 1) .fmt {
    color: var(--c-bleu-deep);
  }
  .rows li:nth-child(3n + 2) .fmt {
    color: var(--c-vert-deep);
  }
  .rows li:nth-child(3n + 3) .fmt {
    color: var(--c-jaune-deep);
  }

  .titre {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .date {
    text-align: right;
  }

  @media (max-width: 900px) {
    .panel {
      padding: 22px 20px 12px;
      border-radius: 18px;
    }
    /* Sur étroit, la grille se replie : le format sur une ligne, le
       titre en dessous. Les colonnes de durée et de date disparaissent —
       l'information reste sur la page de la publication. */
    .rows a {
      grid-template-columns: 1fr;
      gap: 6px 20px;
      row-gap: 6px;
      padding: 16px 0;
    }
    .titre {
      grid-column: 1 / -1;
      font-size: 17px;
    }
    .duree,
    .date {
      display: none;
    }
  }
</style>
