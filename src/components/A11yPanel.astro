---
/**
 * Panneau de réglages d'accessibilité — tiroir latéral droit, ouvert
 * par le bouton « Accessibilité » du header.
 *
 * Rendu depuis Layout et non depuis Header, pour une raison de plans :
 * le header porte `z-index: 10`, ce qui crée un contexte d'empilement
 * dont rien à l'intérieur ne peut sortir. Le tiroir et le guide de
 * lecture doivent passer au-dessus de toute la page, guide compris —
 * ils vivent donc à la racine du <body>.
 *
 * Le panneau ne fait qu'écrire des attributs sur <html> et les
 * enregistrer dans localStorage. Tout l'effet visible est en CSS
 * (styles/accessibilite.css) : si ce script échoue, les réglages déjà
 * enregistrés s'appliquent quand même, puisqu'ils sont réappliqués
 * avant le premier paint par le script d'amorçage du Layout.
 *
 * Non modal, volontairement : on règle en regardant l'effet sur la
 * page. Une modale voilée cacherait précisément ce qu'on est en train
 * d'ajuster. D'où l'absence de piège à focus — mais Échap ferme, et le
 * focus revient au bouton.
 */

/** Un groupe de réglages, et son intitulé en petites capitales. */
const GROUPE = 'm-0 mb-[22px] border-0 p-0';
const LEGENDE =
  'text-muted mb-2.5 p-0 font-mono text-[calc(10px*var(--a11y-echelle))] tracking-label uppercase';

/**
 * Les inputs des crans et des polices sont retirés de l'œil, pas de
 * l'arbre : `display: none` les rendrait injoignables au clavier. C'est
 * l'input qui porte l'état et le focus ; le cadre coloré n'est que son
 * reflet, branché dessus par `has-`.
 */
const INPUT_INVISIBLE = 'absolute inset-0 m-0 cursor-pointer opacity-0';

/** Un cran de taille. Il s'écrit à la taille qu'il applique. */
const CRAN = [
  'bg-bg border-rule text-ink relative flex flex-1 cursor-pointer items-center justify-center',
  'rounded-[3px] border py-2.5 font-serif leading-none',
  'transition-[border-color,background-color] duration-[120ms]',
  'hover:border-ink',
  'has-[input:checked]:border-[var(--c-bleu)] has-[input:checked]:bg-[var(--c-bleu)] has-[input:checked]:text-[var(--c-bleu-on)]',
  'has-[input:focus-visible]:outline-2 has-[input:focus-visible]:outline-offset-2 has-[input:focus-visible]:outline-[var(--c-bleu-deep)]',
].join(' ');

/**
 * Valeurs fixes, non multipliées par l'échelle : le groupe doit garder
 * le même rapport interne quel que soit le réglage en cours, sinon il
 * grandirait à chaque clic.
 */
const TAILLES_CRAN = ['text-[13px]', 'text-[16px]', 'text-[19px]', 'text-[22px]'];

/** Un choix de police. */
const POLICE = [
  'bg-bg border-rule text-ink relative grid cursor-pointer grid-cols-[1fr_auto] items-baseline',
  'gap-x-2.5 gap-y-1 rounded-[3px] border px-3 py-2.5 text-left',
  'transition-[border-color,background-color] duration-[120ms]',
  'hover:border-ink',
  'has-[input:checked]:border-[var(--c-bleu)] has-[input:checked]:bg-[color-mix(in_srgb,var(--c-bleu)_10%,var(--color-bg))]',
  'has-[input:focus-visible]:outline-2 has-[input:focus-visible]:outline-offset-2 has-[input:focus-visible]:outline-[var(--c-bleu-deep)]',
].join(' ');

/**
 * L'échantillon porte la police proposée, indépendamment de celle qui
 * est active : c'est ce qui permet de comparer avant de choisir.
 */
const ECHANTILLONS = {
  defaut: "font-['Fraunces_Variable',Georgia,serif]",
  luciole: "font-['Luciole',Verdana,sans-serif]",
  dyslexie: "font-['OpenDyslexic',Verdana,sans-serif]",
};

/**
 * Une bascule. `relative` sert de repère à l'input masqué : sans lui,
 * celui-ci se calerait sur le tiroir — huit cases invisibles empilées
 * dans le coin haut-gauche, par-dessus le bouton de fermeture, qui
 * intercepteraient ses clics.
 */
const BASCULE = 'relative grid cursor-pointer grid-cols-[34px_1fr] items-start gap-2.5 py-[9px]';

/**
 * L'input de la bascule est `peer` : la piste n'est qu'un décor branché
 * dessus. Retiré de l'affichage mais pas de l'arbre — c'est lui qui
 * porte l'état, reçoit le focus et répond à la barre d'espace.
 */
const BASCULE_INPUT = 'peer absolute m-0 h-5 w-[34px] cursor-pointer opacity-0';
const PISTE = [
  'bg-rule relative mt-px h-5 w-[34px] rounded-full transition-[background-color] duration-[140ms]',
  "after:absolute after:top-0.5 after:left-0.5 after:size-4 after:rounded-full after:bg-white after:transition-transform after:duration-[140ms] after:content-['']",
  'peer-checked:bg-[var(--c-vert)] peer-checked:after:translate-x-[14px]',
  'peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-[var(--c-bleu-deep)]',
].join(' ');
const BASCULE_TEXTE =
  'text-[calc(13px*var(--a11y-echelle))] leading-[1.35] [&_.sous]:text-muted [&_.sous]:mt-0.5 [&_.sous]:block [&_.sous]:text-[calc(11.5px*var(--a11y-echelle))] [&_.sous]:leading-[1.45]';

---

{/* Fermé : hors champ à droite. L'attribut `hidden` le retire de l'arbre
    d'accessibilité, la transformation gère le mouvement — il est posé et
    retiré par le script autour de celle-ci, pour que le tiroir ne reste
    pas focusable une fois refermé.

    Sous 420 px le tiroir prend toute la largeur : 380 px sur un écran de
    360 laisseraient une bande de page inutilisable. */}
<div
  class="bg-paper border-rule text-ink fixed inset-y-0 right-0 z-[60] flex w-[min(380px,100vw)] translate-x-full flex-col overflow-hidden border-l font-sans shadow-[-12px_0_32px_rgba(0,0,0,0.1)] transition-transform duration-[220ms] ease-[ease] data-[ouvert]:translate-x-0 max-[420px]:w-screen max-[420px]:border-l-0 [&[hidden]]:hidden"
  id="panneau-accessibilite"
  role="dialog"
  aria-labelledby="a11y-titre"
  aria-hidden="true"
  hidden
>
  <div class="flex items-center justify-between px-[22px] pt-5">
    <h2 id="a11y-titre" class="m-0 font-serif text-[calc(22px*var(--a11y-echelle))] font-normal">
      Accessibilité
    </h2>
    <button
      type="button"
      class="text-muted hover:text-ink -m-1.5 inline-flex cursor-pointer rounded-full border-0 bg-none p-1.5 hover:bg-[color-mix(in_oklch,var(--color-ink),transparent_92%)]"
      data-a11y-close
      aria-label="Fermer le panneau"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <p class="text-muted mx-[22px] mt-2 text-meta leading-[1.5]">
    Ces réglages ne concernent que votre navigateur. Ils sont conservés d’une visite à l’autre.
  </p>

  <div class="flex-auto overflow-y-auto px-[22px] pt-[18px] pb-2">
    {/* Quatre crans nommés plutôt qu'un curseur : ils se choisissent au
        clavier sans viser, et l'on sait toujours où l'on en est.

        De vrais <input type="radio"> et non des boutons portant
        `role="radio"` : le groupe natif apporte la navigation aux
        flèches, le point de tabulation unique et l'annonce « 2 sur 4 »
        — soit exactement ce qu'un panneau d'accessibilité n'a aucune
        excuse de réécrire à moitié. L'input est masqué à l'œil mais
        reste focusable ; le cadre coloré n'est que son reflet. */}
    <fieldset class={GROUPE}>
      <legend class={LEGENDE}>Taille du texte</legend>
      <div class="flex items-end gap-2">
        {[
          { v: '100', t: 'Taille normale' },
          { v: '110', t: 'Texte agrandi de 10 %' },
          { v: '120', t: 'Texte agrandi de 20 %' },
          { v: '130', t: 'Texte agrandi de 30 %' },
        ].map((c, i) => (
          <label class={CRAN} title={c.t}>
            <input
              type="radio"
              name="a11y-taille"
              value={c.v}
              data-a11y-set="taille"
              checked={c.v === '100'}
              class={INPUT_INVISIBLE}
            />
            <span class={TAILLES_CRAN[i]} aria-hidden="true">A</span>
            <span class="sr-only">{c.t}</span>
          </label>
        ))}
      </div>
    </fieldset>

    {/* Trois choix exclusifs. Chaque échantillon est écrit dans la
        police qu'il propose : c'est le seul aperçu qui vaille. */}
    <fieldset class={GROUPE}>
      <legend class={LEGENDE}>Police de lecture</legend>
      <div class="grid gap-2">
        {[
          { v: 'defaut', nom: 'Police du site', pour: null },
          { v: 'luciole', nom: 'Luciole', pour: 'basse vision' },
          { v: 'dyslexie', nom: 'OpenDyslexic', pour: 'dyslexie' },
        ].map((p) => (
          <label class={POLICE}>
            <input
              type="radio"
              name="a11y-police"
              value={p.v}
              data-a11y-set="police"
              checked={p.v === 'defaut'}
              class={INPUT_INVISIBLE}
            />
            <span class="text-[calc(13px*var(--a11y-echelle))] font-medium">{p.nom}</span>
            {p.pour && (
              <span class="text-muted font-mono text-[calc(9px*var(--a11y-echelle))] tracking-[0.1em] uppercase">
                {p.pour}
              </span>
            )}
            <span
              class:list={[
                'text-muted col-span-full text-[15px] tracking-[0.04em]',
                ECHANTILLONS[p.v as keyof typeof ECHANTILLONS],
              ]}
              aria-hidden="true"
            >
              Aa Bb Il1 O0
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class={GROUPE}>
      <legend class={LEGENDE}>Lisibilité</legend>

      <label class={BASCULE}>
        <input type="checkbox" class={BASCULE_INPUT} data-a11y-toggle="espacement" data-a11y-on="large" />
        <span class={PISTE} aria-hidden="true"></span>
        <span class={BASCULE_TEXTE}>
          Espacement du texte
          <span class="sous">Interligne, interlettre et intermot élargis.</span>
        </span>
      </label>

      <label class={BASCULE}>
        <input type="checkbox" class={BASCULE_INPUT} data-a11y-toggle="liens" data-a11y-on="soulignes" />
        <span class={PISTE} aria-hidden="true"></span>
        <span class={BASCULE_TEXTE}>
          Liens soulignés
          <span class="sous">Repérer un lien sans se fier à sa couleur.</span>
        </span>
      </label>

      <label class={BASCULE}>
        <input type="checkbox" class={BASCULE_INPUT} data-a11y-toggle="guide" data-a11y-on="on" />
        <span class={PISTE} aria-hidden="true"></span>
        <span class={BASCULE_TEXTE}>
          Guide de lecture
          <span class="sous">Une bande claire suit le pointeur, le reste s’assombrit.</span>
        </span>
      </label>
    </fieldset>

    <fieldset class={GROUPE}>
      <legend class={LEGENDE}>Couleurs</legend>

      <label class={BASCULE}>
        <input type="checkbox" class={BASCULE_INPUT} data-a11y-toggle="contraste" data-a11y-on="renforce" />
        <span class={PISTE} aria-hidden="true"></span>
        <span class={BASCULE_TEXTE}>
          Contraste renforcé
          <span class="sous">Se cumule avec le thème clair ou sombre.</span>
        </span>
      </label>

      <label class={BASCULE}>
        <input type="checkbox" class={BASCULE_INPUT} data-a11y-toggle="couleurs" data-a11y-on="daltonisme" />
        <span class={PISTE} aria-hidden="true"></span>
        <span class={BASCULE_TEXTE}>
          Palette adaptée au daltonisme
          <span class="sous">
            Le site distingue ses formats par quatre couleurs. Celles-ci restent
            différenciables sous les trois formes de daltonisme.
          </span>
        </span>
      </label>

      <label class={BASCULE}>
        <input type="checkbox" class={BASCULE_INPUT} data-a11y-toggle="animations" data-a11y-on="reduites" />
        <span class={PISTE} aria-hidden="true"></span>
        <span class={BASCULE_TEXTE}>
          Animations réduites
          <span class="sous">Coupe les transitions et les défilements animés.</span>
        </span>
      </label>
    </fieldset>
  </div>

  <div class="border-rule flex-none border-t px-[22px] pt-3.5 pb-[18px]">
    <button
      type="button"
      class="border-rule text-ink hover:border-ink cursor-pointer rounded-[3px] border bg-none px-3.5 py-2 font-[inherit] text-meta"
      data-a11y-reset
    >
      Tout réinitialiser
    </button>
    <p class="text-muted mt-2.5 mb-0 text-label leading-[1.45] [&_a]:text-ink [&_a]:underline [&_a]:underline-offset-[0.18em]">
      <a href="/accessibilite/">Où nous en sommes, et ce qui manque encore</a> — un obstacle
      rencontré sur ce site&nbsp;? Le signaler est le meilleur moyen qu’il soit corrigé.
    </p>
  </div>
</div>

{/* Guide de lecture — hors du tiroir : il couvre la fenêtre entière, et
    doit rester en place une fois le panneau refermé. */}
<div class="a11y-guide" aria-hidden="true">
  <div class="a11y-guide__voile a11y-guide__voile--haut"></div>
  <div class="a11y-guide__fenetre"></div>
  <div class="a11y-guide__voile a11y-guide__voile--bas"></div>
</div>

<script>
  import '../scripts/a11y-panel.client';
</script>
