---
/**
 * Bloc titré — étiquette en mono capitales, repère éditorial à droite,
 * puis le contenu.
 *
 * C'est le motif « À LA UNE / printemps 2026 », « AU SOMMAIRE / tout
 * lire », « NOUS SUIVRE » de l'accueil. Il était recopié dans trois
 * composants, chacun avec son interlettrage et sa marge basse.
 *
 * L'étiquette prend la couleur de la famille du bloc, ou le gris par
 * défaut. Elle reste sur le fond de page même quand ce qui suit est un
 * panneau : c'est le nom du bloc, pas son contenu.
 */
interface Props {
  /** Texte de l'étiquette. Mis en capitales par le CSS. */
  label: string;
  /** Repère à droite — « printemps 2026 », « tout lire → ». */
  eyebrow?: string;
  /** Si fourni, le repère devient un lien. */
  eyebrowHref?: string;
  /** Famille de couleur de l'étiquette. */
  famille?: 'bleu' | 'vert' | 'jaune' | 'violet' | 'neutre';
  /** Marge basse du bloc entier. */
  gap?: boolean;
}

const {
  label,
  eyebrow,
  eyebrowHref,
  famille = 'neutre',
  gap = true,
} = Astro.props;
// La famille ne colore que l’étiquette. Le repère de droite reste gris :
// c’est une précision, pas un titre.
const FAMILLES: Record<string, string> = {
  neutre: 'text-muted',
  bleu: 'text-[var(--c-bleu-deep)]',
  vert: 'text-[var(--c-vert-deep)]',
  jaune: 'text-[var(--c-jaune-deep)]',
  violet: 'text-[var(--c-violet-deep)]',
};
---

<section class:list={[gap && 'mb-(--block-gap)']}>
  <div
    class="font-mono text-label tracking-label mb-[22px] flex items-baseline justify-between gap-4 uppercase"
  >
    <span class:list={[FAMILLES[famille]]}>{label}</span>
    {eyebrow &&
      (eyebrowHref ? (
        <a
          class="text-muted hover:text-ink tracking-[0.08em] whitespace-nowrap normal-case transition-colors duration-100"
          href={eyebrowHref}
        >
          {eyebrow}
        </a>
      ) : (
        <span class="text-muted tracking-[0.08em] whitespace-nowrap normal-case">{eyebrow}</span>
      ))}
  </div>
  <slot />
</section>
