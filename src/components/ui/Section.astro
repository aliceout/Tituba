---
/**
 * Bloc titré — étiquette en mono capitales, repère éditorial à droite,
 * puis le contenu.
 *
 * C'est le motif « À LA UNE / printemps 2026 », « AU SOMMAIRE / tout
 * lire », « NOUS SUIVRE » de l'accueil. Il était recopié dans trois
 * composants, chacun avec son interlettrage et sa marge basse.
 *
 * L'étiquette prend la couleur de la famille du bloc, ou le gris par
 * défaut. Elle reste sur le fond de page même quand ce qui suit est un
 * panneau : c'est le nom du bloc, pas son contenu.
 */
interface Props {
  /** Texte de l'étiquette. Mis en capitales par le CSS. */
  label: string;
  /** Repère à droite — « printemps 2026 », « tout lire → ». */
  eyebrow?: string;
  /** Si fourni, le repère devient un lien. */
  eyebrowHref?: string;
  /** Famille de couleur de l'étiquette. */
  famille?: 'bleu' | 'vert' | 'jaune' | 'violet' | 'neutre';
  /** Marge basse du bloc entier. */
  gap?: boolean;
}

const {
  label,
  eyebrow,
  eyebrowHref,
  famille = 'neutre',
  gap = true,
} = Astro.props;
---

<section class:list={['bloc', { 'bloc--gap': gap }]} data-famille={famille}>
  <div class="head">
    <span class="label">{label}</span>
    {eyebrow &&
      (eyebrowHref ? (
        <a class="eyebrow" href={eyebrowHref}>{eyebrow}</a>
      ) : (
        <span class="eyebrow">{eyebrow}</span>
      ))}
  </div>
  <slot />
</section>

<style>
  .bloc--gap {
    margin-bottom: var(--block-gap);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    margin-bottom: 22px;
  }

  /* La famille ne colore que l'étiquette. Le repère de droite reste
     gris : c'est une précision, pas un titre. */
  .bloc[data-famille='neutre'] .label {
    color: var(--color-muted);
  }
  .bloc[data-famille='bleu'] .label {
    color: var(--c-bleu-deep);
  }
  .bloc[data-famille='vert'] .label {
    color: var(--c-vert-deep);
  }
  .bloc[data-famille='jaune'] .label {
    color: var(--c-jaune-deep);
  }
  .bloc[data-famille='violet'] .label {
    color: var(--c-violet-deep);
  }

  .eyebrow {
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: none;
    white-space: nowrap;
    transition: color 0.12s;
  }
  a.eyebrow:hover {
    color: var(--color-ink);
  }
</style>
