---
/**
 * Panneau teinté aux angles arrondis — la « pièce posée sur la page ».
 *
 * Quatre composants en portaient chacun une copie, avec des rayons et
 * des paddings qui avaient déjà commencé à diverger. Le fond vient de
 * la famille demandée ; ces teintes sont dérivées de la couleur de
 * famille diluée dans le fond de page, donc elles suivent la charte
 * sans qu'on ait à les resynchroniser (cf. global.css).
 *
 * `ton="plein"` pour un aplat saturé à texte clair — une carte de
 * format, un carré podcast. `ton="dilue"` pour un panneau posé sur la
 * page, qui est le cas courant.
 */
interface Props {
  famille: 'bleu' | 'vert' | 'jaune' | 'violet' | 'marque';
  ton?: 'dilue' | 'plein';
  /** Rembourrage. `serre` pour les panneaux qui listent. */
  padding?: 'normal' | 'serre' | 'aucun';
  class?: string;
}

const {
  famille,
  ton = 'dilue',
  padding = 'normal',
  class: className,
} = Astro.props;

/**
 * Teintes diluées : l’encre reste celle de la page — sur un fond à 14-20 %,
 * le texte courant garde son contraste et n’a pas à être redéfini.
 *
 * Aplats saturés : l’encre ne peut pas être celle de la page, chaque
 * famille porte sa propre paire fond / texte, calibrée pour passer 4,5:1.
 *
 * `marque` est la couleur configurable depuis l’admin. Pas d’aplat pour
 * elle : c’est une valeur arbitraire, rien ne garantit son contraste avec
 * un texte clair.
 */
const TEINTES: Record<string, string> = {
  'dilue-bleu': '[--fond:var(--c-bleu-tint)] [--encre:var(--color-ink)] [--accent:var(--c-bleu-deep)]',
  'dilue-vert': '[--fond:var(--c-vert-tint)] [--encre:var(--color-ink)] [--accent:var(--c-vert-deep)]',
  'dilue-jaune': '[--fond:var(--c-jaune-tint)] [--encre:var(--color-ink)] [--accent:var(--c-jaune-deep)]',
  'dilue-violet': '[--fond:var(--c-violet-tint)] [--encre:var(--color-ink)] [--accent:var(--c-violet-deep)]',
  'dilue-marque':
    '[--fond:color-mix(in_srgb,var(--color-accent)_14%,var(--color-bg))] [--encre:var(--color-ink)] [--accent:var(--color-accent)]',
  'plein-bleu': '[--fond:var(--c-bleu-fill)] [--encre:var(--c-bleu-on)] [--accent:var(--c-bleu-on-soft)]',
  'plein-vert': '[--fond:var(--c-vert-fill)] [--encre:var(--c-vert-on)] [--accent:var(--c-vert-on-soft)]',
  'plein-jaune': '[--fond:var(--c-jaune-fill)] [--encre:var(--c-jaune-on)] [--accent:var(--c-jaune-on-soft)]',
  'plein-violet': '[--fond:var(--c-violet)] [--encre:#fff] [--accent:#cdc0da]',
};

const MARGES: Record<string, string> = {
  normal: 'px-12 py-9 max-mobile:px-5 max-mobile:py-[26px]',
  serre: 'px-8 py-[26px] max-mobile:px-[18px] max-mobile:py-5',
  aucun: 'p-0',
};
---

<div
  class:list={[
    'bg-(--fond) text-(--encre) rounded-(--radius-panel) max-mobile:rounded-[18px]',
    TEINTES[`${ton}-${famille}`],
    MARGES[padding],
    className,
  ]}
>
  <slot />
</div>
