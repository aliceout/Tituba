---
/**
 * Titre intermédiaire — « Par mail », « Par flux RSS », « Au sommaire »…
 *
 * Prose donne déjà la bonne échelle aux `<h2>` et `<h3>` qu'elle
 * contient, mais rien n'oblige une page à passer par elle : il suffit
 * d'écrire un `<h2>` ailleurs pour retrouver les valeurs par défaut du
 * navigateur, ou pire, d'en redéfinir de nouvelles. Ce composant ferme
 * cette porte — un titre de section s'écrit d'une seule façon.
 *
 * `niveau` porte la hiérarchie du document, `taille` l'apparence. Les
 * deux sont séparés parce qu'ils ne répondent pas à la même question :
 * un h3 peut avoir à ressembler à un h2 quand la structure l'impose,
 * sans qu'on doive mentir sur le plan du document.
 */
interface Props {
  /** Niveau réel dans le plan du document. */
  niveau?: 2 | 3 | 4;
  /** Apparence, si elle doit différer du niveau. */
  taille?: 'h2' | 'h3';
  /** Famille de couleur. L'encre par défaut. */
  famille?: 'encre' | 'bleu' | 'vert' | 'jaune' | 'violet';
  class?: string;
}

const { niveau = 2, taille, famille = 'encre', class: className } = Astro.props;

const Tag = `h${niveau}` as 'h2' | 'h3' | 'h4';
const apparence = taille ?? (niveau === 2 ? 'h2' : 'h3');
const FAMILLES: Record<string, string> = {
  encre: 'text-ink',
  bleu: 'text-[var(--c-bleu-deep)]',
  vert: 'text-[var(--c-vert-deep)]',
  jaune: 'text-[var(--c-jaune-deep)]',
  violet: 'text-[var(--c-violet-deep)]',
};

// Marge haute nettement plus grande que la basse : un titre appartient
// à ce qui le suit, pas à ce qui le précède.
const APPARENCES: Record<string, string> = {
  h2: 'text-h2 mt-[52px] mb-3.5',
  h3: 'text-h3 mt-9 mb-3',
};
---

<Tag
  class:list={[
    'leading-heading tracking-display font-serif font-(--font-weight-heading) first:mt-0',
    APPARENCES[apparence],
    FAMILLES[famille],
    className,
  ]}
>
  <slot />
</Tag>
