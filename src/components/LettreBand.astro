---
/**
 * Bande d'abonnement à la lettre, en pied d'accueil.
 *
 * Renvoie vers /abonnement/ plutôt que d'embarquer le formulaire :
 * l'inscription passe par une double confirmation par mail, et
 * dupliquer ce parcours ici créerait un second chemin à maintenir —
 * avec ses propres états d'erreur, de succès et de renvoi. Le bouton
 * mène donc à la page qui gère déjà tout cela.
 *
 * La maquette dessinait à cet endroit un champ de saisie suivi d'un
 * bouton. On n'en garde que la silhouette — pastille bordée, bouton
 * plein à l'intérieur — sans le faux champ : une zone qui ressemble à
 * un input mais navigue au clic est un piège, et la vraie saisie a lieu
 * une page plus loin de toute façon.
 */
export interface Props {
  href?: string;
}
const { href = '/abonnement/' } = Astro.props as Props;
---

<section class="lettre">
  {/* Étiquette de section hors du panneau, comme « À LA UNE » : elle
      nomme le bloc, elle n'en fait pas partie. Le libellé reprend
      celui de l'onglet du header et de la colonne du pied — trois
      surfaces, une seule formule pour la même chose. */}
  <div class="head">
    <span class="label">Nous suivre</span>
  </div>

  <div class="panel">
    <div class="txt">
      <div class="label">La lettre</div>
      <p>Une fois par trimestre.</p>
    </div>
    <a class="cta" href={href}>
      <span class="cta-lead">Une adresse suffit</span>
      <span class="cta-btn">S'abonner →</span>
    </a>
  </div>
</section>

<style>
  /* Pas de padding-bottom : PageShell.page-body (72px) + le margin-top
     du Footer s'en chargent déjà, exactement comme sur toute autre
     page. En ajouter un ici recreuserait le même vide en trop qu'on a
     déjà eu (Footer + LettreBand cumulés) avant que PageShell porte
     systématiquement l'écart de fin de page. */
  .lettre {
    padding: 0;
  }

  /* Même traitement que l'étiquette de la une : mono, capitales,
     largement interlettré, dans l'accent de la famille du panneau. */
  .head {
    font-family: var(--font-mono);
    font-size: calc(11px * var(--a11y-echelle));
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .head .label {
    color: var(--c-vert-deep);
  }

  /* Le vert clôt la série des panneaux — jaune à la une, violet au
     sommaire, vert ici. */
  .panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--c-vert-tint);
    border-radius: var(--radius-panel);
    padding: 36px 48px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: calc(11px * var(--a11y-echelle));
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-vert-deep);
    margin-bottom: 8px;
  }
  .txt p {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: calc(22px * var(--a11y-echelle));
    color: var(--color-ink);
    margin: 0;
  }

  /* Pastille bordée abritant le bouton plein — la silhouette du champ
     de saisie de la maquette, sans le faux champ. */
  .cta {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 20px;
    border: 1.5px solid var(--c-vert-deep);
    border-radius: 999px;
    transition: background 0.12s;
  }
  .cta:hover {
    background: color-mix(in srgb, var(--c-vert-deep) 8%, transparent);
  }
  .cta-lead {
    font-family: var(--font-mono);
    font-size: calc(12px * var(--a11y-echelle));
    color: var(--c-panel-mute);
  }
  .cta-btn {
    background: var(--c-vert-deep);
    color: var(--c-vert-tint);
    padding: 9px 18px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: calc(13px * var(--a11y-echelle));
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .panel {
      padding: 24px 20px;
      border-radius: 18px;
    }
    /* Sous cette largeur la pastille pousserait le bloc à déborder :
       elle perd son libellé d'amorce et ne garde que le bouton. */
    .cta {
      padding: 0;
      border-color: transparent;
    }
    .cta-lead {
      display: none;
    }
  }
</style>
