---
/**
 * Publication mise en avant, en tête d'accueil.
 *
 * Panneau en jaune dilué, aux angles largement arrondis, avec le violet
 * du sommaire plus bas et le bleu du carré podcast qui lui répond à droite.
 * Ce n'est pas le contraste qui désigne la une (la maquette la voulait
 * en encre pleine, ce qui plombait le haut de page) mais sa position et
 * la taille de son titre, plus grand que partout ailleurs sauf le hero.
 * Le chapô reste en italique serif pour prolonger le titre plutôt que
 * d'ouvrir un second registre — le bloc tient d'une seule voix.
 */
import FormatIcon from './FormatIcon.astro';
import { PUBLICATIONS, publicationHref, readingLabelFor } from '../lib/publications';
import type { FeedDoc } from '../lib/payload';
import { formatDateFr, stripHeroMarkers } from '../lib/site';

export interface Props {
  doc: FeedDoc & { durationSeconds?: number | null };
  /** Libellé de la colonne de droite, ex. « printemps 2026 ». */
  eyebrow?: string;
}

const { doc, eyebrow } = Astro.props as Props;

// Le bloc se scinde en trois quarts / un quart dès qu'on lui passe un
// contenu latéral, et reprend la largeur pleine sinon. La décision est
// prise ici plutôt que par une prop booléenne : l'appelant n'a qu'un
// seul geste à faire — fournir le slot, ou pas — et il n'existe pas
// d'état incohérent où la grille serait scindée sans rien à droite.
const scinde = Astro.slots.has('aside');

// L'appel à l'action suit le format. « Lire le texte » sous un épisode
// de podcast ou sous un kit d'animation annonce autre chose que ce qui
// attend au bout du lien.
const APPELS: Record<string, string> = {
  podcasts: "écouter l'épisode →",
  outils: 'voir la ressource →',
};
const appel = APPELS[doc.collection] ?? 'lire le texte →';
const spec = PUBLICATIONS[doc.collection] ?? PUBLICATIONS.articles;
const href = publicationHref(doc.collection, doc.publicId);
const duree = readingLabelFor(doc.collection, doc);

// Métadonnées assemblées en une seule ligne mono, façon ours de revue.
const meta = [spec.badge.toUpperCase(), duree]
  .filter(Boolean)
  .join(' · ');

const auteurs = doc.authors ?? [];

/**
 * Composition partagée par les deux lignes en petites capitales du bloc —
 * l'étiquette de section et la ligne de métadonnées. Elles ne diffèrent
 * que par la couleur et l'écart qui les suit, d'où la mise en commun.
 */
const LIGNE_CAPITALES = 'font-mono text-label tracking-[0.16em] uppercase';

/**
 * Le contrepoint de la règle ci-dessus : la date et le repère de saison
 * échappent aux capitales et à l'interlettrage large. « 14 AVRIL 2026 »
 * se lit moins vite que « 14 avril 2026 », et les deux tombent à la même
 * hauteur de part et d'autre de la carte — même traitement, donc.
 */
const LIGNE_COURANTE = 'tracking-[0.08em] normal-case';

/**
 * Initiales d'un nom, deux lettres au plus. On prend le premier et le
 * dernier mot plutôt que les deux premiers : « Marie-Claire Van Damme »
 * doit donner MV, pas MC.
 */
function initiales(nom: string): string {
  const mots = nom.trim().split(/[\s-]+/).filter(Boolean);
  if (mots.length === 0) return '';
  const first = mots[0]![0] ?? '';
  const last = mots.length > 1 ? (mots[mots.length - 1]![0] ?? '') : '';
  return (first + last).toUpperCase();
}

/**
 * Signature « par X », « par X et Y », « par X et 3 autres ». Au-delà de
 * deux noms la ligne cesse d'être lisible d'un coup d'œil, et c'est
 * tout ce qu'on lui demande à cet endroit — la liste complète est sur
 * la page de la publication.
 */
const signature =
  auteurs.length === 0
    ? null
    : auteurs.length === 1
      ? `par ${auteurs[0]}`
      : auteurs.length === 2
        ? `par ${auteurs[0]} et ${auteurs[1]}`
        : `par ${auteurs[0]} et ${auteurs.length - 1} autres`;
---

{/* Pas de padding-top : PageShell.page-body le porte déjà. Un top ici
    doublerait l'écart avec le hero — exactement le défaut qu'on a eu
    en rendant ce Container systématique. */}
<section class="pb-(--block-gap)">
  {/* Ligne de section, hors de la carte : intitulé à gauche, repère
      éditorial à droite. Elle reste sur le fond de page — c'est
      l'étiquette du bloc, pas son contenu. */}
  <div class:list={['mb-6 flex items-baseline justify-between', LIGNE_CAPITALES]}>
    <span class="text-[var(--c-une-accent)]">À la une</span>
    {eyebrow && <span class:list={['text-muted', LIGNE_COURANTE]}>{eyebrow}</span>}
  </div>

  {/* Trois quarts / un quart, les deux blocs à la même hauteur.

      `items-stretch` est ce qui égalise : la rangée prend la hauteur de
      la carte — dimensionnée par son texte — et le bloc de droite la
      suit.

      Il a fallu renoncer au carré strict pour ça. Les trois contraintes
      — proportion carrée, hauteurs égales, largeur au quart — ne sont pas
      satisfiables ensemble : la hauteur vient du texte de la carte, donc
      la seule façon de garder un carré serait de laisser sa largeur en
      découler. Essayé, en colonne `auto` : la grille et l'`aspect-ratio`
      se renvoient la balle sans point fixe, et le bloc a fini à 673 px de
      côté, soit plus de la moitié de la largeur. */}
  <div class:list={[scinde && 'grid grid-cols-[3fr_1fr] items-stretch gap-6 max-mobile:grid-cols-[1fr]']}>
    {/* Colonne, pour que le pied puisse être poussé en bas (cf. `mt-auto`
        plus bas). Le carré podcast voisin le fait déjà par
        `space-between` : ici le pied suivait le chapô, si bien que
        « lire le texte » et « écouter » ne tombaient sur la même ligne
        que par coïncidence — tant que les deux contenus faisaient la même
        hauteur. Changer le corps du titre a suffi à la rompre.

        `relative` ancre le lien étendu du titre. Même survol que le carré
        podcast voisin — et surtout, même surface cliquable : sans le
        pseudo-élément posé sur le lien, le survol aurait promis un clic
        que seuls deux mots du bloc honoraient.

        36/48 et non 56/64 : la carte comptait 46 % de blanc pour 54 % de
        contenu, ce qui la faisait tenir un demi-écran à elle seule. Sous
        900 px elle garde son fond mais perd ses marges généreuses — à
        cette largeur, 48 px de côté ne laisseraient plus de place au
        texte.

        `ease-[ease]` explicite : le raccourci CSS d'origine laissait la
        courbe à `ease`, là où les utilitaires Tailwind appliquent
        `cubic-bezier(.4,0,.2,1)` par défaut. */}
    <div
      class="relative flex flex-col rounded-(--radius-panel) bg-[var(--c-une-bg)] px-12 py-9 transition-[filter] duration-[120ms] ease-[ease] hover:brightness-[0.97] max-mobile:rounded-[18px] max-mobile:px-6 max-mobile:py-8"
    >
      {/* Format à gauche, date à droite — la ligne de tête reprend la
          composition de l'étiquette de section juste au-dessus. La date
          quitte le pied, qui ne garde que l'appel à lire.

          Seule ligne colorée du bloc : elle nomme la famille du panneau
          avant que le titre commence. La valeur vient de --c-une-accent,
          donc changer la famille de la une suffit à la faire suivre. */}
      <div
        class:list={[
          'mb-3.5 flex items-center justify-between gap-4 text-[var(--c-une-accent)]',
          LIGNE_CAPITALES,
        ]}
      >
        <span class="flex items-center">
          <FormatIcon collection={doc.collection} />
          {meta}
        </span>
        {doc.publishedAt && (
          <time
            datetime={new Date(doc.publishedAt).toISOString().slice(0, 10)}
            class:list={['whitespace-nowrap', LIGNE_COURANTE]}
          >
            {formatDateFr(doc.publishedAt)}
          </time>
        )}
      </div>

      {/* Plus grand qu'un titre de carte, plus petit que le hero : la
          hiérarchie de la page se lit à la taille seule — 76 pour le hero,
          42 ici, 32 pour les cartes de format, 22 pour le sommaire.

          La maquette posait 56 px, mais elle le faisait sur un titre de
          quarante signes. Les titres réels de Tituba en font plus de cent :
          à 56 px ils occupaient quatre lignes pleines et la une écrasait le
          hero qu'elle est censée suivre. C'est la longueur du texte, pas la
          maquette, qui commande ici. */}
      <h2 class="m-0 mb-4 font-serif text-[calc(clamp(24px,2.6vw,36px)*var(--a11y-echelle))] leading-heading font-display tracking-display text-balance"><a class="text-[var(--c-une-fg)] after:absolute after:inset-0 after:content-['']" href={href}>{stripHeroMarkers(doc.title)}</a></h2>

      {/* Chapô en italique serif : il prolonge le titre au lieu d'ouvrir
          un nouveau registre, ce qui garde le bloc soudé. Pas de plafond
          de largeur : il prend toute celle de la carte, comme le titre
          au-dessus. Il s'arrêtait auparavant bien avant lui, ce qui
          creusait un décrochage dans le bord droit du bloc. */}
      {doc.lede && <p class="m-0 mb-[22px] font-serif text-[calc(20px*var(--a11y-echelle))] leading-[1.5] font-display text-[var(--c-une-soft)] italic whitespace-pre-line max-mobile:text-lede">{doc.lede}</p>}

      {/* Collé au bas de la carte par `mt-auto`, la hauteur de celle-ci
          étant celle de la rangée de la grille (`items-stretch`). Le carré
          podcast fait de même : les deux pieds sont donc à 36 px du bas de
          deux boîtes de même hauteur, tous deux hauts de 38 px et centrés —
          ils tombent sur la même ligne quel que soit le texte au-dessus, ce
          qui n'était pas le cas tant que ce pied suivait le chapô.

          `min-h-[38px]` est le même plancher que le carré. La rangée tient
          d'ordinaire sa hauteur de la pastille d'initiales, mais celle-ci
          ne s'affiche pas pour un billet non signé : sans ce plancher,
          l'alignement reposerait sur la présence d'un auteur·ice. */}
      <div class="mt-auto flex min-h-[38px] items-center gap-4">
        {/* Pastille d'initiales — le seul aplat rond de la page, et le seul
            endroit où une personne apparaît en tant que telle plutôt que
            comme un nom dans une ligne de métadonnées. Le serif italique y
            remplace le mono du reste du pied : c'est une signature, pas une
            donnée.

            Elle double la signature qui la suit : purement décorative, donc
            masquée à la synthèse vocale, qui lirait sinon « O D » avant le
            nom complet. */}
        {auteurs.length > 0 && (
          <span class="flex size-[38px] flex-none items-center justify-center rounded-full bg-[var(--c-jaune)] font-serif text-[calc(13px*var(--a11y-echelle))] tracking-[0.02em] text-[var(--c-jaune-on)] italic" aria-hidden="true">{initiales(auteurs[0]!)}</span>
        )}
        {signature && <p class="m-0 font-mono text-meta text-[var(--c-une-mute)]">{signature}</p>}
        {/* Sorti de la signature : il doit pouvoir aller au bord droit
            indépendamment d'elle, et il n'y est pas rattaché — c'est
            l'appel du bloc, pas une métadonnée de plus.

            Poussé au bord droit par une marge automatique plutôt que par un
            `justify-between` sur le pied : la pastille et la signature
            gardent leur place à gauche même quand l'une des deux manque, ce
            qu'un `space-between` ne garantirait pas — avec un seul élément
            restant, il le recollerait à gauche.

            Son corps est celui de la signature posée juste à gauche, et non
            les 16 px hérités du corps de texte : l'appel appartient au pied
            de bloc, il en prend l'échelle. Même valeur dans le carré
            podcast, pour que les deux appels de l'accueil pèsent pareil. */}
        <span class="ml-auto border-b border-current pb-px text-meta text-[var(--c-une-fg)] whitespace-nowrap transition-opacity duration-[120ms] ease-[ease] hover:opacity-[0.72]">{appel}</span>
      </div>
    </div>

    {scinde && <slot name="aside" />}
  </div>
</section>
