---
/**
 * Icône loupe du header — même traitement visuel que ThemeToggle.
 * État actif : pastille accent-tint pour marquer qu'on est sur
 * /recherche/ (un simple underline irait mal sur une icône).
 */
interface Props {
  active: boolean;
}

const { active } = Astro.props;
---

<a
  href="/recherche/"
  class:list={['search-link', { active }]}
  aria-label="Rechercher sur Tituba"
  title="Rechercher"
  aria-current={active ? 'page' : undefined}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"/>
    <path d="m20 20-3.5-3.5"/>
  </svg>
</a>

<style>
  .search-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    color: var(--color-muted);
    border-radius: 999px;
    transition: color 0.12s, background-color 0.12s;
  }
  .search-link:hover {
    color: var(--color-ink);
    background: color-mix(in oklch, var(--color-ink), transparent 92%);
  }
  .search-link.active {
    color: var(--c-bleu-deep);
    background: var(--c-bleu-tint);
    font-weight: normal;
  }
  .search-link:focus-visible {
    outline: 2px solid var(--c-bleu-deep);
    outline-offset: 2px;
  }
</style>
