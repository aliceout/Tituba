---
/**
 * Bascule clair/sombre. Les deux icônes sont rendues ; le CSS en cache
 * une selon data-theme — évite de jongler avec le DOM en JS et permet
 * un rendu correct au premier paint (data-theme est posé par le script
 * anti-FOUC de Layout.astro avant le CSS).
 */
interface Props {
  /** Placement, décidé par le parent. Son apparence lui appartient. */
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={[
    'text-muted hover:bg-ink/8 hover:text-ink inline-flex cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-1 transition-colors duration-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--c-bleu-deep)]',
    className,
  ]}
  aria-label="Basculer entre thème clair et sombre"
  title="Basculer le thème"
  data-theme-toggle
>
  <svg class="block sombre:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
  </svg>
  <svg class="hidden sombre:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2"/>
    <path d="M12 20v2"/>
    <path d="m4.93 4.93 1.41 1.41"/>
    <path d="m17.66 17.66 1.41 1.41"/>
    <path d="M2 12h2"/>
    <path d="M20 12h2"/>
    <path d="m6.34 17.66-1.41 1.41"/>
    <path d="m19.07 4.93-1.41 1.41"/>
  </svg>
</button>


<script>
  // Flip data-theme sur <html>, persiste dans localStorage. Le script
  // anti-FOUC du Layout.astro pose le data-theme initial avant le
  // premier paint, donc ici on se contente de réagir aux clics.
  //
  // Sur `astro:page-load` : avec le ClientRouter, un module ne s'exécute
  // qu'une fois par URL, et le bouton du header — reconstruit à chaque
  // échange de document — se retrouverait sans écouteur dès la deuxième
  // page. La réapplication du thème après échange, elle, vit dans le
  // script anti-FOUC du Layout : elle doit courir avant le premier
  // rendu, ce que cet évènement-ci ne garantit pas.
  document.addEventListener('astro:page-load', function () {
    const btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (_) {
        /* private mode — pas grave, le toggle marche pour cette session */
      }
    });
  });
</script>
