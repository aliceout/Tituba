---
/**
 * Menu déroulant générique du header — bouton + chevron + panneau.
 * Utilisé pour « Thématiques » et « Formats », qui partageaient
 * jusqu'ici un markup dupliqué avec juste le contenu qui changeait.
 *
 * Bouton + panneau plutôt que <details> : on garde la main sur la
 * fermeture au clic extérieur et à Échap, que <details> ne gère pas.
 * Sans JavaScript le bouton reste inerte — d'où le lien optionnel du
 * slot `footer`, qui garantit un accès au contenu dans tous les cas.
 *
 * L'ouverture/fermeture (data-nav-menu / data-nav-menu-btn /
 * data-nav-menu-panel) est pilotée par un script partagé entre toutes
 * les instances (cf Header.astro) : un seul contrôleur pour fermer les
 * autres menus quand l'un s'ouvre, plutôt qu'un script par instance.
 */
interface Props {
  label: string;
  active: boolean;
  panelId: string;
}

const { label, active, panelId } = Astro.props;
const hasFooter = Astro.slots.has('footer');
---

<div class="nav-menu" data-nav-menu>
  <button
    type="button"
    class:list={['nav-menu__btn', { active }]}
    aria-expanded="false"
    aria-controls={panelId}
    data-nav-menu-btn
  >
    {label}
    <svg class="chev" width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6"/></svg>
  </button>
  <div class="nav-menu__panel" id={panelId} hidden data-nav-menu-panel>
    <slot />
    {hasFooter && (
      <div class="nav-menu__footer">
        <slot name="footer" />
      </div>
    )}
  </div>
</div>

<style>
  .nav-menu {
    position: relative;
    display: inline-flex;
  }
  .nav-menu__btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: 0;
    padding: 0 0 4px;
    font: inherit;
    color: var(--color-ink);
    cursor: pointer;
    transition: opacity 0.12s;
  }
  .nav-menu__btn:hover {
    opacity: 0.6;
  }
  .nav-menu__btn.active {
    color: var(--color-ink);
    font-weight: 600;
    border-bottom: 1.5px solid var(--c-bleu);
  }
  .nav-menu__btn .chev {
    transition: transform 0.15s;
  }
  /* Le chevron pivote quand le panneau est ouvert : l'état est déjà
     porté par aria-expanded, on s'y accroche plutôt que d'ajouter une
     classe — une seule source de vérité. */
  .nav-menu__btn[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }
  .nav-menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 60;
    min-width: 220px;
    max-height: min(70vh, 460px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    box-shadow: 0 8px 28px rgb(0 0 0 / 12%);
  }
  .nav-menu__panel[hidden] {
    display: none;
  }
  .nav-menu__panel :global(a) {
    display: flex;
    align-items: center;
    padding: 7px 10px;
    border-radius: 5px;
    color: var(--color-ink);
    white-space: nowrap;
    transition: background 0.12s, color 0.12s;
  }
  .nav-menu__panel :global(a:hover),
  .nav-menu__panel :global(a:focus-visible) {
    background: var(--color-rule);
    color: var(--c-bleu-deep);
  }
  .nav-menu__footer {
    margin-top: 4px;
    padding-top: 10px;
    border-top: 1px solid var(--color-rule);
    font-size: 12px;
  }
  .nav-menu__footer :global(a) {
    color: var(--c-bleu-deep);
  }
</style>
