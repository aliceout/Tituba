---
/**
 * Page de détail d'une publication, partagée par les cinq formats.
 *
 * Les routes /articles/<code>/, /analyses/<code>/, /actus/<code>/,
 * /podcasts/<code>/ et /outils/<code>/ sont des enveloppes minces qui
 * délèguent ici en passant leur collection. Ce qui varie d'un format à
 * l'autre — racine d'URL, pastille, libellé de durée, type de citation,
 * lecteur audio ou lien de téléchargement — est résolu depuis la table
 * des formats.
 *
 * Structure :
 *  1. Barre de progression sticky 2 px (via Layout progressBar)
 *  2. Sommaire flottant (ArticleToc), scroll-spy
 *  3. h1 (PageTitle, famille="marque" — la couleur de marque de l'admin,
 *     pas une des quatre familles fixes) + byline + deck
 *  4. Meta-strip (ArticleMeta)
 *  5. Corps Lexical avec lettrine (ArticleBody)
 *  6. Notes classiques en pied (ArticleFootnotes)
 *  7. Bibliographie (ArticleBibliography), tags (ArticleTags), bloc
 *     citation (ArticleCitationBlock), publications liées (ArticleRelated)
 *
 * Chaque bloc listé ci-dessus est un composant autonome sous
 * src/components/article/ — ce fichier n'orchestre plus que le fetch et
 * la composition.
 */
import Layout from '../layouts/Layout.astro';
import ArticleToc from './article/ArticleToc.astro';
import ToolResources from './article/ToolResources.astro';
import ActuBanner from './article/ActuBanner.astro';
import EpisodeCredits from './article/EpisodeCredits.astro';
import ArticleHero from './article/ArticleHero.astro';
import ArticleMeta from './article/ArticleMeta.astro';
import ArticleBody from './article/ArticleBody.astro';
import ArticleFootnotes from './article/ArticleFootnotes.astro';
import ArticleBibliography from './article/ArticleBibliography.astro';
import ArticleTags from './article/ArticleTags.astro';
import ArticleCitationBlock from './article/ArticleCitationBlock.astro';
import ArticleRelated from './article/ArticleRelated.astro';
import ActuBrief from './article/ActuBrief.astro';
import PodcastLaunch from './article/PodcastLaunch.astro';
import PodcastHero from './article/PodcastHero.astro';
import {
  PUBLICATIONS,
  fetchRelatedPosts,
  readingLabelParts,
  type BiblioEntry,
  type PublicationCollection,
  type PublicationPost,
  type PublicationTheme,
  type PublicationTag,
} from '../lib/publications';
import { audioFileUrl, fetchIdentity, fetchSite, mediaUrl, uploadedImageUrl } from '../lib/payload';
import {
  extractToc,
  renderLexicalSidenotes,
  renderLexicalWithFootnotes,
} from '../lib/lexical';
import {
  formatDateFr,
  formatHeroTitle,

  formatPostAuthorsForDisplay,
  formatPostCitationChicago,
  stripHeroMarkers,
  type PostAuthorEntry,
} from '../lib/site';
import { highwireMeta } from '../lib/citations';
import { afficherBrief, afficherSommaire, dateDansColonne } from '../lib/article/affichage';
import { lireCouverture } from '../lib/article/couverture';
import { lireEpisode } from '../lib/article/episode';
import { DECK } from '../lib/article/classes';
import { libellePublic, lireRessources } from '../lib/article/ressources';

export interface Props {
  collection: PublicationCollection;
  /**
   * Le billet, déjà chargé par la route.
   *
   * Ce composant allait le chercher lui-même et répondait 404 quand il
   * ne le trouvait pas — mais un composant est rendu une fois la
   * réponse commencée : le `rewrite` levait alors un
   * `ResponseSentError`, et les adresses mortes repartaient en 200,
   * donc indexables. Décider qu'une page n'existe pas revient à la
   * route (cf `fetchPublicationPubliee`), qui peut encore choisir sa
   * réponse.
   */
  post: PublicationPost;
}

const { collection, post } = Astro.props as Props;
const spec = PUBLICATIONS[collection];

const themes = (post.themes ?? []).filter(
  (t): t is PublicationTheme => typeof t === 'object' && t !== null && 'slug' in t,
);
const primaryTheme = themes[0];

// Titre : les *astérisques* saisies dans l'admin deviennent des <em>
// surlignés dans le h1 (même mécanisme que les autres heros du site,
// cf PageTitle) — mais partout ailleurs où ce même titre sert de texte
// brut (onglet du navigateur, citation, méta Highwire, « Dans le même
// thème »), les astérisques doivent disparaître sans laisser de trace.
const titleHtml = formatHeroTitle(post.title);
const titlePlain = stripHeroMarkers(post.title);

// Image de couverture, cadrage, crédit — cf lib/article/couverture.
// L'image de la série sert de fond au hero d'un épisode : au premier
// plan la couverture de l'épisode, derrière l'identité de l'émission,
// ce qui fait qu'on reconnaît la seconde avant d'avoir lu le titre du
// premier. Sans série, on retombe sur la couverture de l'épisode.
const serie = post.series && typeof post.series === 'object' ? post.series : null;
const couverture = lireCouverture(post.image, serie?.image ?? null);
const coverImageUrl = couverture.url;
const serieImageUrl = couverture.fondUrl;
const coverImageAlt = couverture.alt;
const cropStyle = couverture.cadrage;
const unsplashCredit = couverture.credit;

// Épisode de podcast — cf lib/article/episode.
const episode = lireEpisode(post.audio, post.guests, Boolean(coverImageUrl));
const audioSrc = episode.audioSrc;
const guestLabel = episode.invitees;
const heroPlayer = episode.lecteurDansHero;

const publishedFr = formatDateFr(post.publishedAt);
const publishedIso = new Date(post.publishedAt).toISOString().slice(0, 10);
const readingLabel = readingLabelParts(collection, {
  readingTime: post.readingTime,
  durationSeconds: post.durationSeconds,
});

// Site global → mode d'affichage des notes (classique en pied /
// sidenotes en marge). Identity global → wordmark utilisé dans la
// citation + les méta Highwire.
type SiteData = { reading?: { notesMode?: 'classic' | 'sidenotes' } };
type IdentityGlobal = { siteName?: string };
let site: SiteData = {};
let identity: IdentityGlobal = {};
try {
  site = await fetchSite<SiteData>();
} catch (err) {
  console.warn('[article] fetchSite failed:', (err as Error).message);
}
try {
  identity = await fetchIdentity<IdentityGlobal>();
} catch (err) {
  console.warn('[article] fetchIdentity failed:', (err as Error).message);
}
const notesMode: 'classic' | 'sidenotes' =
  site.reading?.notesMode === 'sidenotes' ? 'sidenotes' : 'classic';
const siteName = identity.siteName?.trim() || 'Tituba';

// Body HTML rendu côté serveur depuis Lexical. En mode classique, on
// récupère bodyHtml + footnotesHtml (notes empilées en pied). En mode
// sidenotes, le rendu interleave les <aside class="marg"> juste après
// chaque bloc concerné — pas de footnotesHtml séparé.
// La bibliographie du billet, puis sa numérotation.
//
// Les numéros suivent l'ordre d'apparition dans le texte, et c'est le
// rendu qui les attribue au fil de sa lecture : la première source
// citée est la 1. La liste est ensuite rangée dans ce même ordre, si
// bien que « [12] » dans le corps et la douzième ligne en bas sont la
// même référence.
const biblioBrute = (post.bibliography ?? []).filter(
  (b): b is BiblioEntry => typeof b === 'object' && b !== null && 'slug' in b,
);
const numerotation = {
  permis: new Set(biblioBrute.map((b) => b.slug)),
  rang: new Map<string, number>(),
};

const bodyHtml =
  notesMode === 'sidenotes'
    ? renderLexicalSidenotes(post.body, numerotation)
    : renderLexicalWithFootnotes(post.body, numerotation).bodyHtml;
const footnotesHtml =
  notesMode === 'classic'
    ? renderLexicalWithFootnotes(post.body, numerotation).footnotesHtml
    : '';
const tocEntries = extractToc(post.body);

// Les citées d'abord, dans l'ordre où le texte les appelle ; les autres
// à la suite. Une référence listée mais jamais citée garde ainsi sa
// place, sans décaler la numérotation de celles qui le sont.
const biblio = [
  ...biblioBrute
    .filter((b) => numerotation.rang.has(b.slug))
    .sort((a, b) => numerotation.rang.get(a.slug)! - numerotation.rang.get(b.slug)!),
  ...biblioBrute.filter((b) => !numerotation.rang.has(b.slug)),
];

// Affichage de l'aside — décidé ici et nulle part ailleurs : c'est la
// même valeur qui monte le composant et qui réserve sa colonne dans la
// grille (`no-toc`). Deux conditions séparées finiraient par diverger.
//
// Le seuil n'est pas « y a-t-il des titres de section » mais « y a-t-il
// quelque chose à offrir » : un billet d'analyse court n'a souvent aucun
// titre, alors que la durée de lecture, les liens de pied et les actions
// (copier, citer, télécharger) lui sont tout aussi utiles.
/**
 * Un billet d'actu est un format chaud, « volontairement bref, sans
 * appareil » — ce sont les mots de sa propre collection. Il n'a donc ni
 * sommaire, ni bouton « Citer cet article », ni export PDF : proposer de
 * citer un rebond d'actualité d'une minute offre un geste qui n'a pas
 * lieu d'être, et un sommaire d'une entrée n'aide personne.
 *
 * Conséquence à ne pas manquer : sans aside, la colonne de texte hérite
 * de toute la largeur du gabarit. Les autres formats sont sauvés malgré
 * eux — l'aside leur prend 300 px et ramène le texte à une largeur
 * lisible. L'actu doit donc se resserrer elle-même (cf .shell--actu).
 */
const estActu = collection === 'actus';

/**
 * Ressource d'un outil.
 *
 * Ce format existe pour transmettre un fichier ou une adresse ; son
 * corps de texte est facultatif et ne fait que la présenter. Le champ
 * est d'ailleurs obligatoire à la saisie — mais il n'était lu nulle
 * part, si bien que la page d'un outil ne donnait aucun accès à ce
 * qu'elle annonce.
 */
const estOutil = collection === 'outils';
const ressources = estOutil ? lireRessources(post.resources) : [];
const publicVise = estOutil ? libellePublic(post.audience) : '';

// Ce que la page montre — cf lib/article/affichage.
const contexteAffichage = {
  collection,
  citable: spec.citationType === 'article',
  nbEntreesSommaire: tocEntries.length,
  aUneDuree: Boolean(readingLabel),
  aDesNotes: Boolean(footnotesHtml),
  nbReferences: biblio.length,
  aUnBrief: Boolean(post.enBref?.trim()),
  lecteurDansHero: heroPlayer,
};
const afficherToc = afficherSommaire(contexteAffichage);
const afficherLeBrief = afficherBrief(contexteAffichage);

/**
 * La page se scinde en deux colonnes sous le hero. Une seule condition
 * décide de monter l'aside ET de réserver sa colonne : deux conditions
 * séparées finiraient par diverger — une colonne vide, ou l'inverse.
 */
const avecColonne = afficherToc || afficherLeBrief;

/**
 * Écart entre le header et le premier bloc. Nul quand le hero pleine
 * largeur d'un épisode s'appuie contre le header, et nul aussi pour les
 * billets d'analyse, les articles de recherche et les actus : leur
 * surtitre de format tient lieu d'entrée en matière, et l'écart de
 * <main> suffit à le décoller du header. Les deux existent pour poser un
 * titre dans du blanc — une image qui va jusqu'aux bords n'en a pas
 * besoin.
 */
const sansEcartHaut =
  heroPlayer || estActu || collection === 'analyses' || collection === 'articles';

/**
 * Deux fois la largeur habituelle pour le rappel des faits d'une actu.
 * La colonne des autres formats porte un sommaire — une liste de titres
 * courts, qui tient dans 220 px. Celle-ci porte des phrases : à la même
 * largeur, elles se hachaient en lignes de six ou sept mots, ce qui se
 * lit mal et fait paraître le bloc plus long qu'il n'est.
 */
const COLONNES = estActu ? 'large:grid-cols-[440px_1fr]' : 'large:grid-cols-[1fr_220px]';
const dateDansAside = dateDansColonne(contexteAffichage);
  afficherToc && (heroPlayer || collection === 'analyses' || collection === 'articles');

const related = await fetchRelatedPosts(collection, primaryTheme?.slug, post.id);

// Auteur·ices du billet — affichage dans le meta-strip (interne =
// cliquable vers /auteurice/<id>/, externe = texte simple) et signature
// Chicago dans le bloc « Pour citer ». Cf issue #2.
const postAuthors = (post.authors ?? []) as PostAuthorEntry[];
const displayAuthors = formatPostAuthorsForDisplay(postAuthors);
const postCitation = formatPostCitationChicago(postAuthors);

// Si le billet n'a aucun·e auteur·ice renseigné·e (cas legacy ou
// ratage), on tombe sur un placeholder neutre. Chaque user a son
// propre `citationFormat` (cf Mon compte) qui surcharge l'heuristique
// dans formatPostCitationChicago.
const authorCitation = postCitation || 'Auteur·ice';

// Citation bibliographique du billet (Chicago author-date façon Tituba)
const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();
const citationText = `${authorCitation}. « ${titlePlain} », ${siteName}, ${publishedFr}, ${articleUrl}.`;

// Métadonnées Highwire/Google Scholar pour que l'extension Zotero
// détecte automatiquement la citation à la visite de l'article (sans
// que l'utilisatrice ait besoin de cliquer un bouton).
const citationMeta = highwireMeta(
  {
    title: titlePlain,
    publishedAt: post.publishedAt,
    authors: postAuthors,
  },
  { articleUrl, accessedAt: new Date().toISOString().slice(0, 10), siteName },
);

const postTags = (post.tags ?? []).filter(
  (t): t is PublicationTag => typeof t === 'object' && t !== null,
);
---

<Layout
  title={titlePlain}
  description={post.lede}
  progressBar={true}
  sansFilet={heroPlayer}
  bodyClass={`justify notes-${notesMode}`}
>
  <Fragment slot="head">
    {citationMeta.map((m) => (
      <meta name={m.name} content={m.content} />
    ))}
  </Fragment>

  {/**
   * --repere-h : hauteur du bloc qui ouvre chaque colonne, et
   * respiration avant son filet.
   *
   * Deux blocs ouvrent la page côte à côte : le générique dans la
   * colonne de texte (« Un épisode avec … ») et les repères dans l'aside
   * (« Temps d'écoute », « Publié »). Leurs filets doivent tomber sur la
   * même ligne — deux traits décalés de vingt pixels se lisent comme un
   * défaut de calage, pas comme une intention.
   *
   * La valeur est posée ICI, une seule fois, et lue par les deux (cf
   * EpisodeCredits et ArticleToc). C'est le point : chacun calculait
   * auparavant sa hauteur dans son coin, à partir de son propre contenu
   * — une ligne d'un côté, deux de l'autre — et rien ne garantissait
   * qu'ils tombent d'accord. Une hauteur partagée ne peut pas diverger.
   *
   * Sa valeur est celle de l'aside : deux lignes de 10 px à interligne
   * 1,5, les 18 px qui les séparent, et les 18 px avant le filet. Écrite
   * en clair plutôt qu'en nombre rond, elle suit le réglage de taille du
   * panneau d'accessibilité — un 66px figé aurait décroché au premier
   * agrandissement.
   *
   * C'est une hauteur TOTALE, marge intérieure comprise, parce que
   * Tailwind pose box-sizing: border-box sur tout : un min-height
   * englobe ici le padding, il ne s'y ajoute pas. La version précédente
   * comptait l'inverse, d'où un générique de 48 px en face d'un aside de
   * 66 — l'écart valait exactement la marge oubliée.
   */}
  <div
    class:list={[
      '[--repere-h:calc(10px*var(--a11y-echelle)*1.5*2+18px+18px)] [--repere-pad:18px]',
      sansEcartHaut ? 'pt-0' : 'pt-[75px]',
      'max-mobile:pt-6',
    ]}
  >

    {/* Cibles d'ancres du sommaire : on offre une marge de défilement
        pour que l'élément cliqué arrive au tiers du haut de la fenêtre
        plutôt que collé sous le header. Étalées sur plusieurs composants
        (ArticleBody, ArticleFootnotes, ArticleBibliography,
        ArticleCitationBlock), la coordination vit ici — une variante
        descendante les atteint tous, y compris le HTML de l'éditeur.

        « Haut de page » fait exception : il ramène au tout début de
        l'article, avec juste assez de marge pour ne pas se retrouver sous
        le header. */}
    <article
      class="scroll-mt-24 [&_#biblio]:scroll-mt-[33vh] [&_#cite]:scroll-mt-[33vh] [&_#intro]:scroll-mt-[33vh] [&_#notes]:scroll-mt-[33vh] [&_h2]:scroll-mt-[33vh] [&_h3]:scroll-mt-[33vh]"
      id="haut"
    >
      {/* Essai en cours sur les épisodes : hero pleine largeur, la
          couverture en fond flouté et reprise nette en carré à gauche
          du titre (cf PodcastHero). Les autres formats gardent le hero
          encadré. */}
      {heroPlayer && (
        <PodcastHero
          titleHtml={titleHtml}
          titlePlain={titlePlain}
          lede={post.lede}
          coverUrl={coverImageUrl!}
          coverAlt={coverImageAlt}
          backgroundUrl={serieImageUrl}
          serieName={serie?.name ?? null}
          serieSlug={serie?.slug ?? null}
          formatLabel={spec.labelSingular}
          collection={collection}
          audioSrc={audioSrc}
          durationSeconds={post.durationSeconds}
          href={Astro.url.pathname}
          credit={unsplashCredit}
          authors={displayAuthors}
          themeName={primaryTheme ? primaryTheme.name : null}
          themeSlug={primaryTheme ? primaryTheme.slug : null}
        />
      )}

      {/* Format en surtitre, sur le gabarit des étiquettes de section de
          l'accueil (« À la une », « Au sommaire ») : mêmes fonte, corps
          et interlettrage. C'est la même nature d'objet — un intitulé
          qui dit ce qu'on regarde avant de le regarder — et deux
          traitements distincts n'auraient rien apporté. */}
      {/* Bandeau d'une actu — au-dessus de tout, pleine largeur de la
          colonne. Pas de cadre à côté du titre comme sur un billet
          d'analyse : sur un format court, une image qui prend la parole
          en premier fait ce que fait une photo de presse, elle donne
          l'objet avant la phrase. */}
      {estActu && coverImageUrl && (
        <ActuBanner url={coverImageUrl} alt={coverImageAlt} credit={unsplashCredit} />
      )}

      {!heroPlayer && (
        <ArticleHero
          collection={collection}
          formatLabel={spec.labelSingular}
          titleHtml={titleHtml}
          lede={estActu ? null : post.lede}
          credit={estActu ? null : unsplashCredit}
          coverUrl={estActu ? null : coverImageUrl}
          coverAlt={coverImageAlt}
          cadrage={cropStyle}
        />
      )}

      {/* Pas de bandeau sur un épisode : le hero pleine largeur porte
          déjà la signature, la thématique et la date, et le format en
          surtitre. Le laisser aurait redit la même chose dix
          centimètres plus bas.

          Pas de bandeau non plus sur une actu, pour une autre raison :
          deux valeurs dans une grille encadrée de deux filets, c'est un
          appareil de publication savante posé sur un rebond d'une
          minute. Elles se replient en une ligne sous le chapô. */}
      {!heroPlayer && !estActu && (
        <ArticleMeta
          authors={displayAuthors}
          publishedFr={publishedFr}
          publishedIso={publishedIso}
          themes={themes}
          showPublished={!dateDansAside}
        />
      )}

      {/* Épisode sans couverture : le bouton se pose sous le bandeau
          meta, faute de cadre où se loger (cf heroPlayer). */}
      {!heroPlayer && audioSrc && (
        <p class="m-0 mb-10">
          <PodcastLaunch
            src={audioSrc}
            durationSeconds={post.durationSeconds}
            title={titlePlain}
            coverUrl={coverImageUrl}
            href={Astro.url.pathname}
          />
        </p>
      )}

      {/* Hero et bandeau meta courent sur toute la largeur ; c'est ici
          seulement que la page se scinde en deux colonnes, texte et
          aside. */}
      {/* La scission ne porte pas sur toute la page mais sur le seul
          corps de l'article : le hero et le bandeau meta courent sur
          toute la largeur, et c'est en dessous que le texte cède sa place
          à l'aside. Sous 1300 px, pas de scission — l'aside n'est pas
          affiché, le texte occupe tout.

          `items-start` est nécessaire : sans lui, la grille étire l'aside
          (l'élément le plus court) à la hauteur de la ligne, sa boîte
          devient aussi haute que le texte, et il ne reste plus aucune
          marge pour que le collage puisse le déplacer — il se comporte
          alors comme un élément statique. */}
      <div class:list={[avecColonne && `large:grid large:items-start large:gap-x-[52px] ${COLONNES}`]}>
        {/* Avant la colonne principale dans le document, et pas seulement
            à gauche à l'écran : une colonne qu'on lit en premier doit
            être rencontrée en premier au clavier et au lecteur d'écran.
            Le rappel des faits ouvre la lecture — il précède donc le
            billet dans les deux ordres. */}
        {/* C'est la colonne qui colle, et non chacun des deux blocs —
            imbriqués, deux collages se contraignent l'un l'autre et se
            figent à contretemps. Même hauteur d'arrêt que le sommaire
            des autres formats, pour qu'un lecteur passant d'un billet
            d'analyse à une actu ne voie pas la colonne s'arrêter deux
            fois au même endroit à des hauteurs différentes.

            Le bloc commun y perd son propre collage et son écart haut :
            c'est la colonne qui les porte désormais, et il vient se
            poser sous le résumé plutôt que d'ouvrir la colonne. */}
        {afficherLeBrief && (
          <div class="[&_.toc]:border-rule sticky top-[183px] [&_.toc]:static [&_.toc]:mt-[18px] [&_.toc]:border-t [&_.toc]:pt-[18px] [&_.toc]:top-auto">
            <ActuBrief texte={post.enBref!} sources={post.sources ?? null} />
            {/* Le même bloc que les autres formats, monté sans entrées :
                une actu n'a pas de plan, mais elle a une date, une durée
                de lecture, une adresse à copier et un PDF à emporter.
                Le remonter tel quel plutôt que d'en recopier les quatre
                boutons évite d'avoir un jour deux « copier le lien » qui
                se comportent différemment. */}
            <ArticleToc
              entries={[]}
              readingLabel={readingLabel}
              hasFootnotes={!!footnotesHtml}
              hasBiblio={biblio.length > 0}
              hasCitation={spec.citationType === 'article'}
              audioSrc={null}
              audioTitle={titlePlain}
              publishedFr={publishedFr}
              publishedIso={publishedIso}
            />
          </div>
        )}
        {/* Plus de plafond à poser sur le chapô : descendu dans la
            colonne principale, il en prend la largeur tout seul. */}
        <div class="large:min-w-0">
      {/* Générique, en tête des notes et non dans le hero : c'est ce
          qu'on lit sur l'épisode, pas la carte de visite qui l'annonce.
          Traité comme les repères de l'aside — intitulé en petites
          capitales, valeur en corps de lecture — et fermé par un filet
          qui le sépare du texte : sans lui, la ligne se confondait avec
          un premier paragraphe très court. */}
      {guestLabel && (
        <EpisodeCredits invitees={guestLabel} />
      )}

      {/* La ressource, en tête du billet et non en pied : c'est ce que
          l'outil sert à transmettre, le texte n'en est que la
          présentation. Quelqu'un qui connaît déjà l'outil doit pouvoir
          y accéder sans lire, et quelqu'un qui découvre doit voir tout
          de suite qu'il y a quelque chose à prendre. */}
      <ToolResources ressources={ressources} publicVise={publicVise} />

      {/* Chapô et ligne de méta d'une actu — en tête de la colonne
          principale et non dans le hero, pour partager leur rangée avec
          le rappel des faits d'à côté (cf ActuBrief). */}
      {estActu && <p class:list={[DECK, 'mt-0']}>{post.lede}</p>}
      {estActu && ((displayAuthors && displayAuthors.length > 0) || primaryTheme) && (
        <p class="text-muted m-0 mt-[18px] flex flex-wrap items-baseline gap-0.5 font-sans text-[calc(14px*var(--a11y-echelle))] [&_a]:border-rule [&_a]:border-b [&_a]:text-inherit [&_a]:transition-[color,border-color] [&_a]:duration-[120ms] [&_a:hover]:text-ink [&_a:hover]:border-b-ink">
          {displayAuthors && displayAuthors.length > 0 && (
            <span>
              {displayAuthors.map((a, i) => (
                <Fragment>
                  {i > 0 && (i === displayAuthors.length - 1 ? ' et ' : ', ')}
                  {a.href ? <a href={a.href}>{a.name}</a> : a.name}
                </Fragment>
              ))}
            </span>
          )}
          {/* Le point médian sépare deux valeurs — il n'apparaît donc que
              s'il y en a bien deux. Un billet non signé affichait sinon
              « · Genre et politiques », une ponctuation ouvrant sur
              rien. */}
          {primaryTheme && (
            <>
              {displayAuthors && displayAuthors.length > 0 && (
                <span class="mx-2 opacity-50" aria-hidden="true">·</span>
              )}
              <a href={`/theme/${primaryTheme.slug}/`}>{primaryTheme.name}</a>
            </>
          )}
        </p>
      )}

      <ArticleBody html={bodyHtml} />

      {footnotesHtml && <ArticleFootnotes html={footnotesHtml} />}

      <div class="mt-12">
        {biblio.length > 0 && <ArticleBibliography entries={biblio} />}
        {postTags.length > 0 && <ArticleTags tags={postTags} />}
        {spec.citationType === 'article' && (
          <ArticleCitationBlock
            authorCitation={authorCitation}
            title={titlePlain}
            publishedFr={publishedFr}
            articleUrl={articleUrl}
            citationText={citationText}
            routePrefix={spec.routePrefix}
            docId={post.publicId}
          />
        )}
        {related.length > 0 && primaryTheme && (
          <ArticleRelated collection={collection} items={related} />
        )}
      </div>
        </div>
        {afficherToc && (
          <ArticleToc
            entries={tocEntries}
            readingLabel={readingLabel}
            hasFootnotes={!!footnotesHtml}
            hasBiblio={biblio.length > 0}
            hasCitation={spec.citationType === 'article'}
            audioSrc={audioSrc}
            audioTitle={titlePlain}
            publishedFr={dateDansAside ? publishedFr : null}
            publishedIso={publishedIso}
          />
        )}
      </div>
    </article>
  </div>
</Layout>
