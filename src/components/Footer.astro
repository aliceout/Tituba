---
/**
 * Footer 3 colonnes — signature + baseline + licence (col 1),
 * « Formats » (col 2), « Naviguer » (col 3).
 *
 * La colonne des formats est dérivée de la table PUBLICATIONS plutôt que
 * saisie : ajouter un sixième format le ferait apparaître ici sans autre
 * geste, et il ne peut pas y avoir de divergence entre ce que le pied
 * annonce et ce que le site sert réellement.
 *
 * Lit deux globals Payload : Identity (siteName/baseline/copyright) et
 * Navigation (navFooter). Si Payload n'est pas joignable au SSR, on
 * retombe sur des defaults — le footer reste affichable sans la DB.
 */
import { fetchIdentity, fetchNavigation } from '../lib/payload';
import { PUBLICATIONS, PUBLICATION_ORDER } from '../lib/publications';

type NavFooterLink = {
  label: string;
  href: string;
  external?: boolean;
};

type IdentityGlobal = {
  siteName?: string;
  baseline?: string;
  copyrightLine?: string;
};

type NavigationGlobal = {
  navFooter?: NavFooterLink[];
};

// Fallbacks génériques — utilisés uniquement si Payload est down ou
// si les globals n'ont pas encore été remplis côté admin.
const DEFAULT_BASELINE = 'Collectif féministe intersectionnel. Auto-hébergé.';
const DEFAULT_COPYRIGHT = 'CC BY-NC-SA 4.0';

// Reprend les onglets du header, plus l'accès à l'administration.
const DEFAULT_NAV: NavFooterLink[] = [
  { label: 'Formats', href: '/formats/' },
  { label: 'Thématiques', href: '/themes/' },
  { label: 'Auteur·ices', href: '/auteurices/' },
  { label: 'Archives', href: '/archives/' },
  { label: "L'association", href: '/association/' },
  { label: 'Nous rejoindre', href: '/nous-rejoindre/' },
  { label: 'Admin', href: '/cms/admin' },
];

let identity: IdentityGlobal = {};
let nav: NavigationGlobal = {};
try {
  identity = await fetchIdentity<IdentityGlobal>();
} catch (err) {
  console.warn('[footer] fetchIdentity failed, using defaults:', (err as Error).message);
}
try {
  nav = await fetchNavigation<NavigationGlobal>();
} catch (err) {
  console.warn('[footer] fetchNavigation failed, using defaults:', (err as Error).message);
}

const siteName = identity.siteName?.trim() || 'Tituba';
const baseline = identity.baseline || DEFAULT_BASELINE;
// Tag git injecté au build du container (process.env.GIT_TAG).
// Fallback 'dev' si non défini (build local ou CI sans build-args).
const gitTag = process.env.GIT_TAG || 'dev';
const copyrightLine = identity.copyrightLine || DEFAULT_COPYRIGHT;
const navFooter = nav.navFooter && nav.navFooter.length > 0 ? nav.navFooter : DEFAULT_NAV;

// Un paragraphe par ligne saisie dans l'admin, plutôt qu'un seul bloc
// laissé à `white-space: pre-line`. Deux raisons : ce sont deux énoncés
// distincts — ce que fait l'association, puis comment le site est servi
// — donc deux paragraphes est le balisage juste ; et la variante CSS
// n'a pas fonctionné ici, la déclaration disparaissant de la feuille
// compilée alors que le reste de la même règle s'appliquait.
const baselineLignes = baseline
  .split(/\r?\n/)
  .map((l) => l.trim())
  .filter(Boolean);

// Les cinq formats, dans l'ordre éditorial, lus depuis la table qui fait
// déjà autorité sur leurs libellés et leurs racines d'URL.
const formatLinks = PUBLICATION_ORDER.map((c) => ({
  label: PUBLICATIONS[c].labelPlural,
  href: `${PUBLICATIONS[c].routePrefix}/`,
}));
---

<footer class="site">
  <div class="container">
    <div class="grid">
      <div>
        <div class="brand-foot">{siteName}<span class="dot">.</span></div>
        {baselineLignes.map((l) => <p>{l}</p>)}
        <div class="mono copyright">{copyrightLine}</div>
        <div class="mono version">Version : {gitTag}</div>
      </div>
      <div>
        <h4>Formats</h4>
        <div class="links">
          {formatLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
      <div>
        <h4>Naviguer</h4>
        <div class="links">
          {navFooter.map((link) => (
            <a
              href={link.href}
              rel={link.external ? 'noopener' : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  footer.site {
    background: var(--color-bg);
    border-top: 1px solid var(--color-rule);
    margin-top: var(--block-gap);
    padding: 64px 0 56px;
  }
  footer.site .container {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }
  footer.site .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 56px;
    font-family: var(--font-sans);
    font-size: calc(13px * var(--a11y-echelle));
    color: var(--color-ink);
  }
  /* Mono largement interlettré, comme « À LA UNE », « AU SOMMAIRE » et
     « LA LETTRE » plus haut. C'était du sans demi-gras à 0,08em : le
     footer était le seul endroit du site où une étiquette de section
     parlait une autre langue typographique. */
  footer.site h4 {
    font-family: var(--font-mono);
    font-size: calc(11px * var(--a11y-echelle));
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 14px;
    font-weight: 400;
  }
  footer.site .links {
    display: grid;
    gap: 6px;
  }
  footer.site .links a {
    color: var(--color-ink);
    transition: color 0.12s;
  }
  /* Bleu de famille, comme le filet de l onglet actif du header.
     C etait --color-accent, le violet pilotable depuis l admin, qui
     jure avec la palette de l accueil. */
  footer.site .links a:hover {
    color: var(--c-bleu-deep);
  }
  /* Meme graphie que le wordmark du header : italique bas-de-casse en
     graisse 400, point droit en jaune profond. Le footer affichait
     jusqu ici un « Tituba. » capitale droite demi-gras — deux graphies
     du meme nom sur une seule page. */
  footer.site .brand-foot {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: calc(22px * var(--a11y-echelle));
    font-weight: 400;
    text-transform: lowercase;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  footer.site .brand-foot .dot {
    color: var(--c-jaune-deep);
    font-style: normal;
  }
  footer.site p {
    font-family: var(--font-serif);
    font-size: calc(15px * var(--a11y-echelle));
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
    max-width: 460px;
  }
  /* Deuxieme ligne de baseline : rapprochee de la premiere, elles
     forment un seul bloc de sens malgre les deux paragraphes. */
  footer.site p + p {
    margin-top: 4px;
  }
  footer.site .copyright {
    font-size: calc(11px * var(--a11y-echelle));
    color: var(--color-muted);
    margin-top: 24px;
  }
  footer.site .version {
    font-size: calc(11px * var(--a11y-echelle));
    color: var(--color-muted);
    margin-top: 4px;
  }

  @media (max-width: 900px) {
    footer.site .container {
      padding: 0 var(--page-gutter-narrow);
    }
    footer.site .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
