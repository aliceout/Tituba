---
/**
 * Footer 4 colonnes — signature + baseline + licence (col 1),
 * « Formats » (col 2), « Naviguer » (col 3), « Coulisses » (col 4).
 *
 * Les deux dernières se distinguent par ce qu'elles désignent :
 * « Naviguer » mène au contenu du site, « Coulisses » à son envers —
 * l'administration, le suivi des tickets, le formulaire de contact.
 *
 * La colonne des formats est dérivée de la table PUBLICATIONS plutôt que
 * saisie : ajouter un sixième format le ferait apparaître ici sans autre
 * geste, et il ne peut pas y avoir de divergence entre ce que le pied
 * annonce et ce que le site sert réellement.
 *
 * Lit deux globals Payload : Identity (siteName/baseline/copyright) et
 * Navigation (navFooter). Si Payload n'est pas joignable au SSR, on
 * retombe sur des defaults — le footer reste affichable sans la DB.
 */
import { fetchIdentity, fetchNavigation } from '../lib/payload';
import { PUBLICATIONS, PUBLICATION_ORDER } from '../lib/publications';

type NavFooterLink = {
  label: string;
  href: string;
  external?: boolean;
};

type IdentityGlobal = {
  siteName?: string;
  baseline?: string;
  copyrightLine?: string;
};

type NavigationGlobal = {
  navFooter?: NavFooterLink[];
  navFooterCoulisses?: NavFooterLink[];
};

// Fallbacks génériques — utilisés uniquement si Payload est down ou
// si les globals n'ont pas encore été remplis côté admin.
const DEFAULT_BASELINE = 'Collectif féministe intersectionnel. Auto-hébergé.';
const DEFAULT_COPYRIGHT = 'CC BY-NC-SA 4.0';

// Les grandes destinations du site — ce qu'on va y lire.
const DEFAULT_NAV: NavFooterLink[] = [
  { label: 'Formats', href: '/formats/' },
  { label: 'Thématiques', href: '/themes/' },
  { label: 'Auteur·ices', href: '/auteurices/' },
  { label: 'Mots-clés', href: '/tags/' },
  { label: 'Archives', href: '/archives/' },
  { label: "L'association", href: '/association/' },
];

// Colonne « Coulisses » — l'envers du site plutôt que son contenu. Le
// suivi des tickets n'y figure pas : il vient de la configuration
// (TICKETING_URL), pas de cette liste éditoriale.
const DEFAULT_COULISSES: NavFooterLink[] = [
  { label: 'Nous rejoindre', href: '/nous-rejoindre/' },
  { label: 'Nous écrire', href: '/contact/' },
  { label: 'Admin', href: '/cms/admin' },
];

let identity: IdentityGlobal = {};
let nav: NavigationGlobal = {};
try {
  identity = await fetchIdentity<IdentityGlobal>();
} catch (err) {
  console.warn('[footer] fetchIdentity failed, using defaults:', (err as Error).message);
}
try {
  nav = await fetchNavigation<NavigationGlobal>();
} catch (err) {
  console.warn('[footer] fetchNavigation failed, using defaults:', (err as Error).message);
}

const siteName = identity.siteName?.trim() || 'Tituba';
const baseline = identity.baseline || DEFAULT_BASELINE;
// Tag git injecté au build du container (process.env.GIT_TAG).
// Fallback 'dev' si non défini (build local ou CI sans build-args).
const gitTag = process.env.GIT_TAG || 'dev';
const copyrightLine = identity.copyrightLine || DEFAULT_COPYRIGHT;
const navFooter = nav.navFooter && nav.navFooter.length > 0 ? nav.navFooter : DEFAULT_NAV;
// Un lien sans adresse est écarté plutôt qu'affiché mort.
const coulissesSaisies = (
  nav.navFooterCoulisses && nav.navFooterCoulisses.length > 0
    ? nav.navFooterCoulisses
    : DEFAULT_COULISSES
).filter((l) => l.href && l.href.trim());

/**
 * Suivi des tickets — ajouté depuis la configuration, pas depuis
 * l'admin.
 *
 * C'est une adresse d'infrastructure : elle change le jour où l'on
 * change de service, pas au gré d'une décision éditoriale. La saisir
 * dans Payload aurait mis une donnée de déploiement dans la base de
 * contenu, et obligé à la retaper sur chaque environnement.
 *
 * Absente, le lien ne s'affiche pas : un service qu'on n'a pas encore
 * ne doit pas laisser d'entrée morte dans le pied.
 */
const ticketing = (process.env.TICKETING_URL ?? '').trim();
const navCoulisses =
  ticketing && !coulissesSaisies.some((l) => l.href === ticketing)
    ? [...coulissesSaisies, { label: 'Suivi des tickets', href: ticketing, external: true }]
    : coulissesSaisies;

// Un paragraphe par ligne saisie dans l'admin, plutôt qu'un seul bloc
// laissé à `white-space: pre-line`. Deux raisons : ce sont deux énoncés
// distincts — ce que fait l'association, puis comment le site est servi
// — donc deux paragraphes est le balisage juste ; et la variante CSS
// n'a pas fonctionné ici, la déclaration disparaissant de la feuille
// compilée alors que le reste de la même règle s'appliquait.
const baselineLignes = baseline
  .split(/\r?\n/)
  .map((l) => l.trim())
  .filter(Boolean);

// Les cinq formats, dans l'ordre éditorial, lus depuis la table qui fait
// déjà autorité sur leurs libellés et leurs racines d'URL.
const formatLinks = PUBLICATION_ORDER.map((c) => ({
  label: PUBLICATIONS[c].labelPlural,
  href: `${PUBLICATIONS[c].routePrefix}/`,
}));

/**
 * Intitulé de colonne. En <h2> et non en <h4> : il suit un <h2> de la
 * page, et sauter deux niveaux fait perdre le fil à qui parcourt le
 * document par ses titres — axe le signalait sur vingt-huit pages sur
 * trente et une, le pied étant partout.
 *
 * Mono largement interlettré, comme « À LA UNE », « AU SOMMAIRE » et
 * « LA LETTRE » plus haut. C’était du sans demi-gras à 0,08 em : le pied
 * était le seul endroit du site où une étiquette de section parlait une
 * autre langue typographique.
 */
const INTITULE =
  'text-muted m-0 mb-3.5 font-mono text-label font-normal tracking-label uppercase';

/**
 * Le bleu de famille au survol, comme le filet de l’onglet actif du
 * header. C’était --color-accent, le violet pilotable depuis l’admin, qui
 * jure avec la palette de l’accueil.
 */
const COLONNE_LIENS =
  'grid gap-1.5 [&_a]:text-ink [&_a]:transition-colors [&_a]:duration-[120ms] [&_a:hover]:text-[var(--c-bleu-deep)]';

const BASELINE =
  'text-muted m-0 max-w-[460px] font-serif text-[calc(15px*var(--a11y-echelle))] leading-[1.55]';
const MENTION = 'mono text-muted text-label';
---

<footer class="bg-bg border-rule mt-(--block-gap) border-t pt-16 pb-14">
  <div
    class="max-mobile:px-(--page-gutter-narrow) mx-auto max-w-(--page-max) px-(--page-gutter)"
  >
    {
      /* La signature garde deux parts, les trois colonnes de liens une
        chacune. Passer de deux à trois colonnes de liens sans élargir la
        première l’aurait écrasée : la baseline s’y hachait en lignes de
        quatre mots. */
    }
    <div
      class="text-ink max-mobile:grid-cols-[1fr] max-mobile:gap-8 grid grid-cols-[2fr_1fr_1fr_1fr] gap-x-10 gap-y-14 font-sans text-[calc(13px*var(--a11y-echelle))]"
    >
      <div>
        {
          /* Même graphie que le wordmark du header : italique bas de casse
            en graisse 400, point droit en jaune profond. Le pied affichait
            jusqu’ici un « Tituba. » capitale droite demi-gras — deux
            graphies du même nom sur une seule page. */
        }
        <div
          class="mb-2.5 font-serif text-[calc(22px*var(--a11y-echelle))] font-normal tracking-[-0.01em] lowercase italic"
        >
          {siteName}<span class="text-[var(--c-jaune-deep)] not-italic">.</span>
        </div>
        {
          /* Les deux lignes de baseline se serrent l’une contre l’autre :
            elles forment un seul bloc de sens malgré les deux
            paragraphes. */
        }
        {
          baselineLignes.map((l, rang) => (
            <p class:list={[BASELINE, rang > 0 && 'mt-1']}>{l}</p>
          ))
        }
        <div class={MENTION + ' mt-6'}>{copyrightLine}</div>
        <div class={MENTION + ' mt-1'}>Version : {gitTag}</div>
      </div>
      <div>
        <h2 class={INTITULE}>Formats</h2>
        <div class={COLONNE_LIENS}>
          {formatLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>
      <div>
        <h2 class={INTITULE}>Naviguer</h2>
        <div class={COLONNE_LIENS}>
          {
            navFooter.map((link) => (
              <a href={link.href} rel={link.external ? 'noopener' : undefined}>
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
      {
        /* L’envers du site plutôt que son contenu. La colonne disparaît si
          elle est vide — un titre seul ne vaut pas d’occuper un quart du
          pied. */
      }
      {
        navCoulisses.length > 0 && (
          <div>
            <h2 class={INTITULE}>Coulisses</h2>
            <div class={COLONNE_LIENS}>
              {navCoulisses.map((link) => (
                <a
                  href={link.href}
                  rel={link.external ? 'noopener' : undefined}
                  target={link.external ? '_blank' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</footer>
