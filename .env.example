# ─────────────────────────────────────────────────────────────────
# Variables d'environnement pour Tituba
#
# Ce fichier est un TEMPLATE versionné. Il liste les clés attendues
# par la stack (Astro + Payload + Postgres + Mail).
#
# En prod : généré automatiquement par scripts/deploy.sh, qui fetch
#   chaque sous-dossier `/services/tituba/<sub>` depuis Infisical Cloud
#   (`infisical export --env=prod --path=/services/tituba/<sub>
#   --format=dotenv >> .env`).
# En dev  : tu fetches l'env "dev" d'Infisical Cloud (qui contient les
#   valeurs locales : Postgres docker, Mailpit, etc.) via Dev Setup
#   (VS Code) ou en CLI :
#   `infisical export --domain=https://app.infisical.com \
#      --projectId=<id> --env=dev --path=/services/tituba \
#      --format=dotenv > .env`
#   (à compléter avec un export par sous-dossier si la CLI locale ne
#    supporte pas `--recursive`).
#
# Le `.env` réel est gitignored (cf .gitignore). Ne commit JAMAIS de
# valeurs en clair.
# ─────────────────────────────────────────────────────────────────


# ─── Ports d'exposition côté host (compose.yml) ──────────────────
# Path Infisical : prod /services/tituba/web
# Les containers écoutent toujours sur leurs ports internes (Payload
# 3001, Astro 4321), mais le mapping host est piloté par ces vars
# pour rester aligné avec la config nginx du VPS.
# Convention historique du projet : 8068 pour Payload, 8067 pour le site.
PORT_PAYLOAD=8068
PORT_SITE=8067


# ─── Postgres (interne docker, jamais exposé sur le host) ────────
# Path Infisical : prod /services/tituba/postgres
POSTGRES_USER=payload
POSTGRES_PASSWORD=
POSTGRES_DB=tituba
# En dev uniquement : port hôte du container Postgres. 5433 et non 5432
# parce que le projet Carnet occupe déjà 5432 en local — sans ce
# décalage, Payload se connecte à la base de Carnet sans erreur visible.
# En prod, Payload joint `db` par le réseau docker et cette var est
# ignorée (port interne 5432).
POSTGRES_PORT=5433
# POSTGRES_HOST : hôte de la base. `db` en prod, posé par compose.yml —
# c'est le nom du service dans le réseau docker. En dev, laissé vide :
# Payload retombe alors sur localhost, où le container expose son
# POSTGRES_PORT. À renseigner seulement si la base tourne ailleurs.
POSTGRES_HOST=


# ─── URL publique du site ────────────────────────────────────────
# Path Infisical : prod /services/tituba/web
# ADDRESS : domaine racine du site, sans trailing slash. Source
#   unique de vérité partagée par :
#     - Astro au build (astro.config.mjs → Astro.site, sitemap, RSS,
#       URLs canoniques)
#     - Astro au runtime (mediaUrl pour les médias servis par Payload)
#     - Payload au runtime (mails d'invitation, OTP 2FA, OG meta,
#       cors/csrf, links d'acceptation d'invitation)
ADDRESS=https://domaine.com

# TICKETING_URL : adresse où l'on signale un problème sur le site (suivi
# des anomalies, dépôt d'issues). Affichée dans la colonne « Coulisses »
# du pied de page, sous le libellé « Signaler un problème ».
#
# Ici et non dans l'admin : c'est une adresse d'infrastructure, qui
# change avec le service et non au gré d'une décision éditoriale — et
# qui peut différer d'un environnement à l'autre.
#
# Optionnelle : vide, le lien ne s'affiche pas. Un service qu'on n'a pas
# encore ne doit pas laisser d'entrée morte dans le pied.
TICKETING_URL=


# ─── Payload CMS (admin + API sous /cms/*) ───────────────────────
# Path Infisical : prod /services/tituba/payload
# PAYLOAD_SECRET : random 64+ chars, généré une fois
#   (ex: openssl rand -hex 32)
#
#   OBLIGATOIRE, et vérifié au démarrage : Payload refuse de démarrer
#   s'il est absent ou plus court que 32 caractères. Il signe les
#   sessions, les jetons de confirmation d'abonnement et les liens de
#   désabonnement — il valait auparavant la chaîne vide par défaut, ce
#   qui faisait tourner l'application avec des signatures que n'importe
#   qui pouvait reproduire, sans que rien ne le signale.
#
# PAYLOAD_INTERNAL_URL : URL interne docker, utilisée par Astro
#   server-side pour fetcher Payload sans passer par internet.
PAYLOAD_SECRET=
PAYLOAD_INTERNAL_URL=http://payload:3001


# ─── Premier compte administrateur (seed de configuration) ───────────
# Path Infisical : prod /services/tituba/payload
#
# Lues par `pnpm --dir services/payload seed:config`, une seule fois : le
# seed ne crée le compte que si la collection est vide, et se contente de
# le constater aux exécutions suivantes.
#
# Elles n'ont pas de valeur par défaut, et c'est délibéré : ce compte est
# le seul moyen d'entrer dans l'administration d'un site qui vient
# d'ouvrir, et un mot de passe par défaut sur une telle porte ne se
# referme jamais. Sans elles, le seed s'arrête et le dit. Douze
# caractères au minimum.
#
# À changer depuis l'administration après la première connexion ; ces
# variables ne servent plus ensuite.
SEED_ROOT_EMAIL=
SEED_ROOT_PASSWORD=


# ─── Unsplash (picker d'image de couverture, côté admin) ─────────
# Path Infisical : prod /services/tituba/unsplash
# « Access Key » d'une application Unsplash
# (https://unsplash.com/oauth/applications → Keys) — pas la Secret Key.
# Consommée uniquement côté serveur Payload, pour la recherche et
# l'import auto-hébergé des photos de couverture des billets d'analyse
# (cf services/payload/src/endpoints/unsplash.ts). Jamais exposée au
# navigateur : le front passe par un proxy serveur.
#
# Optionnelle : sans elle tout le reste de l'admin fonctionne, seule la
# recherche Unsplash renvoie « clé absente côté serveur ». D'où
# `${UNSPLASH_ACCESS_KEY:-}` dans compose.yml, et non `:?`.
#
# Le sous-dossier `unsplash` doit figurer dans la boucle de fetch de
# scripts/deploy.sh, sinon il n'est jamais exporté en prod.
UNSPLASH_ACCESS_KEY=


# ─── Formulaire de contact ──────────────────────────────────────────
# Path Infisical : prod /services/tituba/contact
#
# INTERNAL_PROXY_SECRET — secret partagé entre le site et Payload.
#
# nginx expose /cms/* directement : sans ce secret, on peut poster sur
# /cms/api/contact sans passer par le site, en forgeant soi-même
# l'en-tête d'IP — ce qui réduit la limitation par IP à néant. Le site
# le pose sur ses appels, Payload le vérifie en temps constant.
#
# À définir sur les DEUX services (payload ET site) : docker compose ne
# transmet rien automatiquement d'un service à l'autre.
#
# Optionnel, et c'est délibéré : rendre le secret obligatoire ferait
# échouer tout envoi sur un déploiement qui ne l'a pas encore, et un
# formulaire qui répond 403 en silence est pire qu'un formulaire un peu
# moins gardé. Son absence est signalée dans les journaux de Payload.
# N'importe quelle chaîne fait l'affaire — la comparaison porte sur les
# octets du texte, sans rien supposer de sa forme. `openssl rand -hex 32`
# reste la façon la plus simple d'en tirer une qui ne se devine pas.
INTERNAL_PROXY_SECRET=

# CONTACT_POW_MAX — difficulté de la preuve de travail du formulaire.
#
# Espace de recherche du calcul que le navigateur résout avant l'envoi.
# 50 000 par défaut, soit ~300 ms sur un portable médian et ~1,3 s sur
# un téléphone d'entrée de gamme. À monter si le spam passe, à baisser
# si des personnes se plaignent de l'attente — le coût serveur, lui, ne
# bouge pas : un seul haché à la vérification, quelle que soit la
# difficulté.
CONTACT_POW_MAX=


# ─── SMTP (consommé par Payload pour invitations, OTP 2FA, sécurité) ─
# Path Infisical : prod /services/tituba/smtp
# Le service Payload envoie ses mails directement via
# `@payloadcms/email-nodemailer` — pas de service mail séparé pour
# Tituba (cf décision MVP, à reconsidérer si formulaire public ajouté).
#
# En dev local, ces vars pointent sur Mailpit via le profil Infisical
# dev : SMTP_HOST=localhost, SMTP_PORT=1026, UI http://localhost:8026.
# Ports décalés de 1 par rapport aux défauts Mailpit, pour la même
# raison que POSTGRES_PORT ci-dessus (cohabitation avec Carnet).
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=contact@domaine.com
SMTP_FROM_NAME=Tituba


# ─── Auth (invitations + 2FA + sessions) ─────────────────────────
# Toutes optionnelles, valeurs par défaut entre parenthèses.
# INVITATION_TTL_DAYS       — durée de validité du lien d'invitation (7)
# OTP_TTL_MINUTES           — durée de validité d'un code OTP email (10)
# TRUSTED_DEVICE_TTL_DAYS   — durée d'un appareil de confiance après 2FA (7)
# SESSION_INACTIVE_HOURS    — logout auto après cette durée d'inactivité (48)
# STEP_UP_TTL_MINUTES       — fenêtre où un mdp re-saisi reste valide
#                             pour les actions sensibles (10)
# PAYLOAD_INSECURE_COOKIES  — mettre "true" UNIQUEMENT pour debug HTTP en dev
INVITATION_TTL_DAYS=7
OTP_TTL_MINUTES=10
TRUSTED_DEVICE_TTL_DAYS=7
SESSION_INACTIVE_HOURS=48
STEP_UP_TTL_MINUTES=10
PAYLOAD_INSECURE_COOKIES=


# ─── Variables posées par l'environnement, pas par ce fichier ────
#
# Elles sont lues par le code mais ne se renseignent pas ici. Listées
# pour qu'on sache où les chercher quand elles manquent — une valeur
# absente ne provoque aucune erreur, juste un comportement différent de
# celui qu'on attendait.
#
# NODE_ENV     — `production` en conteneur (posé par le Dockerfile),
#                absent en dev. Il ne gouverne pas qu'un mode de build :
#                c'est lui qui décide du régime de schéma de Payload.
#                En dev, Drizzle synchronise la base à chaque démarrage
#                (`push: true`) ; en production il refuse, et seules les
#                migrations SQL de services/payload/src/migrations/
#                s'appliquent. Le poser à `production` en local
#                arrêterait donc la synchronisation automatique.
#
# GIT_COMMIT   — injectés au build de l'image par la CI
# GIT_TAG        (.github/workflows/build.yml → ARG du Dockerfile).
#                GIT_TAG est la version affichée dans le pied de page du
#                site et dans la barre latérale de l'admin ; hors
#                conteneur, elle vaut « dev ». Les renseigner à la main
#                ici n'aurait pas d'effet sur une image déjà construite.
#
# SHOW_DRAFTS  — `1` fait apparaître les brouillons sur le site public.
#                Confort de dev, à ne jamais poser en production : le
#                site servirait alors des textes non publiés à tout le
#                monde, sans que rien ne les distingue des autres.
